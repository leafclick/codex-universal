#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

CODEX_DIR="${CODEX_DIR:-$HOME/.codex}"
SYNC_DIR="${CODEX_SYNC_DIR:-$HOME/Seafile/CodexSync}"
LOCK_FILE="${CODEX_LOCK_FILE:-$HOME/.cache/codex-handoff.lock}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/codex-handoff"
BASE_FILE="$STATE_DIR/base.state"
CONTAINER_PROJECT="${CODEX_CONTAINER_PROJECT:-}"
CONTAINER_LANE="${CODEX_CONTAINER_LANE:-}"
HANDOFF_PROJECT="${CODEX_HANDOFF_PROJECT:-}"
HANDOFF_LANE="${CODEX_HANDOFF_LANE:-}"
HANDOFF_COMMIT="${CODEX_HANDOFF_COMMIT:-}"
HANDOFF_RUNTIME_PROFILE="${CODEX_HANDOFF_RUNTIME_PROFILE:-}"
HANDOFF_RUNTIME_VERSION="${CODEX_HANDOFF_RUNTIME_VERSION:-}"
HANDOFF_RUNTIME_REVISION="${CODEX_HANDOFF_RUNTIME_REVISION:-}"
HANDOFF_ONBOARDING_SHA256="${CODEX_HANDOFF_ONBOARDING_SHA256:-}"
HANDOFF_READY="${CODEX_HANDOFF_READY:-}"

usage() {
    cat <<'USAGE'
Usage:
  codex-push

Publish the current Codex state as the next synchronized snapshot.
USAGE
}

die() {
    echo "ERROR: $*" >&2
    exit 1
}

case "${1:-}" in
    '')
        (($# == 0)) || die "Unexpected arguments"
        ;;
    -h|--help)
        (($# == 1)) || die "--help takes no arguments"
        usage
        exit 0
        ;;
    *)
        usage >&2
        die "Unknown option or argument: $1"
        ;;
esac

for cmd in tar zstd sha256sum sqlite3 lsof flock awk find grep head cp hostname realpath dirname basename tr; do
    command -v "$cmd" >/dev/null || die "Missing command: $cmd"
done

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=bin/codex-sync-lib
source "$SCRIPT_DIR/codex-sync-lib"

HANDOFF_ENABLED=false
validate_handoff_context() {
    local values=(
        "$HANDOFF_PROJECT"
        "$HANDOFF_LANE"
        "$HANDOFF_COMMIT"
        "$HANDOFF_RUNTIME_PROFILE"
        "$HANDOFF_RUNTIME_VERSION"
        "$HANDOFF_RUNTIME_REVISION"
        "$HANDOFF_ONBOARDING_SHA256"
        "$HANDOFF_READY"
    )
    local value present=0

    for value in "${values[@]}"; do
        [[ -z "$value" ]] || ((present += 1))
    done
    ((present > 0)) || return 0
    ((present == ${#values[@]})) ||
        die "Incomplete lane handoff context"

    valid_handoff_id "$HANDOFF_PROJECT" || die "Invalid handoff project"
    valid_handoff_id "$HANDOFF_LANE" || die "Invalid handoff lane"
    valid_required_commit "$HANDOFF_COMMIT" ||
        die "Invalid handoff required commit"
    valid_handoff_id "$HANDOFF_RUNTIME_PROFILE" ||
        die "Invalid handoff runtime profile"
    valid_runtime_value "$HANDOFF_RUNTIME_VERSION" ||
        die "Invalid handoff runtime version"
    [[ "$HANDOFF_RUNTIME_REVISION" =~ ^[0-9a-f]{7,64}$ ]] ||
        die "Invalid handoff runtime revision"
    valid_hash "$HANDOFF_ONBOARDING_SHA256" ||
        die "Invalid handoff onboarding contract hash"
    [[ "$HANDOFF_READY" == 1 ]] ||
        die "Lane onboarding is not ready for handoff"
    HANDOFF_ENABLED=true
}

validate_handoff_context

normalize_path() {
    local variable="$1"
    local value="${!variable}"
    local normalized

    [[ "$value" == /* ]] || die "$variable must be an absolute path: $value"
    normalized="$(realpath -m -- "$value")" || die "Cannot resolve $variable: $value"
    [[ "$normalized" != / ]] || die "$variable must not be the filesystem root"
    printf -v "$variable" '%s' "$normalized"
}

paths_overlap() {
    [[ "$1" == "$2" || "$1" == "$2/"* || "$2" == "$1/"* ]]
}

validate_paths() {
    normalize_path CODEX_DIR
    normalize_path SYNC_DIR
    normalize_path STATE_DIR
    normalize_path LOCK_FILE

    paths_overlap "$CODEX_DIR" "$SYNC_DIR" &&
        die "CODEX_DIR and CODEX_SYNC_DIR must not overlap"
    paths_overlap "$CODEX_DIR" "$STATE_DIR" &&
        die "CODEX_DIR and XDG_STATE_HOME/codex-handoff must not overlap"
    paths_overlap "$SYNC_DIR" "$STATE_DIR" &&
        die "CODEX_SYNC_DIR and XDG_STATE_HOME/codex-handoff must not overlap"

    for directory in "$CODEX_DIR" "$SYNC_DIR" "$STATE_DIR"; do
        paths_overlap "$LOCK_FILE" "$directory" &&
            die "CODEX_LOCK_FILE must be separate from Codex data directories"
    done

    BASE_FILE="$STATE_DIR/base.state"
}

validate_paths
mkdir -p "$SYNC_DIR" "$STATE_DIR" "$(dirname "$LOCK_FILE")"

[[ -d "$CODEX_DIR" ]] || die "$CODEX_DIR does not exist"

state_hash_dir() {
    local dir="$1"

    LC_ALL=C tar \
        --sort=name \
        --format=gnu \
        --mtime='@0' \
        --owner=0 \
        --group=0 \
        --numeric-owner \
        -C "$dir" \
        -cf - . |
        sha256sum |
        awk '{print $1}'
}

check_sqlite() {
    local dir="$1"
    local db check_dir db_copy result sidecar

    while IFS= read -r -d '' db; do
        [[ -r "$db" ]] || die "Could not inspect file for SQLite data: $db"
        if [[ "$db" != *.sqlite ]] &&
           ! LC_ALL=C head -c 15 -- "$db" | grep -Fqx 'SQLite format 3'; then
            continue
        fi

        echo "  checking $(basename "$db")"

        check_dir="$(mktemp -d "$STATE_DIR/.sqlite-check.XXXXXX")" ||
            die "Could not create SQLite validation directory"
        db_copy="$check_dir/$(basename "$db")"
        if ! cp -- "$db" "$db_copy"; then
            rm -rf -- "$check_dir"
            die "Could not copy SQLite database for validation: $db"
        fi

        for sidecar in "$db-journal" "$db-wal" "$db-shm"; do
            [[ -e "$sidecar" || -L "$sidecar" ]] || continue
            if [[ ! -f "$sidecar" || -L "$sidecar" ]] ||
               ! cp -- "$sidecar" "$check_dir/$(basename "$sidecar")"; then
                rm -rf -- "$check_dir"
                die "Could not safely copy SQLite sidecar for validation: $sidecar"
            fi
        done

        if ! result="$(sqlite3 "$db_copy" 'PRAGMA integrity_check;')"; then
            rm -rf -- "$check_dir"
            die "SQLite check failed: $db"
        fi

        rm -rf -- "$check_dir" ||
            die "Could not remove SQLite validation directory: $check_dir"

        [[ "$result" == "ok" ]] ||
            die "SQLite corruption detected in $db: $result"

    done < <(find "$dir" -type f -print0)
}

write_base() {
    local generation="$1"
    local hash="$2"
    local tmp="$BASE_FILE.tmp.$$"

    {
        echo "generation=$generation"
        echo "sha256=$hash"
    } > "$tmp"

    mv "$tmp" "$BASE_FILE"
}

BASE_GEN=""
BASE_HASH=""

read_base() {
    [[ -f "$BASE_FILE" ]] || return 1

    local generation
    local hash

    generation="$(state_value "$BASE_FILE" generation)"
    hash="$(state_value "$BASE_FILE" sha256)"

    [[ "$generation" =~ ^[0-9]+$ ]] ||
        die "Invalid generation in $BASE_FILE"

    valid_hash "$hash" ||
        die "Invalid hash in $BASE_FILE"

    BASE_GEN=$((10#$generation))
    BASE_HASH="$hash"

    return 0
}

REMOTE_GEN=""
REMOTE_HASH=""
REMOTE_STATE_FILE=""

load_latest_remote() {
    local best_gen=-1
    local best_hash=""
    local best_handoff=""
    local best_file=""
    local found=false
    local restore_nullglob=false

    if ! shopt -q nullglob; then
        shopt -s nullglob
        restore_nullglob=true
    fi
    local files=("$SYNC_DIR"/codex-g*.tar.zst.state)
    if $restore_nullglob; then
        shopt -u nullglob
    fi

    for state_file in "${files[@]}"; do
        local generation hash handoff

        generation="$(state_value "$state_file" generation)"
        hash="$(state_value "$state_file" sha256)"

        [[ "$generation" =~ ^[0-9]+$ ]] || continue
        valid_hash "$hash" || continue

        generation=$((10#$generation))
        if snapshot_handoff_identity "$state_file"; then
            handoff="$SNAPSHOT_HANDOFF_IDENTITY"
        else
            handoff="invalid"
        fi

        if (( generation > best_gen )); then
            best_gen="$generation"
            best_hash="$hash"
            best_handoff="$handoff"
            best_file="$state_file"
            found=true

        elif (( generation == best_gen )); then
            [[ "$hash" == "$best_hash" ]] ||
                die "DIVERGENCE: generation $generation has multiple different hashes"
            [[ "$handoff" == "$best_handoff" ]] ||
                die "DIVERGENCE: generation $generation has conflicting handoff metadata"
        fi
    done

    $found || return 1

    REMOTE_GEN="$best_gen"
    REMOTE_HASH="$best_hash"
    REMOTE_STATE_FILE="$best_file"

    return 0
}

verify_remote_snapshot() {
    local state_file="$1"

    snapshot_archive_is_valid "$state_file" "$SYNC_DIR" ||
        die "Remote snapshot metadata, archive, or checksum is invalid: $state_file"
}

REMOTE_HANDOFF_CURRENT=false
verify_remote_handoff() {
    local state_file="$1"

    snapshot_metadata_is_valid "$state_file" ||
        die "Remote snapshot metadata is invalid: $state_file"
    if [[ -z "$SNAPSHOT_HANDOFF_FORMAT" ]]; then
        return 0
    fi
    $HANDOFF_ENABLED ||
        die "Remote snapshot contains lane handoff metadata; use the lane-aware run-codex command"
    [[ "$SNAPSHOT_PROJECT" == "$HANDOFF_PROJECT" &&
       "$SNAPSHOT_LANE" == "$HANDOFF_LANE" ]] ||
        die "Remote snapshot belongs to project '$SNAPSHOT_PROJECT' lane '$SNAPSHOT_LANE'"

    if [[ "$SNAPSHOT_REQUIRED_COMMIT" == "$HANDOFF_COMMIT" &&
          "$SNAPSHOT_RUNTIME_PROFILE" == "$HANDOFF_RUNTIME_PROFILE" &&
          "$SNAPSHOT_RUNTIME_VERSION" == "$HANDOFF_RUNTIME_VERSION" &&
          "$SNAPSHOT_RUNTIME_REVISION" == "$HANDOFF_RUNTIME_REVISION" &&
          "$SNAPSHOT_ONBOARDING_SHA256" == "$HANDOFF_ONBOARDING_SHA256" ]]; then
        REMOTE_HANDOFF_CURRENT=true
    fi
}

publish_file() {
    local source="$1"
    local destination_name="$2"
    local partial

    partial="$SYNC_DIR/.${destination_name}.partial.$$.$RANDOM"

    cp -- "$source" "$partial"
    sync "$partial"
    mv -- "$partial" "$SYNC_DIR/$destination_name"
}

running_codex_containers() {
    command -v docker >/dev/null 2>&1 || return 0
    if [[ -n "$CONTAINER_PROJECT" || -n "$CONTAINER_LANE" ]]; then
        [[ "$CONTAINER_PROJECT" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ &&
           "$CONTAINER_LANE" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] ||
            die "CODEX_CONTAINER_PROJECT and CODEX_CONTAINER_LANE must both be safe non-empty identifiers"
        docker ps \
            --filter "label=codex-universal.project=$CONTAINER_PROJECT" \
            --filter "label=codex-universal.lane=$CONTAINER_LANE" \
            --format '{{.Names}}' 2>/dev/null || true
    else
        docker ps --format '{{.Names}}' 2>/dev/null |
            grep '^codex-' || true
    fi
}

report_running_codex_containers() {
    local running

    running="$(running_codex_containers)"
    [[ -n "$running" ]] || return 1

    echo "Running Codex Docker containers:" >&2
    while IFS= read -r container; do
        printf '  %s\n' "$container" >&2
    done <<< "$running"
    return 0
}

#
# Lock against codex-pull and run-codex.
#
if report_running_codex_containers; then
    die "Stop the listed Codex session(s) before pushing"
fi

exec 9>"$LOCK_FILE"

if ! flock -n -x 9; then
    report_running_codex_containers || true
    die "Codex is running, starting, or another push/pull is active"
fi

#
# Extra safety checks.
#
if lsof +D "$CODEX_DIR" >/dev/null 2>&1; then
    echo "Open files under $CODEX_DIR:" >&2
    lsof +D "$CODEX_DIR" >&2 || true
    die "Stop Codex first"
fi

if report_running_codex_containers; then
    die "Stop the listed Codex session(s) before pushing"
fi

#
# Validate local state.
#
echo "Checking SQLite databases..."
check_sqlite "$CODEX_DIR"

echo "Calculating local state..."
LOCAL_HASH="$(state_hash_dir "$CODEX_DIR")"

#
# Read local baseline.
#
if read_base; then
    HAVE_BASE=true
else
    HAVE_BASE=false
fi

#
# Read synchronized snapshot state.
#
if load_latest_remote; then
    HAVE_REMOTE=true
    verify_remote_snapshot "$REMOTE_STATE_FILE"
    verify_remote_handoff "$REMOTE_STATE_FILE"
else
    HAVE_REMOTE=false
fi

REBUILD_REMOTE=false

#
# Decide what should happen.
#
if $HAVE_BASE; then

    if ! $HAVE_REMOTE; then

        #
        # Important bootstrap/recovery case:
        #
        # We have a valid local baseline but the sync directory is empty.
        # If the local state still matches the baseline, we can safely
        # recreate that same generation remotely.
        #
        if [[ "$LOCAL_HASH" == "$BASE_HASH" ]]; then
            echo "Remote state is empty."
            echo "Re-publishing local baseline generation $BASE_GEN."

            NEXT_GEN="$BASE_GEN"
            REBUILD_REMOTE=true
        else
            die "Remote state is empty, but local Codex changed since generation $BASE_GEN. Refusing automatic recovery."
        fi

    else

        if (( REMOTE_GEN < BASE_GEN )); then
            die "Remote generation $REMOTE_GEN is older than local baseline $BASE_GEN. Refusing."
        fi

        if (( REMOTE_GEN > BASE_GEN )); then

            if [[ "$LOCAL_HASH" == "$BASE_HASH" ]]; then
                die "Remote generation $REMOTE_GEN is newer. Run codex-pull first."
            else
                die "DIVERGENCE: remote advanced to generation $REMOTE_GEN and local Codex also changed."
            fi
        fi

        #
        # Same generation on both sides.
        #
        [[ "$REMOTE_HASH" == "$BASE_HASH" ]] ||
            die "DIVERGENCE: remote generation $REMOTE_GEN differs from local baseline."

        if [[ "$LOCAL_HASH" == "$BASE_HASH" ]]; then
            if $HANDOFF_ENABLED && ! $REMOTE_HANDOFF_CURRENT; then
                echo "Codex state is unchanged; publishing updated lane handoff requirements."
                NEXT_GEN=$((REMOTE_GEN + 1))
            else
                echo "No changes. Codex state already matches synchronized generation $REMOTE_GEN."
                exit 0
            fi
        else
            NEXT_GEN=$((REMOTE_GEN + 1))
        fi
    fi

else

    #
    # No local baseline.
    #
    if $HAVE_REMOTE; then

        if [[ "$LOCAL_HASH" == "$REMOTE_HASH" ]]; then
            if $HANDOFF_ENABLED && ! $REMOTE_HANDOFF_CURRENT; then
                echo "Codex state matches; publishing lane handoff requirements."
                NEXT_GEN=$((REMOTE_GEN + 1))
            else
                write_base "$REMOTE_GEN" "$REMOTE_HASH"

                echo "No changes."
                echo "Adopted synchronized generation $REMOTE_GEN as local baseline."
                exit 0
            fi
        else
            die "Remote generation $REMOTE_GEN exists but this machine has no baseline. Run 'codex-pull --force $REMOTE_GEN' if the remote state should win."
        fi
    else
        #
        # Completely fresh synchronization setup.
        #
        NEXT_GEN=1
    fi
fi

#
# Create snapshot.
#
timestamp="$(date -u '+%Y%m%dT%H%M%SZ')"

host="$(hostname -s 2>/dev/null || echo unknown)"
host="${host//[^A-Za-z0-9_.-]/_}"

generation_padded="$(printf '%08d' "$NEXT_GEN")"
nonce="$(printf '%04x%04x' "$RANDOM" "$RANDOM")"

archive_name="codex-g${generation_padded}-${timestamp}-${host}-${nonce}.tar.zst"

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

archive="$tmpdir/$archive_name"

echo "Creating generation $NEXT_GEN..."

tar \
    -C "$CODEX_DIR" \
    -cf - . |
    zstd \
        -T0 \
        -10 \
        -q \
        -o "$archive"

archive_hash="$(sha256sum "$archive" | awk '{print $1}')"

printf '%s\n' "$archive_hash" \
    > "$tmpdir/$archive_name.sha256"

{
    cat <<EOF
format=1
generation=$NEXT_GEN
sha256=$LOCAL_HASH
created=$timestamp
host=$host
archive=$archive_name
EOF
    if $HANDOFF_ENABLED; then
        cat <<EOF
handoff_format=1
project=$HANDOFF_PROJECT
lane=$HANDOFF_LANE
required_commit=$HANDOFF_COMMIT
runtime_profile=$HANDOFF_RUNTIME_PROFILE
runtime_version=$HANDOFF_RUNTIME_VERSION
runtime_revision=$HANDOFF_RUNTIME_REVISION
onboarding_sha256=$HANDOFF_ONBOARDING_SHA256
EOF
    fi
} > "$tmpdir/$archive_name.state"

#
# Check that synchronized state did not change while we were creating
# the snapshot.
#
OLD_REMOTE_GEN="${REMOTE_GEN:-}"
OLD_REMOTE_HASH="${REMOTE_HASH:-}"

REMOTE_GEN=""
REMOTE_HASH=""
REMOTE_STATE_FILE=""

if load_latest_remote; then

    verify_remote_snapshot "$REMOTE_STATE_FILE"

    if ! $HAVE_REMOTE; then
        die "Remote state appeared while creating the snapshot. Aborting."
    fi

    [[ "$REMOTE_GEN" == "$OLD_REMOTE_GEN" ]] ||
        die "Remote generation changed while creating the snapshot. Aborting."

    [[ "$REMOTE_HASH" == "$OLD_REMOTE_HASH" ]] ||
        die "Remote state changed while creating the snapshot. Aborting."

else

    if $HAVE_REMOTE; then
        die "Remote state disappeared while creating the snapshot. Aborting."
    fi

    #
    # Empty remote is expected for:
    #   - initial generation 1
    #   - reconstruction of a missing remote baseline
    #
fi

#
# Publish:
#
#   1. archive
#   2. archive checksum
#   3. state file LAST
#
# The .state file is the commit marker.
#
publish_file \
    "$archive" \
    "$archive_name"

publish_file \
    "$tmpdir/$archive_name.sha256" \
    "$archive_name.sha256"

publish_file \
    "$tmpdir/$archive_name.state" \
    "$archive_name.state"

sync \
    "$SYNC_DIR/$archive_name" \
    "$SYNC_DIR/$archive_name.sha256" \
    "$SYNC_DIR/$archive_name.state"

#
# Update local baseline only after the complete snapshot has been
# published locally into the sync directory.
#
write_base "$NEXT_GEN" "$LOCAL_HASH"

echo
if $REBUILD_REMOTE; then
    echo "Re-published Codex generation $NEXT_GEN."
else
    echo "Published Codex generation $NEXT_GEN."
fi

echo "  $archive_name"
echo
echo "Wait for your sync provider to report synchronized before switching machines."
