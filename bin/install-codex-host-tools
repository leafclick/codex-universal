#!/usr/bin/env bash
set -Eeuo pipefail
umask 022

die() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'USAGE'
Usage:
  install-codex-host-tools [--prefix PATH] [--dry-run]
  install-codex-host-tools [--prefix PATH] --check
  install-codex-host-tools [--prefix PATH] --list
  install-codex-host-tools [--prefix PATH] --rollback BUNDLE_ID
  install-codex-host-tools [--prefix PATH] --remove BUNDLE_ID [--dry-run]
  install-codex-host-tools --help

Install the codex-universal host commands beneath PATH (default: $HOME/.local).
--dry-run validates and describes an installation without writing anything.
--check verifies that the current installation exactly matches this checkout.
--list verifies and lists all retained bundles without modifying the installation.
--rollback verifies and activates a retained bundle without deleting newer bundles.
--remove verifies and removes an inactive bundle; --dry-run only describes it.
USAGE
}

PREFIX="${HOME:?HOME must be set}/.local"
MODE=install
MODE_SELECTED=false
DRY_RUN=false
ROLLBACK_ID=""
REMOVE_ID=""

select_mode() {
    $MODE_SELECTED && die "only one of --check, --list, --rollback, or --remove may be used"
    MODE="$1"
    MODE_SELECTED=true
}

while (($#)); do
    case "$1" in
        --prefix)
            (($# >= 2)) || die "--prefix requires a path"
            PREFIX="$2"
            shift 2
            ;;
        --check)
            select_mode check
            shift
            ;;
        --dry-run)
            ! $DRY_RUN || die "--dry-run may be specified only once"
            DRY_RUN=true
            shift
            ;;
        --list)
            select_mode list
            shift
            ;;
        --rollback)
            (($# >= 2)) || die "--rollback requires a bundle ID"
            select_mode rollback
            ROLLBACK_ID="$2"
            shift 2
            ;;
        --remove)
            (($# >= 2)) || die "--remove requires a bundle ID"
            select_mode remove
            REMOVE_ID="$2"
            shift 2
            ;;
        -h|--help)
            (($# == 1)) || die "--help takes no other arguments"
            usage
            exit 0
            ;;
        --)
            shift
            (($# == 0)) || die "unexpected argument: $1"
            ;;
        *)
            die "unknown option or argument: $1"
            ;;
    esac
done

if $DRY_RUN; then
    case "$MODE" in
        install) MODE=dry-run ;;
        remove) ;;
        *) die "--dry-run may be used only with installation or --remove" ;;
    esac
fi

SCRIPT_DIR="$(cd -P -- "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
SOURCE_ROOT="$(cd -P -- "$SCRIPT_DIR/.." && pwd -P)"
HOST_COMPAT="$SCRIPT_DIR/codex-host-compat.bash"
[[ -r "$HOST_COMPAT" ]] || die "missing host compatibility layer: $HOST_COMPAT"
# shellcheck source=bin/codex-host-compat.bash
source "$HOST_COMPAT" || die "cannot load host compatibility layer: $HOST_COMPAT"
case "$MODE" in
    rollback|remove|install|dry-run)
        codex_host_require_capabilities path stat checksum lock atomic-replace || exit 1
        ;;
    check|list)
        codex_host_require_capabilities path stat checksum lock || exit 1
        ;;
esac

for command_name in readlink cat dirname; do
    command -v "$command_name" >/dev/null 2>&1 || die "missing command: $command_name"
done
case "$MODE" in
    install|dry-run|check)
        for command_name in git; do
            command -v "$command_name" >/dev/null 2>&1 || die "missing command: $command_name"
        done
        ;;
    list)
        command -v sort >/dev/null 2>&1 || die "missing command: sort"
        ;;
esac
if [[ "$MODE" == install || "$MODE" == rollback || "$MODE" == remove ]]; then
    for command_name in mkdir ln mktemp chmod rm rmdir; do
        command -v "$command_name" >/dev/null 2>&1 || die "missing command: $command_name"
    done
fi
if [[ "$MODE" == install ]]; then
    command -v install >/dev/null 2>&1 || die "missing command: install"
fi

[[ "$PREFIX" == /* ]] || die "installation prefix must be an absolute path: $PREFIX"
reject_symlink_components() {
    local path="$1"
    local rest="${path#/}"
    local component current=""
    local old_ifs="$IFS"

    IFS=/
    # Intentional word splitting walks each absolute-path component.
    for component in $rest; do
        [[ -n "$component" ]] || continue
        current="$current/$component"
        [[ ! -L "$current" ]] || die "symlink path component is not allowed: $current"
    done
    IFS="$old_ifs"
}

[[ ! -L "$PREFIX" ]] || die "installation prefix must not be a symlink: $PREFIX"
PREFIX="$(codex_host_path_allow_missing "$PREFIX")" || die "cannot canonicalize prefix: $PREFIX"
reject_symlink_components "$PREFIX"
[[ "$PREFIX" != / ]] || die "refusing to use the filesystem root as the installation prefix"

case "$PREFIX/" in
    "$SOURCE_ROOT/"* ) die "installation prefix overlaps the source checkout: $PREFIX" ;;
esac
case "$SOURCE_ROOT/" in
    "$PREFIX/"* ) die "installation prefix contains the source checkout: $PREFIX" ;;
esac

INSTALL_ROOT="$PREFIX/libexec/codex-universal"
CURRENT_LINK="$INSTALL_ROOT/current"
BIN_DIR="$PREFIX/bin"
LOCK_FILE="$INSTALL_ROOT/.install.lock"

case "$CODEX_HOST_BACKEND" in
    gnu-linux)
        FILES=(
            run-codex
            setup-codex-idea
            codex-push
            codex-pull
            codex-collab
            codex-host-compat.bash
            codex-sync-lib
            run-codex-doctor.bash
        )
        WRAPPERS=(run-codex setup-codex-idea codex-push codex-pull codex-collab)
        ;;
    darwin-gnu)
        FILES=(run-codex codex-push codex-pull codex-collab codex-host-compat.bash codex-sync-lib run-codex-doctor.bash codex-bwrap-seccomp.json)
        WRAPPERS=(run-codex codex-push codex-pull codex-collab)
        ;;
    *)
        die "unsupported compatibility backend: $CODEX_HOST_BACKEND"
        ;;
esac
ALL_WRAPPERS=(run-codex setup-codex-idea codex-push codex-pull codex-collab)

file_mode() {
    case "$1" in
        run-codex|setup-codex-idea) printf '755\n' ;;
        codex-push|codex-pull|codex-collab) printf '700\n' ;;
        codex-sync-lib) printf '600\n' ;;
        codex-host-compat.bash|run-codex-doctor.bash|codex-bwrap-seccomp.json) printf '644\n' ;;
        *) die "no installation mode is defined for $1" ;;
    esac
}

wrapper_mode() {
    case "$1" in
        run-codex|setup-codex-idea) printf '755\n' ;;
        codex-push|codex-pull|codex-collab) printf '700\n' ;;
        *) die "no wrapper mode is defined for $1" ;;
    esac
}

bundle_rows() {
    local name mode digest source

    printf 'backend\t%s\n' "$CODEX_HOST_BACKEND"
    for name in "${FILES[@]}"; do
        source="$(bundle_source_file "$name")"
        [[ -f "$source" && ! -L "$source" ]] ||
            die "missing or unsafe source file: $source"
        mode="$(file_mode "$name")"
        digest="$(codex_host_sha256_file "$source")" || die "cannot hash source file: $name"
        printf 'file\t%s\t%s\t%s\n' "$mode" "$digest" "$name"
    done
}

bundle_source_file() {
    case "$1" in
        codex-bwrap-seccomp.json)
            printf '%s\n' "$SOURCE_ROOT/security/seccomp/codex-bwrap.json"
            ;;
        *)
            printf '%s\n' "$SCRIPT_DIR/$1"
            ;;
    esac
}

if [[ "$MODE" == install || "$MODE" == dry-run || "$MODE" == check ]]; then
    git_root="$(git -C "$SOURCE_ROOT" rev-parse --show-toplevel 2>/dev/null)" ||
        die "source directory is not a Git checkout: $SOURCE_ROOT"
    git_root="$(codex_host_path_existing "$git_root")" || die "cannot resolve Git checkout root"
    [[ "$git_root" == "$SOURCE_ROOT" ]] ||
        die "installer must be run from the codex-universal Git checkout root"
    REVISION="$(git -C "$SOURCE_ROOT" rev-parse HEAD 2>/dev/null)" || die "cannot read Git revision"
    VERSION="$(git -C "$SOURCE_ROOT" describe --always --tags 2>/dev/null)" ||
        die "cannot derive Git version"
    [[ "$REVISION" =~ ^[0-9a-fA-F]{40}$ ]] || die "Git returned an invalid full revision"

    BUNDLE_HASH="$(bundle_rows | codex_host_sha256_stdin)" || die "cannot compute bundle hash"
    SAFE_VERSION="${VERSION//[^A-Za-z0-9._-]/-}"
    SAFE_VERSION="${SAFE_VERSION:0:80}"
    BUNDLE_ID="${SAFE_VERSION}-${CODEX_HOST_BACKEND}-${BUNDLE_HASH:0:16}"
    BUNDLE_DIR="$INSTALL_ROOT/$BUNDLE_ID"
fi

manifest_content() {
    printf 'format\t1\n'
    printf 'bundle\t%s\n' "$BUNDLE_ID"
    printf 'version\t%s\n' "$VERSION"
    printf 'revision\t%s\n' "$REVISION"
    bundle_rows
}

wrapper_content() {
    local name="$1"
    cat <<EOF
#!/usr/bin/env bash
set -Eeuo pipefail
SELF_DIR="\$(cd -P -- "\$(dirname "\${BASH_SOURCE[0]}")" && pwd -P)"
CURRENT="\$SELF_DIR/../libexec/codex-universal/current"
BUNDLE_DIR="\$(cd -P -- "\$CURRENT" && pwd -P)" || {
    printf 'ERROR: codex-universal installation is missing or invalid: %s\\n' "\$CURRENT" >&2
    exit 1
}
exec "\$BUNDLE_DIR/$name" "\$@"
EOF
}

verify_bundle_against_checkout() {
    local directory="$1"
    local name expected_mode actual_mode expected_hash actual_hash
    local expected_manifest actual_manifest entries expected_entries

    [[ -d "$directory" && ! -L "$directory" ]] || die "missing or unsafe bundle directory: $directory"
    expected_manifest="$(manifest_content)"
    [[ -f "$directory/MANIFEST" && ! -L "$directory/MANIFEST" ]] ||
        die "missing or unsafe bundle manifest: $directory/MANIFEST"
    actual_manifest="$(cat "$directory/MANIFEST")" || die "cannot read bundle manifest"
    [[ "$actual_manifest" == "$expected_manifest" ]] || die "bundle manifest does not match this checkout"
    [[ "$(codex_host_file_mode "$directory/MANIFEST")" == 644 ]] || die "incorrect mode for bundle manifest"

    for name in "${FILES[@]}"; do
        [[ -f "$directory/$name" && ! -L "$directory/$name" ]] || die "missing or unsafe bundle file: $name"
        expected_mode="$(file_mode "$name")"
        actual_mode="$(codex_host_file_mode "$directory/$name")"
        [[ "$actual_mode" == "$expected_mode" ]] || die "incorrect mode for bundle file $name: $actual_mode"
        expected_hash="$(codex_host_sha256_file "$(bundle_source_file "$name")")"
        actual_hash="$(codex_host_sha256_file "$directory/$name")"
        [[ "$actual_hash" == "$expected_hash" ]] || die "content mismatch for bundle file: $name"
    done

    entries="$(
        shopt -s nullglob dotglob
        paths=("$directory"/*)
        printf '%s\n' "${#paths[@]}"
    )"
    expected_entries=$((${#FILES[@]} + 1))
    [[ "$entries" == "$expected_entries" ]] || die "bundle contains unexpected entries: $directory"
}

valid_bundle_id() {
    local bundle_id="$1"

    [[ -n "$bundle_id" && ${#bundle_id} -le 128 &&
       "$bundle_id" != . && "$bundle_id" != .. &&
       "$bundle_id" =~ ^[A-Za-z0-9._-]+$ ]]
}

verify_retained_bundle() {
    local directory="$1"
    local directory_id="${2:-${directory##*/}}"
    local key value extra backend safe_version expected_id
    local name mode digest actual_mode actual_digest rows bundle_hash entries
    local -a lines=() expected_files=() paths=()
    local index

    [[ -d "$directory" && ! -L "$directory" ]] || die "missing or unsafe retained bundle: $directory"
    valid_bundle_id "$directory_id" || die "invalid retained bundle ID: $directory_id"
    [[ -f "$directory/MANIFEST" && ! -L "$directory/MANIFEST" ]] ||
        die "missing or unsafe retained bundle manifest: $directory/MANIFEST"
    [[ "$(codex_host_file_mode "$directory/MANIFEST")" == 644 ]] ||
        die "incorrect mode for retained bundle manifest: $directory_id"
    mapfile -t lines <"$directory/MANIFEST" || die "cannot read retained bundle manifest: $directory_id"
    ((${#lines[@]} >= 6)) || die "incomplete retained bundle manifest: $directory_id"

    IFS=$'\t' read -r key value extra <<<"${lines[0]}"
    [[ "$key" == format && "$value" == 1 && -z "$extra" ]] ||
        die "unsupported retained bundle manifest format: $directory_id"
    IFS=$'\t' read -r key RETAINED_BUNDLE extra <<<"${lines[1]}"
    [[ "$key" == bundle && "$RETAINED_BUNDLE" == "$directory_id" && -z "$extra" ]] ||
        die "retained bundle manifest ID mismatch: $directory_id"
    IFS=$'\t' read -r key RETAINED_VERSION extra <<<"${lines[2]}"
    [[ "$key" == version && -n "$RETAINED_VERSION" && -z "$extra" ]] ||
        die "invalid retained bundle version: $directory_id"
    IFS=$'\t' read -r key RETAINED_REVISION extra <<<"${lines[3]}"
    [[ "$key" == revision && "$RETAINED_REVISION" =~ ^[0-9a-fA-F]{40}$ && -z "$extra" ]] ||
        die "invalid retained bundle revision: $directory_id"
    IFS=$'\t' read -r key backend extra <<<"${lines[4]}"
    [[ "$key" == backend && -z "$extra" ]] || die "invalid retained bundle backend: $directory_id"
    RETAINED_BACKEND="$backend"

    case "$backend" in
        gnu-linux)
            expected_files=(run-codex setup-codex-idea codex-push codex-pull codex-collab codex-host-compat.bash codex-sync-lib run-codex-doctor.bash)
            ;;
        darwin-gnu)
            # Retain verification and rollback support for sync-only bundles
            # installed before the generic Docker Desktop launcher shipped.
            if ((${#lines[@]} == 10)); then
                expected_files=(codex-push codex-pull codex-collab codex-host-compat.bash codex-sync-lib)
            else
                expected_files=(run-codex codex-push codex-pull codex-collab codex-host-compat.bash codex-sync-lib run-codex-doctor.bash codex-bwrap-seccomp.json)
            fi
            ;;
        *)
            die "unsupported retained bundle backend '$backend': $directory_id"
            ;;
    esac
    ((${#lines[@]} == ${#expected_files[@]} + 5)) ||
        die "incorrect retained bundle manifest entry count: $directory_id"

    rows="$(printf 'backend\t%s\n' "$backend")"
    for ((index = 0; index < ${#expected_files[@]}; index++)); do
        IFS=$'\t' read -r key mode digest name extra <<<"${lines[index + 5]}"
        [[ "$key" == file && -z "$extra" && "$name" == "${expected_files[index]}" ]] ||
            die "invalid retained bundle file row: $directory_id"
        [[ "$mode" == "$(file_mode "$name")" && "$digest" =~ ^[0-9a-fA-F]{64}$ ]] ||
            die "invalid retained bundle file metadata: $directory_id/$name"
        [[ -f "$directory/$name" && ! -L "$directory/$name" ]] ||
            die "missing or unsafe retained bundle file: $directory_id/$name"
        actual_mode="$(codex_host_file_mode "$directory/$name")"
        [[ "$actual_mode" == "$mode" ]] || die "incorrect retained bundle file mode: $directory_id/$name"
        actual_digest="$(codex_host_sha256_file "$directory/$name")"
        [[ "$actual_digest" == "$digest" ]] || die "retained bundle content mismatch: $directory_id/$name"
        rows+=$'\n'"file"$'\t'"$mode"$'\t'"$digest"$'\t'"$name"
    done

    entries="$({ shopt -s nullglob dotglob; paths=("$directory"/*); printf '%s\n' "${#paths[@]}"; })"
    [[ "$entries" == "$((${#expected_files[@]} + 1))" ]] ||
        die "retained bundle contains unexpected entries: $directory_id"

    bundle_hash="$(printf '%s\n' "$rows" | codex_host_sha256_stdin)" ||
        die "cannot hash retained bundle manifest rows: $directory_id"
    safe_version="${RETAINED_VERSION//[^A-Za-z0-9._-]/-}"
    safe_version="${safe_version:0:80}"
    expected_id="${safe_version}-${backend}-${bundle_hash:0:16}"
    [[ "$directory_id" == "$expected_id" ]] || die "retained bundle ID does not match its manifest: $directory_id"
}

verify_wrappers() {
    local name expected_name expected_hash actual_hash actual_mode expected

    for name in "${WRAPPERS[@]}"; do
        [[ -f "$BIN_DIR/$name" && ! -L "$BIN_DIR/$name" ]] || die "missing or unsafe command wrapper: $BIN_DIR/$name"
        actual_mode="$(codex_host_file_mode "$BIN_DIR/$name")"
        [[ "$actual_mode" == "$(wrapper_mode "$name")" ]] ||
            die "incorrect wrapper mode for $name: $actual_mode"
        expected_hash="$(wrapper_content "$name" | codex_host_sha256_stdin)"
        actual_hash="$(codex_host_sha256_file "$BIN_DIR/$name")"
        [[ "$actual_hash" == "$expected_hash" ]] || die "wrapper content mismatch: $BIN_DIR/$name"
    done

    for name in "${ALL_WRAPPERS[@]}"; do
        expected=false
        for expected_name in "${WRAPPERS[@]}"; do
            if [[ "$name" == "$expected_name" ]]; then
                expected=true
                break
            fi
        done
        if ! $expected && [[ -e "$BIN_DIR/$name" || -L "$BIN_DIR/$name" ]]; then
            die "unsupported wrapper is present for $CODEX_HOST_BACKEND: $BIN_DIR/$name"
        fi
    done
}

preflight_wrappers() {
    local name expected_name expected=false expected_hash actual_hash actual_mode

    for name in "${ALL_WRAPPERS[@]}"; do
        expected=false
        for expected_name in "${WRAPPERS[@]}"; do
            if [[ "$name" == "$expected_name" ]]; then
                expected=true
                break
            fi
        done

        if ! $expected; then
            [[ ! -e "$BIN_DIR/$name" && ! -L "$BIN_DIR/$name" ]] ||
                die "unsupported wrapper already exists for $CODEX_HOST_BACKEND: $BIN_DIR/$name"
            continue
        fi

        [[ ! -L "$BIN_DIR/$name" ]] || die "refusing to replace symlink wrapper: $BIN_DIR/$name"
        [[ -e "$BIN_DIR/$name" ]] || continue
        [[ -f "$BIN_DIR/$name" ]] || die "refusing to replace non-file wrapper: $BIN_DIR/$name"
        expected_hash="$(wrapper_content "$name" | codex_host_sha256_stdin)"
        actual_hash="$(codex_host_sha256_file "$BIN_DIR/$name")"
        actual_mode="$(codex_host_file_mode "$BIN_DIR/$name")"
        [[ "$actual_hash" == "$expected_hash" && "$actual_mode" == "$(wrapper_mode "$name")" ]] ||
            die "refusing to replace an unmanaged command: $BIN_DIR/$name"
    done
}

lock_existing_installation() {
    reject_symlink_components "$INSTALL_ROOT"
    [[ -d "$INSTALL_ROOT" && ! -L "$INSTALL_ROOT" ]] ||
        die "host-tool installation is missing or unsafe: $INSTALL_ROOT"
    [[ -f "$LOCK_FILE" && ! -L "$LOCK_FILE" ]] ||
        die "installation lock is missing or unsafe: $LOCK_FILE"
    [[ "$(codex_host_file_link_count "$LOCK_FILE")" == 1 ]] ||
        die "installation lock has an unsafe link count: $LOCK_FILE"
    exec 9<>"$LOCK_FILE"
    codex_host_lock_exclusive 9 || die "cannot lock host-tool installation: $LOCK_FILE"
}

read_current_bundle_id() {
    [[ -L "$CURRENT_LINK" ]] || die "current bundle link is missing or is not a symlink: $CURRENT_LINK"
    CURRENT_ID="$(readlink "$CURRENT_LINK")" || die "cannot read current bundle link: $CURRENT_LINK"
    valid_bundle_id "$CURRENT_ID" || die "current bundle link has an unsafe target: $CURRENT_ID"
}

TEMP_BUNDLE=""
TEMP_LINK_DIR=""
TEMP_WRAPPER=""
TEMP_REMOVAL_DIR=""
REMOVAL_MARKER=REMOVE-MANIFEST
cleanup() {
    [[ -z "$TEMP_WRAPPER" || ! -e "$TEMP_WRAPPER" ]] || rm -f "$TEMP_WRAPPER"
    if [[ -n "$TEMP_LINK_DIR" && -d "$TEMP_LINK_DIR" && ! -L "$TEMP_LINK_DIR" ]]; then
        rm -f "$TEMP_LINK_DIR/current"
        rmdir "$TEMP_LINK_DIR"
    fi
    [[ -z "$TEMP_BUNDLE" || ! -d "$TEMP_BUNDLE" ]] || rm -rf "$TEMP_BUNDLE"
    if [[ -n "$TEMP_REMOVAL_DIR" && -d "$TEMP_REMOVAL_DIR" && ! -L "$TEMP_REMOVAL_DIR" ]]; then
        rm -f "$TEMP_REMOVAL_DIR/$REMOVAL_MARKER"
        rmdir "$TEMP_REMOVAL_DIR" 2>/dev/null || true
    fi
}

switch_current_bundle() {
    local bundle_id="$1"

    TEMP_LINK_DIR="$(mktemp -d "$INSTALL_ROOT/.current.XXXXXXXX")"
    ln -s "$bundle_id" "$TEMP_LINK_DIR/current"
    codex_host_atomic_replace "$TEMP_LINK_DIR/current" "$CURRENT_LINK" || die "cannot switch current bundle"
    rmdir "$TEMP_LINK_DIR"
    TEMP_LINK_DIR=""
}

REMOVAL_TOMBSTONES=()
removal_marker_content() {
    local bundle_id="$1"
    local tombstone_name="$2"

    printf 'format\t1\n'
    printf 'bundle\t%s\n' "$bundle_id"
    printf 'tombstone\t%s\n' "$tombstone_name"
}

collect_removal_tombstones() {
    local bundle_id="$1"
    local tombstone marker expected_marker actual_marker entry entry_name
    local -a entries=()

    REMOVAL_TOMBSTONES=()
    shopt -s nullglob
    for tombstone in "$INSTALL_ROOT/.remove.${bundle_id}."*; do
        [[ -d "$tombstone" && ! -L "$tombstone" ]] ||
            die "unsafe removal tombstone: $tombstone"
        [[ "$(codex_host_file_mode "$tombstone")" == 700 ]] ||
            die "incorrect removal tombstone mode: $tombstone"
        marker="$tombstone/$REMOVAL_MARKER"
        [[ -f "$marker" && ! -L "$marker" ]] || die "missing or unsafe removal marker: $tombstone"
        [[ "$(codex_host_file_mode "$marker")" == 600 &&
           "$(codex_host_file_link_count "$marker")" == 1 ]] ||
            die "unsafe removal marker metadata: $tombstone"
        expected_marker="$(removal_marker_content "$bundle_id" "${tombstone##*/}")"
        actual_marker="$(cat "$marker")" || die "cannot read removal marker: $tombstone"
        [[ "$actual_marker" == "$expected_marker" ]] || die "invalid removal marker: $tombstone"
        shopt -s dotglob
        entries=("$tombstone"/*)
        shopt -u dotglob
        for entry in "${entries[@]}"; do
            entry_name="${entry##*/}"
            [[ "$entry_name" == "$REMOVAL_MARKER" || "$entry_name" == bundle ]] ||
                die "invalid removal tombstone contents: $tombstone"
        done
        if [[ -e "$tombstone/bundle" || -L "$tombstone/bundle" ]]; then
            [[ -d "$tombstone/bundle" && ! -L "$tombstone/bundle" ]] ||
                die "unsafe removal tombstone bundle: $tombstone"
        fi
        REMOVAL_TOMBSTONES+=("$tombstone")
    done
    shopt -u nullglob
}

if [[ "$MODE" == dry-run ]]; then
    printf 'Would install codex-universal %s (%s)\n' "$VERSION" "$REVISION"
    printf 'Backend: %s\nPrefix: %s\nBundle: %s\n' "$CODEX_HOST_BACKEND" "$PREFIX" "$BUNDLE_DIR"
    printf 'Commands:'
    printf ' %s' "${WRAPPERS[@]}"
    printf '\n'
    exit 0
fi

if [[ "$MODE" == check ]]; then
    reject_symlink_components "$BIN_DIR"
    lock_existing_installation
    read_current_bundle_id
    [[ "$CURRENT_ID" == "$BUNDLE_ID" ]] || die "current bundle does not match this checkout"
    verify_bundle_against_checkout "$BUNDLE_DIR"
    verify_wrappers
    printf 'codex-universal host tools are valid: %s\n' "$BUNDLE_ID"
    exit 0
fi

if [[ "$MODE" == list ]]; then
    local_bundle_ids=()
    lock_existing_installation
    read_current_bundle_id
    [[ -d "$INSTALL_ROOT/$CURRENT_ID" && ! -L "$INSTALL_ROOT/$CURRENT_ID" ]] ||
        die "current bundle target is missing or unsafe: $CURRENT_ID"
    shopt -s nullglob
    for directory in "$INSTALL_ROOT"/*; do
        [[ -d "$directory" && ! -L "$directory" ]] || continue
        local_bundle_ids+=("${directory##*/}")
    done
    shopt -u nullglob
    ((${#local_bundle_ids[@]} > 0)) || die "no retained bundles found in $INSTALL_ROOT"
    printf 'CURRENT\tBUNDLE\tVERSION\tREVISION\tBACKEND\n'
    while IFS= read -r bundle_id; do
        verify_retained_bundle "$INSTALL_ROOT/$bundle_id"
        marker=-
        [[ "$bundle_id" == "$CURRENT_ID" ]] && marker='*'
        printf '%s\t%s\t%s\t%s\t%s\n' "$marker" "$RETAINED_BUNDLE" \
            "$RETAINED_VERSION" "$RETAINED_REVISION" "$RETAINED_BACKEND"
    done < <(printf '%s\n' "${local_bundle_ids[@]}" | LC_ALL=C sort)
    exit 0
fi

if [[ "$MODE" == rollback ]]; then
    valid_bundle_id "$ROLLBACK_ID" || die "invalid rollback bundle ID: $ROLLBACK_ID"
    reject_symlink_components "$BIN_DIR"
    lock_existing_installation
    read_current_bundle_id
    verify_retained_bundle "$INSTALL_ROOT/$ROLLBACK_ID"
    [[ "$RETAINED_BACKEND" == "$CODEX_HOST_BACKEND" ]] ||
        die "retained bundle backend '$RETAINED_BACKEND' is incompatible with '$CODEX_HOST_BACKEND'"
    verify_wrappers
    if [[ "$CURRENT_ID" == "$ROLLBACK_ID" ]]; then
        printf 'Bundle is already current: %s\n' "$ROLLBACK_ID"
        exit 0
    fi
    trap cleanup EXIT
    switch_current_bundle "$ROLLBACK_ID"
    printf 'Rolled back codex-universal host tools to %s\n' "$ROLLBACK_ID"
    exit 0
fi

if [[ "$MODE" == remove ]]; then
    valid_bundle_id "$REMOVE_ID" || die "invalid removal bundle ID: $REMOVE_ID"
    lock_existing_installation
    read_current_bundle_id
    [[ "$CURRENT_ID" != "$REMOVE_ID" ]] ||
        die "refusing to remove the current bundle; roll back to another bundle first"
    verify_retained_bundle "$INSTALL_ROOT/$CURRENT_ID"

    collect_removal_tombstones "$REMOVE_ID"
    remove_directory="$INSTALL_ROOT/$REMOVE_ID"
    remove_live=false
    if [[ -e "$remove_directory" || -L "$remove_directory" ]]; then
        verify_retained_bundle "$remove_directory"
        remove_live=true
    elif ((${#REMOVAL_TOMBSTONES[@]} == 0)); then
        die "retained bundle does not exist: $REMOVE_ID"
    fi

    if $DRY_RUN; then
        printf 'Would remove inactive codex-universal bundle: %s\n' "$REMOVE_ID"
        if ((${#REMOVAL_TOMBSTONES[@]} > 0)); then
            printf 'Pending removal tombstones: %s\n' "${#REMOVAL_TOMBSTONES[@]}"
        fi
        exit 0
    fi

    if $remove_live; then
        trap cleanup EXIT
        TEMP_REMOVAL_DIR="$(mktemp -d "$INSTALL_ROOT/.remove.${REMOVE_ID}.XXXXXXXX")"
        chmod 700 "$TEMP_REMOVAL_DIR"
        removal_marker_content "$REMOVE_ID" "${TEMP_REMOVAL_DIR##*/}" \
            >"$TEMP_REMOVAL_DIR/$REMOVAL_MARKER"
        chmod 600 "$TEMP_REMOVAL_DIR/$REMOVAL_MARKER"
        codex_host_atomic_replace "$remove_directory" "$TEMP_REMOVAL_DIR/bundle" ||
            die "cannot move retained bundle into removal tombstone: $REMOVE_ID"
        REMOVAL_TOMBSTONES+=("$TEMP_REMOVAL_DIR")
        TEMP_REMOVAL_DIR=""
    fi

    for removal_tombstone in "${REMOVAL_TOMBSTONES[@]}"; do
        if [[ -e "$removal_tombstone/bundle" || -L "$removal_tombstone/bundle" ]]; then
            if ! rm -rf "$removal_tombstone/bundle"; then
                die "cannot delete tombstoned bundle; preserved for recovery: $removal_tombstone"
            fi
        fi
        [[ ! -e "$removal_tombstone/bundle" && ! -L "$removal_tombstone/bundle" ]] ||
            die "tombstoned bundle still exists: $removal_tombstone"
        if ! rm -f "$removal_tombstone/$REMOVAL_MARKER" || ! rmdir "$removal_tombstone"; then
            die "cannot delete removal tombstone; preserved for recovery: $removal_tombstone"
        fi
        [[ ! -e "$removal_tombstone" && ! -L "$removal_tombstone" ]] ||
            die "removal tombstone still exists: $removal_tombstone"
    done
    printf 'Removed inactive codex-universal bundle: %s\n' "$REMOVE_ID"
    exit 0
fi

reject_symlink_components "$INSTALL_ROOT"
reject_symlink_components "$BIN_DIR"
[[ ! -e "$CURRENT_LINK" || -L "$CURRENT_LINK" ]] || die "refusing to replace non-symlink current path: $CURRENT_LINK"
preflight_wrappers
mkdir -p "$INSTALL_ROOT" "$BIN_DIR"
reject_symlink_components "$INSTALL_ROOT"
reject_symlink_components "$BIN_DIR"

if [[ -e "$LOCK_FILE" || -L "$LOCK_FILE" ]]; then
    [[ -f "$LOCK_FILE" && ! -L "$LOCK_FILE" ]] ||
        die "refusing to use unsafe install lock: $LOCK_FILE"
    [[ "$(codex_host_file_link_count "$LOCK_FILE")" == 1 ]] ||
        die "refusing to use multiply linked install lock: $LOCK_FILE"
fi
exec 9>>"$LOCK_FILE"
codex_host_lock_exclusive 9 || die "cannot lock host-tool installation: $LOCK_FILE"
preflight_wrappers

trap cleanup EXIT

if [[ -e "$BUNDLE_DIR" || -L "$BUNDLE_DIR" ]]; then
    verify_bundle_against_checkout "$BUNDLE_DIR"
else
    TEMP_BUNDLE="$(mktemp -d "$INSTALL_ROOT/.bundle.XXXXXXXX")"
    chmod 755 "$TEMP_BUNDLE"
    for name in "${FILES[@]}"; do
        install -m "$(file_mode "$name")" "$(bundle_source_file "$name")" "$TEMP_BUNDLE/$name"
    done
    manifest_content >"$TEMP_BUNDLE/MANIFEST"
    chmod 644 "$TEMP_BUNDLE/MANIFEST"
    verify_bundle_against_checkout "$TEMP_BUNDLE"
    codex_host_atomic_replace "$TEMP_BUNDLE" "$BUNDLE_DIR" || die "cannot publish bundle: $BUNDLE_DIR"
    TEMP_BUNDLE=""
fi

# Wrappers contain no version-specific state, so publishing them before current
# keeps an existing installation usable and makes current the commit point.
for name in "${WRAPPERS[@]}"; do
    TEMP_WRAPPER="$(mktemp "$BIN_DIR/.${name}.tmp.XXXXXXXX")"
    wrapper_content "$name" >"$TEMP_WRAPPER"
    chmod "$(wrapper_mode "$name")" "$TEMP_WRAPPER"
    codex_host_atomic_replace "$TEMP_WRAPPER" "$BIN_DIR/$name" || die "cannot publish wrapper: $name"
    TEMP_WRAPPER=""
done

switch_current_bundle "$BUNDLE_ID"

verify_bundle_against_checkout "$BUNDLE_DIR"
verify_wrappers
printf 'Installed codex-universal %s (%s)\n' "$VERSION" "$REVISION"
printf 'Commands: %s\n' "$BIN_DIR"
