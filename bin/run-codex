#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

CONFIG_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/run-codex"
PROJECTS_DIR="$CONFIG_ROOT/projects"
LOCK_FILE="${CODEX_LOCK_FILE:-$HOME/.cache/codex-handoff.lock}"

CONTAINER_HOME="${CODEX_CONTAINER_HOME:-/home/codex}"
WORKSPACE_ROOT="${CODEX_WORKSPACE_ROOT:-/workspace}"
IMAGE_SLUG="${CODEX_IMAGE_SLUG:-${CODEX_IMAGE_PREFIX:-leafclick/codex-universal}}"
IMAGE_TAG="${CODEX_IMAGE_TAG:-latest}"
DEFAULT_PROFILE="${CODEX_DEFAULT_PROFILE:-generic}"
APPARMOR_PROFILE="${CODEX_APPARMOR_PROFILE:-codex-universal}"
SECCOMP_PROFILE="${CODEX_SECCOMP_PROFILE:-$CONFIG_ROOT/security/codex-bwrap.json}"
CLOJURE_LSP_MCP_OVERRIDE="${CODEX_CLOJURE_LSP_MCP:-}"
IDEA_MCP="${CODEX_IDEA_MCP:-1}"
IDEA_MCP_PORT="${CODEX_IDEA_MCP_PORT:-64342}"
IDEA_MCP_PATH="${CODEX_IDEA_MCP_PATH:-/stream}"
WORKFLOW_ENABLED="${CODEX_UNIVERSAL_WORKFLOW:-1}"
HOST_UID="$EUID"
HOST_GID="${GROUPS[0]}"
IDEA_MCP_ALLOWED_TOOLS='[
    "analyze_calls",
    "get_file_problems",
    "get_project_dependencies",
    "get_project_modules",
    "lint_files",
    "get_symbol_info",
    "get_all_open_file_paths",
    "list_directory_tree",
    "read_file",
    "search_file",
    "search_regex",
    "search_symbol",
    "search_text"
]'
CLOJURE_LSP_MCP_ALLOWED_TOOLS='[
    "start_lsp",
    "restart_lsp_server",
    "get_server_capabilities",
    "open_document",
    "close_document",
    "did_change_watched_files",
    "list_symbols",
    "find_symbol",
    "inspect_symbol",
    "get_symbol_source",
    "explore_symbol",
    "go_to_definition",
    "go_to_implementation",
    "find_references",
    "find_callers",
    "get_diagnostics",
    "get_completions",
    "get_signature_help",
    "suggest_fixes",
    "execute_command",
    "format_document",
    "prepare_rename",
    "rename_symbol",
    "preview_edit",
    "apply_edit",
    "safe_apply_edit",
    "safe_delete_symbol",
    "replace_symbol_body"
]'

usage() {
    cat <<'USAGE'
Usage:
  run-codex [PROJECT] [--new] [--codex-option OPTION]...
  run-codex --new [PROJECT] [--codex-option OPTION]...
  run-codex --idea PROJECT

  run-codex --init [--profile generic|cuda] [--clojure-mcp auto|on|off] [PROJECT [PATH]]
  run-codex --rebind PROJECT [PATH]
  run-codex --set-profile PROJECT generic|cuda
  run-codex --set-clojure-mcp PROJECT auto|on|off
  run-codex --doctor [PROJECT]
  run-codex --list

Codex options (terminal mode, repeat --codex-option as needed):
  model=MODEL
  reasoning=minimal|low|medium|high|xhigh
  search
  no-alt-screen
  strict-config
  image=PROJECT_PATH
  prompt=TEXT

Examples:
  cd ~/src/cortex
  run-codex --init --profile cuda
  run-codex

  run-codex cortex
  run-codex cortex --new
  run-codex cortex --new --codex-option model=gpt-5.6-sol --codex-option reasoning=high
  run-codex cortex --codex-option no-alt-screen
  run-codex --idea cortex
  run-codex --doctor cortex
  run-codex --set-profile cortex generic
  run-codex --set-clojure-mcp cortex auto

Environment:
  CODEX_IMAGE_SLUG=leafclick/codex-universal
  CODEX_IMAGE_TAG=latest
  CODEX_APPARMOR_PROFILE=codex-universal
  CODEX_SECCOMP_PROFILE=~/.config/run-codex/security/codex-bwrap.json
  CODEX_CLOJURE_LSP_MCP=VALUE  Override project setting: auto, on/off, or 1/0
  CODEX_IDEA_MCP=1         Enable the private IntelliJ HTTP relay in IDEA mode
  CODEX_IDEA_MCP_PORT=64342
  CODEX_IDEA_MCP_PATH=/stream
USAGE
}

die() {
    echo "ERROR: $*" >&2
    exit 1
}

validate_container_mount_path() {
    local variable="$1"
    local value="${!variable}"

    [[ "$value" == /* && "$value" != / ]] ||
        die "$variable must be an absolute non-root container path: $value"
    [[ "$value" != *:* && "$value" != *,* && "$value" != *$'\n'* ]] ||
        die "$variable contains a Docker mount delimiter: $value"
    [[ "$value" != */ && "$value" != *//* &&
       "$value" != */./* && "$value" != */../* &&
       "$value" != */. && "$value" != */.. ]] ||
        die "$variable must be lexically normalized: $value"
}

container_paths_overlap() {
    [[ "$1" == "$2" || "$1" == "$2/"* || "$2" == "$1/"* ]]
}

need() {
    command -v "$1" >/dev/null 2>&1 || die "Missing command: $1"
}

run_idea_relay_guard() {
    (($# == 6)) || die "Invalid IntelliJ relay guard invocation"

    IDEA_GUARD_LAUNCHER_PID="$1"
    IDEA_GUARD_RUNTIME_DIR="$2"
    IDEA_GUARD_RELAY_SOCKET="$3"
    IDEA_GUARD_RELAY_LOG="$4"
    IDEA_GUARD_RELAY_PORT="$5"
    IDEA_GUARD_CID_FILE="$6"
    IDEA_GUARD_RELAY_PID=""
    local runtime_owner_mode=""

    [[ "$IDEA_GUARD_LAUNCHER_PID" =~ ^[0-9]+$ ]] &&
        ((IDEA_GUARD_LAUNCHER_PID > 1)) ||
        die "Invalid IntelliJ relay guard parent PID"
    [[ "$IDEA_GUARD_RUNTIME_DIR" =~ ^/tmp/codex-idea-mcp\.[A-Za-z0-9]{6}$ ]] ||
        die "Invalid IntelliJ relay guard runtime directory"
    [[ -d "$IDEA_GUARD_RUNTIME_DIR" && ! -L "$IDEA_GUARD_RUNTIME_DIR" ]] ||
        die "Invalid IntelliJ relay guard runtime directory"
    [[ "$IDEA_GUARD_RELAY_SOCKET" == "$IDEA_GUARD_RUNTIME_DIR/idea-mcp.sock" &&
       "$IDEA_GUARD_RELAY_LOG" == "$IDEA_GUARD_RUNTIME_DIR/idea-mcp-relay.log" &&
       "$IDEA_GUARD_CID_FILE" == "$IDEA_GUARD_RUNTIME_DIR/container.cid" ]] ||
        die "Invalid IntelliJ relay guard path"
    [[ "$IDEA_GUARD_RELAY_PORT" =~ ^[0-9]+$ ]] &&
        ((10#$IDEA_GUARD_RELAY_PORT >= 1024 && 10#$IDEA_GUARD_RELAY_PORT <= 65535)) ||
        die "Invalid IntelliJ relay guard port"

    cleanup_idea_relay_guard() {
        local status=$?
        local job_pid=""
        local relay_is_our_job=false

        trap - EXIT HUP INT TERM
        if [[ "$IDEA_GUARD_RELAY_PID" =~ ^[0-9]+$ ]]; then
            # Avoid signaling a recycled PID if socat exited independently.
            for job_pid in $(jobs -pr); do
                if [[ "$job_pid" == "$IDEA_GUARD_RELAY_PID" ]]; then
                    relay_is_our_job=true
                    break
                fi
            done
            if $relay_is_our_job; then
                kill "$IDEA_GUARD_RELAY_PID" >/dev/null 2>&1 || true
            fi
            wait "$IDEA_GUARD_RELAY_PID" 2>/dev/null || true
        fi
        if [[ -s "$IDEA_GUARD_CID_FILE" && ! -L "$IDEA_GUARD_CID_FILE" ]]; then
            local container_id="$(<"$IDEA_GUARD_CID_FILE")"
            if [[ "$container_id" =~ ^[0-9a-f]{64}$ ]]; then
                docker rm -f -- "$container_id" >/dev/null 2>&1 || true
            fi
        fi
        rm -f -- \
            "$IDEA_GUARD_CID_FILE" \
            "$IDEA_GUARD_RELAY_SOCKET" \
            "$IDEA_GUARD_RELAY_LOG"
        rmdir -- "$IDEA_GUARD_RUNTIME_DIR" 2>/dev/null || true
        exit "$status"
    }

    trap cleanup_idea_relay_guard EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    # setpriv installs the parent-death signal before execing this guard. The
    # trap and explicit check close the race where the launcher exits first.
    [[ "$PPID" == "$IDEA_GUARD_LAUNCHER_PID" ]] ||
        die "IntelliJ relay launcher exited before guard startup"

    need stat
    need docker
    need socat
    runtime_owner_mode="$(stat -c '%u:%a' -- "$IDEA_GUARD_RUNTIME_DIR")"
    [[ "$runtime_owner_mode" == "$EUID:700" ]] ||
        die "Unsafe IntelliJ relay guard runtime directory permissions"

    socat \
        "UNIX-LISTEN:${IDEA_GUARD_RELAY_SOCKET},fork,mode=0600" \
        "TCP4:127.0.0.1:${IDEA_GUARD_RELAY_PORT}" \
        >"$IDEA_GUARD_RELAY_LOG" 2>&1 &
    IDEA_GUARD_RELAY_PID=$!
    wait "$IDEA_GUARD_RELAY_PID"
}

if [[ "${1:-}" == --internal-idea-relay-guard ]]; then
    shift
    run_idea_relay_guard "$@"
    exit $?
fi

case "$CLOJURE_LSP_MCP_OVERRIDE" in
    ''|auto|on|off|0|1) ;;
    *) die "CODEX_CLOJURE_LSP_MCP must be auto, on, off, 1, or 0" ;;
esac

case "$IDEA_MCP" in
    0|1) ;;
    *) die "CODEX_IDEA_MCP must be 0 or 1" ;;
esac
case "$WORKFLOW_ENABLED" in
    0|1|uninstall) ;;
    *) die "CODEX_UNIVERSAL_WORKFLOW must be 0, 1, or uninstall" ;;
esac

validate_container_mount_path CONTAINER_HOME
validate_container_mount_path WORKSPACE_ROOT
container_paths_overlap "$CONTAINER_HOME" /workspace &&
    die "CODEX_CONTAINER_HOME must not overlap the image workspace"
container_paths_overlap "$CONTAINER_HOME" "$WORKSPACE_ROOT" &&
    die "CODEX_CONTAINER_HOME and CODEX_WORKSPACE_ROOT must not overlap"
for reserved_runtime_path in \
    /tmp \
    /run/codex-idea-mcp; do
    container_paths_overlap "$CONTAINER_HOME" "$reserved_runtime_path" &&
        die "CODEX_CONTAINER_HOME overlaps reserved runtime path $reserved_runtime_path"
    container_paths_overlap "$WORKSPACE_ROOT" "$reserved_runtime_path" &&
        die "CODEX_WORKSPACE_ROOT overlaps reserved runtime path $reserved_runtime_path"
done
unset reserved_runtime_path

# Docker makes tmpfs mounts noexec by default. Native runtimes must be able to
# map libraries from both temporary locations: JavaCPP defaults to
# $HOME/.javacpp/cache, while others use java.io.tmpdir.
HOME_TMPFS_SPEC="${CONTAINER_HOME}:rw,exec,nosuid,nodev,uid=${HOST_UID},gid=${HOST_GID},mode=0700"
TMP_TMPFS_SPEC="/tmp:rw,exec,nosuid,nodev,mode=1777"
DOCTOR_WORKSPACE_TMPFS_SPEC="/workspace:rw,nosuid,nodev,uid=${HOST_UID},gid=${HOST_GID},mode=0700"

validate_project_name() {
    local name="$1"
    [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] ||
        die "Invalid project name '$name'. Use letters, digits, '.', '_' or '-'."
}

validate_profile() {
    case "$1" in
        generic|cuda) ;;
        *) die "Invalid profile '$1'. Supported profiles: generic, cuda" ;;
    esac
}

validate_clojure_mcp_setting() {
    case "$1" in
        auto|on|off) ;;
        *) die "Invalid Clojure MCP setting '$1'. Supported values: auto, on, off" ;;
    esac
}

normalize_clojure_mcp_setting() {
    case "$1" in
        1) printf '%s\n' on ;;
        0) printf '%s\n' off ;;
        auto|on|off) printf '%s\n' "$1" ;;
        *) return 1 ;;
    esac
}

CODEX_FORWARD_ARGS=()
CODEX_IMAGE_REQUESTS=()
CODEX_INITIAL_PROMPT=""
CODEX_MODEL_SET=false
CODEX_REASONING_SET=false
CODEX_SEARCH_SET=false
CODEX_NO_ALT_SCREEN_SET=false
CODEX_STRICT_CONFIG_SET=false
CODEX_PROMPT_SET=false

add_codex_option() {
    local option="$1"
    local value=""

    [[ -n "$option" ]] || die "--codex-option cannot be empty"

    case "$option" in
        model=*)
            value="${option#model=}"
            [[ "$value" =~ ^[A-Za-z0-9][A-Za-z0-9._:/-]*$ ]] ||
                die "Invalid Codex model '$value'"
            ! $CODEX_MODEL_SET || die "Codex option 'model' may be specified only once"
            CODEX_MODEL_SET=true
            CODEX_FORWARD_ARGS+=(--model "$value")
            ;;
        reasoning=*)
            value="${option#reasoning=}"
            case "$value" in
                minimal|low|medium|high|xhigh) ;;
                *) die "Invalid Codex reasoning effort '$value'. Supported values: minimal, low, medium, high, xhigh" ;;
            esac
            ! $CODEX_REASONING_SET ||
                die "Codex option 'reasoning' may be specified only once"
            CODEX_REASONING_SET=true
            CODEX_FORWARD_ARGS+=(-c "model_reasoning_effort=\"$value\"")
            ;;
        search)
            ! $CODEX_SEARCH_SET || die "Codex option 'search' may be specified only once"
            CODEX_SEARCH_SET=true
            CODEX_FORWARD_ARGS+=(--search)
            ;;
        no-alt-screen)
            ! $CODEX_NO_ALT_SCREEN_SET ||
                die "Codex option 'no-alt-screen' may be specified only once"
            CODEX_NO_ALT_SCREEN_SET=true
            CODEX_FORWARD_ARGS+=(--no-alt-screen)
            ;;
        strict-config)
            ! $CODEX_STRICT_CONFIG_SET ||
                die "Codex option 'strict-config' may be specified only once"
            CODEX_STRICT_CONFIG_SET=true
            CODEX_FORWARD_ARGS+=(--strict-config)
            ;;
        image=*)
            value="${option#image=}"
            [[ -n "$value" ]] || die "Codex option 'image' requires a project file path"
            CODEX_IMAGE_REQUESTS+=("$value")
            ;;
        prompt=*)
            value="${option#prompt=}"
            [[ -n "$value" ]] || die "Codex option 'prompt' cannot be empty"
            ! $CODEX_PROMPT_SET || die "Codex option 'prompt' may be specified only once"
            CODEX_PROMPT_SET=true
            CODEX_INITIAL_PROMPT="$value"
            ;;
        *)
            die "Unsupported Codex option '$option'. Supported options: model=MODEL, reasoning=EFFORT, search, no-alt-screen, strict-config, image=PATH, prompt=TEXT"
            ;;
    esac
}

resolve_codex_image_options() {
    local container_project="$1"
    local requested candidate host_image relative

    for requested in "${CODEX_IMAGE_REQUESTS[@]}"; do
        if [[ "$requested" == /* ]]; then
            candidate="$requested"
        else
            candidate="$PROJECT_PATH/$requested"
        fi

        host_image="$(realpath -e -- "$candidate")" ||
            die "Codex image file does not exist: $requested"
        [[ -f "$host_image" && -r "$host_image" ]] ||
            die "Codex image is not a readable file: $requested"
        [[ "$host_image" == "$PROJECT_PATH/"* ]] ||
            die "Codex image must resolve inside the registered project: $requested"

        relative="${host_image#"$PROJECT_PATH/"}"
        CODEX_FORWARD_ARGS+=(--image "$container_project/$relative")
    done
}

parse_launch_args() {
    while (($#)); do
        case "$1" in
            --new)
                ! $NEW_SESSION || die "--new may be specified only once"
                NEW_SESSION=true
                shift
                ;;
            --codex-option)
                (($# >= 2)) || die "--codex-option requires a value"
                add_codex_option "$2"
                shift 2
                ;;
            --codex-option=*)
                add_codex_option "${1#--codex-option=}"
                shift
                ;;
            --*)
                die "Unknown launch option '$1'. Use --codex-option for supported Codex options."
                ;;
            *)
                [[ -z "$PROJECT" ]] || die "Only one project may be specified"
                PROJECT="$1"
                shift
                ;;
        esac
    done
}

profile_image() {
    local profile="$1"
    validate_profile "$profile"
    [[ "$IMAGE_TAG" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$ ]] ||
        die "Invalid CODEX_IMAGE_TAG: $IMAGE_TAG"
    printf '%s-%s:%s\n' "$IMAGE_SLUG" "$profile" "$IMAGE_TAG"
}

canonical_dir() {
    local path="$1"
    [[ -d "$path" ]] || return 1
    realpath -e -- "$path"
}

git_root_for() {
    local path="$1"
    local root

    root="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null)" || return 1
    canonical_dir "$root"
}

check_supported_repo() {
    local root="$1"

    if [[ -f "$root/.git" ]]; then
        die "Git worktrees/submodules with a .git pointer file are not supported yet: $root"
    fi
}

CONFIG_PATH=""
CONFIG_PROFILE=""
CONFIG_CLOJURE_MCP=""

read_project_config() {
    local file="$1"
    local first=""
    local path=""
    local profile=""
    local clojure_mcp=""

    [[ -f "$file" ]] || return 1
    IFS= read -r first < "$file" || true

    # Backward compatibility with the old registry format, which contained
    # only one line with the project path.
    if [[ "$first" != *=* ]]; then
        path="$first"
        profile="generic"
        clojure_mcp="auto"
    else
        while IFS= read -r line || [[ -n "$line" ]]; do
            case "$line" in
                path=*)
                    path="${line#path=}"
                    ;;
                profile=*)
                    profile="${line#profile=}"
                    ;;
                clojure_mcp=*)
                    clojure_mcp="${line#clojure_mcp=}"
                    ;;
                ''|'#'*)
                    ;;
                *)
                    die "Invalid project config line in $file: $line"
                    ;;
            esac
        done < "$file"
    fi

    [[ -n "$path" ]] || die "Project config has no path: $file"
    profile="${profile:-generic}"
    clojure_mcp="${clojure_mcp:-auto}"
    validate_profile "$profile"
    validate_clojure_mcp_setting "$clojure_mcp"

    CONFIG_PATH="$path"
    CONFIG_PROFILE="$profile"
    CONFIG_CLOJURE_MCP="$clojure_mcp"
}

write_project_config() {
    local name="$1"
    local path="$2"
    local profile="$3"
    local clojure_mcp="$4"
    local file="$PROJECTS_DIR/$name"
    local tmp="$file.tmp.$$"

    validate_project_name "$name"
    validate_profile "$profile"
    validate_clojure_mcp_setting "$clojure_mcp"

    {
        printf 'path=%s\n' "$path"
        printf 'profile=%s\n' "$profile"
        printf 'clojure_mcp=%s\n' "$clojure_mcp"
    } > "$tmp"

    mv -- "$tmp" "$file"
}

find_name_for_path() {
    local root="$1"
    local matched=""
    local file

    shopt -s nullglob
    for file in "$PROJECTS_DIR"/*; do
        [[ -f "$file" ]] || continue
        read_project_config "$file"

        if [[ "$CONFIG_PATH" == "$root" ]]; then
            [[ -z "$matched" ]] ||
                die "Repository $root is registered under multiple project names"
            matched="$(basename "$file")"
        fi
    done

    printf '%s\n' "$matched"
}

project_uses_clojure() {
    local root="$1"
    local marker source_file

    for marker in deps.edn project.clj bb.edn shadow-cljs.edn build.boot; do
        [[ -f "$root/$marker" ]] && return 0
    done

    # Include untracked, non-ignored source so a newly created Clojure project
    # is detected before its first commit without crawling ignored build trees.
    while IFS= read -r -d '' source_file; do
        [[ -n "$source_file" ]] && return 0
    done < <(
        git -C "$root" ls-files -z --cached --others --exclude-standard -- \
            '*.clj' '*.cljc' '*.cljs'
    )

    return 1
}

EFFECTIVE_CLOJURE_LSP_MCP=0
EFFECTIVE_CLOJURE_LSP_MCP_REASON=""

resolve_clojure_mcp() {
    local root="$1"
    local project_setting="$2"
    local setting="$project_setting"
    local source="project setting"

    if [[ -n "$CLOJURE_LSP_MCP_OVERRIDE" ]]; then
        setting="$(normalize_clojure_mcp_setting "$CLOJURE_LSP_MCP_OVERRIDE")" ||
            die "Invalid CODEX_CLOJURE_LSP_MCP: $CLOJURE_LSP_MCP_OVERRIDE"
        source="environment override"
    fi

    case "$setting" in
        on)
            EFFECTIVE_CLOJURE_LSP_MCP=1
            EFFECTIVE_CLOJURE_LSP_MCP_REASON="$source: on"
            ;;
        off)
            EFFECTIVE_CLOJURE_LSP_MCP=0
            EFFECTIVE_CLOJURE_LSP_MCP_REASON="$source: off"
            ;;
        auto)
            if project_uses_clojure "$root"; then
                EFFECTIVE_CLOJURE_LSP_MCP=1
                EFFECTIVE_CLOJURE_LSP_MCP_REASON="auto-detected Clojure project"
            else
                EFFECTIVE_CLOJURE_LSP_MCP=0
                EFFECTIVE_CLOJURE_LSP_MCP_REASON="no Clojure project signals detected"
            fi
            ;;
    esac
}

init_project() {
    local profile="$DEFAULT_PROFILE"
    local profile_explicit=false
    local clojure_mcp="auto"
    local clojure_mcp_explicit=false
    local positional=()

    while (($#)); do
        case "$1" in
            --profile)
                (($# >= 2)) || die "--profile requires generic or cuda"
                profile="$2"
                profile_explicit=true
                shift 2
                ;;
            --profile=*)
                profile="${1#--profile=}"
                profile_explicit=true
                shift
                ;;
            --clojure-mcp)
                (($# >= 2)) || die "--clojure-mcp requires auto, on, or off"
                clojure_mcp="$2"
                clojure_mcp_explicit=true
                shift 2
                ;;
            --clojure-mcp=*)
                clojure_mcp="${1#--clojure-mcp=}"
                clojure_mcp_explicit=true
                shift
                ;;
            --)
                shift
                positional+=("$@")
                break
                ;;
            -* )
                die "Unknown --init option: $1"
                ;;
            *)
                positional+=("$1")
                shift
                ;;
        esac
    done

    validate_profile "$profile"
    validate_clojure_mcp_setting "$clojure_mcp"
    ((${#positional[@]} <= 2)) ||
        die "Usage: run-codex --init [--profile generic|cuda] [--clojure-mcp auto|on|off] [PROJECT [PATH]]"

    local requested_name="${positional[0]:-}"
    local requested_path="${positional[1]:-$PWD}"
    local path root name file

    need git
    need realpath
    mkdir -p "$PROJECTS_DIR"

    path="$(canonical_dir "$requested_path")" ||
        die "Directory does not exist: $requested_path"

    root="$(git_root_for "$path")" ||
        die "$path is not inside a Git repository"

    check_supported_repo "$root"

    name="${requested_name:-$(basename "$root")}"
    validate_project_name "$name"
    file="$PROJECTS_DIR/$name"

    if [[ -f "$file" ]]; then
        read_project_config "$file"

        if [[ "$CONFIG_PATH" == "$root" ]]; then
            if { ! $profile_explicit || [[ "$CONFIG_PROFILE" == "$profile" ]]; } &&
               { ! $clojure_mcp_explicit || [[ "$CONFIG_CLOJURE_MCP" == "$clojure_mcp" ]]; }; then
                echo "Project '$name' is already initialized:"
                echo "  path:    $root"
                echo "  profile: $CONFIG_PROFILE"
                echo "  Clojure MCP: $CONFIG_CLOJURE_MCP"
                return 0
            fi

            echo "Project '$name' already exists with:" >&2
            echo "  profile:     $CONFIG_PROFILE" >&2
            echo "  Clojure MCP: $CONFIG_CLOJURE_MCP" >&2
            if $profile_explicit && [[ "$CONFIG_PROFILE" != "$profile" ]]; then
                echo "Change its profile with:" >&2
                echo "  run-codex --set-profile '$name' '$profile'" >&2
            fi
            if $clojure_mcp_explicit && [[ "$CONFIG_CLOJURE_MCP" != "$clojure_mcp" ]]; then
                echo "Change its Clojure MCP setting with:" >&2
                echo "  run-codex --set-clojure-mcp '$name' '$clojure_mcp'" >&2
            fi
            exit 1
        fi

        echo "Project '$name' is already registered as:" >&2
        echo "  $CONFIG_PATH" >&2
        echo >&2
        echo "To intentionally change its local checkout path:" >&2
        echo "  run-codex --rebind '$name' '$root'" >&2
        exit 1
    fi

    local other
    other="$(find_name_for_path "$root")"
    [[ -z "$other" ]] || die "$root is already registered as project '$other'"

    write_project_config "$name" "$root" "$profile" "$clojure_mcp"

    echo "Initialized project '$name':"
    echo "  path:        $root"
    echo "  profile:     $profile"
    echo "  Clojure MCP: $clojure_mcp"
    echo "  image:       $(profile_image "$profile")"
    echo "  container:   $WORKSPACE_ROOT/$name"
}

rebind_project() {
    local name="$1"
    local requested_path="${2:-$PWD}"
    local file="$PROJECTS_DIR/$name"
    local path root other profile clojure_mcp

    validate_project_name "$name"
    [[ -f "$file" ]] || die "Project '$name' is not registered. Use --init instead."

    need git
    need realpath

    read_project_config "$file"
    profile="$CONFIG_PROFILE"
    clojure_mcp="$CONFIG_CLOJURE_MCP"

    path="$(canonical_dir "$requested_path")" ||
        die "Directory does not exist: $requested_path"

    root="$(git_root_for "$path")" ||
        die "$path is not inside a Git repository"

    check_supported_repo "$root"

    other="$(find_name_for_path "$root")"
    if [[ -n "$other" && "$other" != "$name" ]]; then
        die "$root is already registered as project '$other'"
    fi

    write_project_config "$name" "$root" "$profile" "$clojure_mcp"

    echo "Rebound project '$name':"
    echo "  path:        $root"
    echo "  profile:     $profile"
    echo "  Clojure MCP: $clojure_mcp"
}

set_profile() {
    local name="$1"
    local profile="$2"
    local file="$PROJECTS_DIR/$name"

    validate_project_name "$name"
    validate_profile "$profile"
    [[ -f "$file" ]] || die "Project '$name' is not registered"

    read_project_config "$file"
    write_project_config "$name" "$CONFIG_PATH" "$profile" "$CONFIG_CLOJURE_MCP"

    echo "Project '$name' now uses profile '$profile':"
    echo "  $(profile_image "$profile")"
}

set_clojure_mcp() {
    local name="$1"
    local clojure_mcp="$2"
    local file="$PROJECTS_DIR/$name"

    validate_project_name "$name"
    validate_clojure_mcp_setting "$clojure_mcp"
    [[ -f "$file" ]] || die "Project '$name' is not registered"

    read_project_config "$file"
    write_project_config "$name" "$CONFIG_PATH" "$CONFIG_PROFILE" "$clojure_mcp"

    echo "Project '$name' now uses Clojure MCP setting '$clojure_mcp'."
}

list_projects() {
    mkdir -p "$PROJECTS_DIR"

    printf '%-20s %-10s %-12s %-10s %s\n' \
        "PROJECT" "PROFILE" "CLOJURE-MCP" "STATUS" "PATH"

    shopt -s nullglob
    local files=("$PROJECTS_DIR"/*)

    if ((${#files[@]} == 0)); then
        echo "(no projects configured)"
        return 0
    fi

    local file name path profile clojure_mcp status actual_root

    for file in "${files[@]}"; do
        [[ -f "$file" ]] || continue
        name="$(basename "$file")"
        read_project_config "$file"
        path="$CONFIG_PATH"
        profile="$CONFIG_PROFILE"
        clojure_mcp="$CONFIG_CLOJURE_MCP"

        if [[ ! -d "$path" ]]; then
            status="MISSING"
        elif actual_root="$(git_root_for "$path")" && [[ "$actual_root" == "$path" ]]; then
            status="OK"
        else
            status="NOT-GIT"
        fi

        printf '%-20s %-10s %-12s %-10s %s\n' \
            "$name" "$profile" "$clojure_mcp" "$status" "$path"
    done
}

print_missing_project_help() {
    local name="$1"
    local cwd_root=""

    echo "ERROR: Project '$name' is not initialized on this machine." >&2
    echo >&2

    if cwd_root="$(git_root_for "$PWD" 2>/dev/null)"; then
        echo "Current directory is inside:" >&2
        echo "  $cwd_root" >&2
        echo >&2
        echo "If this is project '$name', initialize it with:" >&2
        echo "  run-codex --init '$name' '$cwd_root'" >&2
        echo >&2
        echo "If it needs CUDA:" >&2
        echo "  run-codex --init --profile cuda '$name' '$cwd_root'" >&2
    else
        echo "Initialize its local checkout with:" >&2
        echo "  run-codex --init '$name' /path/to/$name" >&2
        echo >&2
        echo "For a CUDA project:" >&2
        echo "  run-codex --init --profile cuda '$name' /path/to/$name" >&2
    fi

    exit 1
}

RESOLVED_NAME=""
RESOLVED_PATH=""
RESOLVED_PROFILE=""
RESOLVED_CLOJURE_MCP=""

resolve_project() {
    local requested_name="${1:-}"
    local file root current_root name

    if [[ -n "$requested_name" ]]; then
        validate_project_name "$requested_name"
        file="$PROJECTS_DIR/$requested_name"
        [[ -f "$file" ]] || print_missing_project_help "$requested_name"

        read_project_config "$file"

        if [[ ! -d "$CONFIG_PATH" ]]; then
            echo "ERROR: Project '$requested_name' path does not exist:" >&2
            echo "  $CONFIG_PATH" >&2
            echo >&2
            echo "If the checkout moved, run:" >&2
            echo "  run-codex --rebind '$requested_name' /new/path/to/$requested_name" >&2
            exit 1
        fi

        root="$(git_root_for "$CONFIG_PATH")" ||
            die "Registered path for '$requested_name' is no longer a Git repository: $CONFIG_PATH"

        [[ "$root" == "$CONFIG_PATH" ]] ||
            die "Registered path for '$requested_name' is not its Git repository root: $CONFIG_PATH"

        check_supported_repo "$root"

        RESOLVED_NAME="$requested_name"
        RESOLVED_PATH="$root"
        RESOLVED_PROFILE="$CONFIG_PROFILE"
        RESOLVED_CLOJURE_MCP="$CONFIG_CLOJURE_MCP"
        return 0
    fi

    current_root="$(git_root_for "$PWD")" || {
        echo "ERROR: Current directory is not inside a Git repository." >&2
        echo >&2
        echo "Run a configured project explicitly:" >&2
        echo "  run-codex PROJECT" >&2
        echo >&2
        echo "or initialize the current Git project:" >&2
        echo "  run-codex --init" >&2
        exit 1
    }

    check_supported_repo "$current_root"
    name="$(find_name_for_path "$current_root")"

    if [[ -z "$name" ]]; then
        local suggested_name
        suggested_name="$(basename "$current_root")"
        validate_project_name "$suggested_name"

        echo "ERROR: This Git project is not initialized for run-codex:" >&2
        echo "  $current_root" >&2
        echo >&2
        echo "Initialize it (generic image) with:" >&2
        echo "  run-codex --init '$suggested_name' '$current_root'" >&2
        echo >&2
        echo "or, if it needs CUDA:" >&2
        echo "  run-codex --init --profile cuda '$suggested_name' '$current_root'" >&2
        exit 1
    fi

    read_project_config "$PROJECTS_DIR/$name"

    RESOLVED_NAME="$name"
    RESOLVED_PATH="$current_root"
    RESOLVED_PROFILE="$CONFIG_PROFILE"
    RESOLVED_CLOJURE_MCP="$CONFIG_CLOJURE_MCP"
}

run_sandbox_probe() {
    local image="$1"

    # Exercise the actual host kernel, Docker seccomp policy, AppArmor
    # transition, image Bubblewrap binary, and non-root identity together. The
    # probe has no network, host mounts, or writable image root; only disposable
    # tmpfs runtime storage is writable.
    docker run --rm --pull=never \
        --network none \
        --read-only \
        --tmpfs "$TMP_TMPFS_SPEC" \
        --cap-drop=ALL \
        --security-opt=no-new-privileges \
        --security-opt "apparmor=$APPARMOR_PROFILE" \
        --security-opt "seccomp=$SECCOMP_PROFILE" \
        --user "$HOST_UID:$HOST_GID" \
        --entrypoint /bin/sh \
        "$image" \
        -c 'exec /usr/bin/bwrap "$@"' \
        codex-sandbox-probe \
        --unshare-user \
        --unshare-ipc \
        --unshare-pid \
        --unshare-net \
        --unshare-uts \
        --unshare-cgroup-try \
        --die-with-parent \
        --new-session \
        --ro-bind / / \
        --dev /dev \
        --tmpfs /proc \
        --tmpfs /tmp \
        /bin/true
}

DOCTOR_FAILURES=0
DOCTOR_WARNINGS=0

doctor_pass() {
    printf 'PASS  %s\n' "$*"
}

doctor_warn() {
    printf 'WARN  %s\n' "$*"
    ((DOCTOR_WARNINGS += 1))
}

doctor_fail() {
    printf 'FAIL  %s\n' "$*"
    ((DOCTOR_FAILURES += 1))
}

doctor_skip() {
    printf 'SKIP  %s\n' "$*"
}

doctor_note() {
    printf '      %s\n' "$*"
}

doctor_runtime_probe() {
    local image="$1"
    local profile="$2"
    local docker_args=(
        run
        --rm
        --pull=never
        --network none
        --cap-drop=ALL
        --security-opt=no-new-privileges
        --security-opt "apparmor=$APPARMOR_PROFILE"
        --security-opt "seccomp=$SECCOMP_PROFILE"
        --read-only
        --tmpfs "$HOME_TMPFS_SPEC"
        --tmpfs "$TMP_TMPFS_SPEC"
        --tmpfs "$DOCTOR_WORKSPACE_TMPFS_SPEC"
        --user "$HOST_UID:$HOST_GID"
        -e "HOME=$CONTAINER_HOME"
        -e "CODEX_UNIVERSAL_WORKFLOW=1"
        --entrypoint /usr/local/bin/codex-entrypoint
    )

    if [[ "$profile" == cuda ]]; then
        docker_args+=(--gpus all)
    fi

    docker_args+=("$image")

    # Writable runtime data is confined to disposable tmpfs mounts. There are
    # no host mounts, so the project and persistent Codex state stay untouched.
    docker "${docker_args[@]}" /bin/bash -c '
        set -Eeuo pipefail

        [[ "$(id -u)" == "$1" ]]
        [[ "$(id -g)" == "$2" ]]
        [[ "$(id -un)" == codex ]]
        [[ "$(id -gn)" == codex ]]
        [[ -z "${LD_PRELOAD:-}" ]]
        [[ -z "${NSS_WRAPPER_PASSWD:-}" ]]
        [[ -z "${NSS_WRAPPER_GROUP:-}" ]]
        passwd_entry="$(getent passwd "$1")"
        group_entry="$(getent group "$2")"
        [[ "$passwd_entry" == "codex:x:$1:$2:"*":$HOME:/bin/bash" ]]
        [[ "$group_entry" == "codex:x:$2:" ]]
        [[ "$(getent passwd codex)" == "$passwd_entry" ]]
        [[ "$(getent group codex)" == "$group_entry" ]]
        grep -Eq "^passwd:[[:space:]]+codex([[:space:]]|$)" /etc/nsswitch.conf
        grep -Eq "^group:[[:space:]]+codex([[:space:]]|$)" /etc/nsswitch.conf
        nss_module="$(find /usr/lib -name libnss_codex.so.2 -print -quit)"
        [[ -n "$nss_module" ]]
        [[ "$(stat -c %u:%g:%a "$nss_module")" == 0:0:644 ]]
        printf "#!/bin/sh\nexit 0\n" > "$HOME/.codex-runtime-write-probe"
        chmod 0700 "$HOME/.codex-runtime-write-probe"
        "$HOME/.codex-runtime-write-probe"
        rm "$HOME/.codex-runtime-write-probe"
        touch /tmp/codex-runtime-write-probe
        rm /tmp/codex-runtime-write-probe
        printf "#!/bin/sh\nexit 0\n" > /tmp/codex-runtime-exec-probe
        chmod 0700 /tmp/codex-runtime-exec-probe
        /tmp/codex-runtime-exec-probe
        rm /tmp/codex-runtime-exec-probe
        if touch /usr/local/bin/.codex-runtime-write-probe 2>/dev/null; then
            exit 1
        fi
        test -r /etc/codex/requirements.toml
        [[ "$(stat -c %a /etc/codex)" == 755 ]]
        [[ "$(stat -c %u /usr/local/bin/codex-entrypoint)" == 0 ]]
        grep -Fxq '\''allowed_approval_policies = ["on-request"]'\'' \
            /etc/codex/requirements.toml
        grep -Fxq '\''allowed_approvals_reviewers = ["user"]'\'' \
            /etc/codex/requirements.toml
        grep -Fxq '\''allowed_sandbox_modes = ["read-only", "workspace-write"]'\'' \
            /etc/codex/requirements.toml
        command -v codex-acp >/dev/null
        command -v codex-acp-entrypoint >/dev/null
        command -v codex-universal-workflow-install >/dev/null
        test -f /usr/local/share/codex-universal/workflow/agents/code_reader.toml
        test -f /usr/local/share/codex-universal/workflow/agents/clojure_probe.toml
        test -f /usr/local/share/codex-universal/workflow/agents/mechanical_worker.toml
        test -x /usr/local/share/codex-universal/workflow/skills/clojure-development/scripts/clojure-development
        test -f "$HOME/.codex/agents/code_reader.toml"
        test -f "$HOME/.codex/agents/clojure_probe.toml"
        test -f "$HOME/.codex/agents/mechanical_worker.toml"
        test -f "$HOME/.codex/skills/clojure-development/SKILL.md"

        printf '\''codex: '\''
        codex --version
        printf '\''agent-lsp: '\''
        agent-lsp --version
        printf '\''bb: '\''
        bb --version
        printf '\''cljfmt: '\''
        cljfmt --version
        printf '\''clj-kondo: '\''
        clj-kondo --version
        printf '\''clojure-lsp: '\''
        clojure-lsp --version
        printf '\''rlwrap: '\''
        rlwrap --version
        printf '\''bundled workflow: code_reader, clojure_probe, mechanical_worker, clojure-development\n'\''
        command -v clj >/dev/null

        if [[ "$3" == cuda ]]; then
            [[ "${CODEX_NVIDIA_ENTRYPOINT_RAN:-}" == 1 ]]
            command -v nvcc >/dev/null
            command -v nvidia-smi >/dev/null
            bwrap \
                --unshare-user \
                --ro-bind / / \
                --dev /dev \
                --proc /proc \
                --tmpfs /tmp \
                -- \
                /bin/bash -c "nvidia-smi >/dev/null"
            nvidia-smi >/dev/null
        fi
    ' run-codex-doctor "$HOST_UID" "$HOST_GID" "$profile"
}

doctor_mcp_probe() {
    local image="$1"
    local required_tools="$2"

    # Keep this separate from the tool/policy probe so a failed MCP handshake
    # has a precise diagnosis. Like the runtime probe, it has no host mounts.
    docker run --rm --pull=never \
        --network none \
        --cap-drop=ALL \
        --security-opt=no-new-privileges \
        --security-opt "apparmor=$APPARMOR_PROFILE" \
        --security-opt "seccomp=$SECCOMP_PROFILE" \
        --read-only \
        --tmpfs "$HOME_TMPFS_SPEC" \
        --tmpfs "$TMP_TMPFS_SPEC" \
        --tmpfs "$DOCTOR_WORKSPACE_TMPFS_SPEC" \
        --user "$HOST_UID:$HOST_GID" \
        -e "HOME=$CONTAINER_HOME" \
        --entrypoint /usr/local/bin/codex-entrypoint \
        "$image" /bin/bash -c '
            set -Eeuo pipefail

            coproc MCP_BRIDGE {
                exec codex-clojure-lsp-mcp clojure:clojure-lsp
            }
            mcp_pid="$MCP_BRIDGE_PID"
            mcp_input_fd="${MCP_BRIDGE[1]}"
            mcp_output_fd="${MCP_BRIDGE[0]}"
            mcp_ready=0

            printf '\''%s\n'\'' \
                '\''{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"run-codex-doctor","version":"1"}}}'\'' \
                >&"$mcp_input_fd"

            for _ in {1..10}; do
                if IFS= read -r -t 1 -u "$mcp_output_fd" mcp_line &&
                   jq -e \
                       '\''.id == 1 and .result.serverInfo.name == "agent-lsp"'\'' \
                       <<<"$mcp_line" >/dev/null 2>&1; then
                    mcp_ready=1
                    break
                fi
            done

            ((mcp_ready == 1))

            printf '\''%s\n'\'' \
                '\''{"jsonrpc":"2.0","method":"notifications/initialized","params":{}}'\'' \
                >&"$mcp_input_fd"
            printf '\''%s\n'\'' \
                '\''{"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}}'\'' \
                >&"$mcp_input_fd"

            tools_response=""
            for _ in {1..10}; do
                if IFS= read -r -t 1 -u "$mcp_output_fd" mcp_line &&
                   jq -e '\''.id == 2'\'' <<<"$mcp_line" >/dev/null 2>&1; then
                    tools_response="$mcp_line"
                    break
                fi
            done

            kill "$mcp_pid" 2>/dev/null || true
            wait "$mcp_pid" 2>/dev/null || true
            [[ -n "$tools_response" ]]
            jq -e --argjson required "$1" \
                '\''($required - [.result.tools[].name]) | length == 0'\'' \
                <<<"$tools_response" >/dev/null
        ' run-codex-doctor "$required_tools"
}

run_doctor() {
    local requested_project="${1:-}"
    local missing=()
    local command

    echo "Codex environment doctor"
    echo

    for command in git realpath docker flock; do
        if ! command -v "$command" >/dev/null 2>&1; then
            missing+=("$command")
        fi
    done

    if ((${#missing[@]})); then
        doctor_fail "Missing required host commands: ${missing[*]}"
        doctor_note "Install the listed commands, then rerun the doctor."
        echo
        printf 'Diagnostics failed: %d failure(s), %d warning(s).\n' \
            "$DOCTOR_FAILURES" "$DOCTOR_WARNINGS"
        return 1
    fi
    doctor_pass "Required host commands are available"

    if ((HOST_UID == 0 || HOST_GID == 0)); then
        doctor_fail "Host UID/GID must both be non-root ($HOST_UID:$HOST_GID)"
        doctor_note "Run Codex as a regular Docker user."
        echo
        printf 'Diagnostics failed: %d failure(s), %d warning(s).\n' \
            "$DOCTOR_FAILURES" "$DOCTOR_WARNINGS"
        return 1
    fi
    doctor_pass "Host runtime identity is non-root ($HOST_UID:$HOST_GID)"

    if ! docker info >/dev/null 2>&1; then
        doctor_fail "Docker daemon is not available"
        doctor_note "Start Docker Engine and confirm this user can run 'docker info'."
        echo
        printf 'Diagnostics failed: %d failure(s), %d warning(s).\n' \
            "$DOCTOR_FAILURES" "$DOCTOR_WARNINGS"
        return 1
    fi
    doctor_pass "Docker daemon is available"

    resolve_project "$requested_project"
    PROJECT="$RESOLVED_NAME"
    PROJECT_PATH="$RESOLVED_PATH"
    PROFILE="$RESOLVED_PROFILE"
    IMAGE="$(profile_image "$PROFILE")"
    doctor_pass "Project '$PROJECT' resolves to $PROJECT_PATH ($PROFILE)"
    resolve_clojure_mcp "$PROJECT_PATH" "$RESOLVED_CLOJURE_MCP"
    if [[ "$EFFECTIVE_CLOJURE_LSP_MCP" == 1 ]]; then
        doctor_pass "Clojure LSP MCP selected ($EFFECTIVE_CLOJURE_LSP_MCP_REASON)"
    else
        doctor_skip "Clojure LSP MCP not selected ($EFFECTIVE_CLOJURE_LSP_MCP_REASON)"
    fi

    if [[ ! "$APPARMOR_PROFILE" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]; then
        doctor_fail "Invalid CODEX_APPARMOR_PROFILE: $APPARMOR_PROFILE"
    elif [[ ! -f "$SECCOMP_PROFILE" || ! -r "$SECCOMP_PROFILE" ]]; then
        doctor_fail "Host sandbox policy is not readable: $SECCOMP_PROFILE"
        doctor_note "Run bin/setup-codex-host-security from the codex-universal checkout."
    else
        SECCOMP_PROFILE="$(realpath -e -- "$SECCOMP_PROFILE")"
        doctor_pass "Host sandbox policy is readable"
    fi

    if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
        doctor_fail "Required local image is unavailable: $IMAGE"
        doctor_note "Build it with './docker-build.sh $PROFILE' or select an existing CODEX_IMAGE_TAG."
    else
        local image_id image_user image_version image_revision
        image_id="$(docker image inspect --format '{{.Id}}' "$IMAGE")"
        image_user="$(docker image inspect --format '{{.Config.User}}' "$IMAGE")"
        image_version="$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.version"}}' "$IMAGE")"
        image_revision="$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$IMAGE")"

        doctor_pass "Local image is available: $IMAGE"
        printf '      image id: %s\n' "${image_id:-unknown}"
        printf '      version:  %s\n' "${image_version:-unknown}"
        printf '      revision: %s\n' "${image_revision:-unknown}"

        if [[ "$image_user" =~ ^[1-9][0-9]*:[1-9][0-9]*$ ]]; then
            doctor_pass "Image declares a fixed non-root user ($image_user)"
        else
            doctor_fail "Image must declare an explicit non-root numeric user: '$image_user'"
            doctor_note "Select a portable codex-universal image with a fixed non-root USER."
        fi

        if ((DOCTOR_FAILURES == 0)); then
            local probe_output=""
            if probe_output="$(run_sandbox_probe "$IMAGE" 2>&1)"; then
                doctor_pass "AppArmor, seccomp, and Bubblewrap sandbox probe"
            else
                doctor_fail "AppArmor, seccomp, or Bubblewrap sandbox probe failed"
                [[ -z "$probe_output" ]] || printf '      %s\n' "$probe_output"
                doctor_note "Reinstall the host policy, then rerun the doctor."
            fi

            local runtime_output=""
            if runtime_output="$(doctor_runtime_probe "$IMAGE" "$PROFILE" 2>&1)"; then
                doctor_pass "Portable runtime identity, read-only image, tools, and managed Codex policy"
                while IFS= read -r line; do
                    [[ -z "$line" ]] || printf '      %s\n' "$line"
                done <<<"$runtime_output"
            else
                doctor_fail "Portable runtime, image boundary, tools, policy, or CUDA probe failed"
                [[ -z "$runtime_output" ]] || printf '      %s\n' "$runtime_output"
                doctor_note "Rebuild or replace the selected image, then rerun the doctor."
            fi

            if [[ "$EFFECTIVE_CLOJURE_LSP_MCP" == 1 ]]; then
                local mcp_output=""
                if mcp_output="$(doctor_mcp_probe "$IMAGE" "$CLOJURE_LSP_MCP_ALLOWED_TOOLS" 2>&1)"; then
                    doctor_pass "Clojure LSP MCP handshake and tool allowlist"
                else
                    doctor_fail "Clojure LSP MCP handshake or tool allowlist failed"
                    [[ -z "$mcp_output" ]] || printf '      %s\n' "$mcp_output"
                    doctor_note "Rebuild or replace the selected image, then rerun the doctor."
                fi
            else
                doctor_skip "Clojure LSP MCP handshake ($EFFECTIVE_CLOJURE_LSP_MCP_REASON)"
            fi
        else
            doctor_skip "Runtime probes because an earlier required check failed"
        fi
    fi

    local optional_missing=()
    for command in jq socat setpriv; do
        if ! command -v "$command" >/dev/null 2>&1; then
            optional_missing+=("$command")
        fi
    done
    if ((${#optional_missing[@]})); then
        doctor_warn "Optional IntelliJ host commands missing: ${optional_missing[*]}"
        doctor_note "Install jq, socat, and util-linux (setpriv) before using IDEA integration."
    else
        doctor_pass "Optional IntelliJ host commands are available"
    fi

    echo
    if ((DOCTOR_FAILURES)); then
        printf 'Diagnostics failed: %d failure(s), %d warning(s).\n' \
            "$DOCTOR_FAILURES" "$DOCTOR_WARNINGS"
        return 1
    fi

    printf 'Diagnostics passed with %d warning(s).\n' "$DOCTOR_WARNINGS"
}

NEW_SESSION=false
IDEA_MODE=false
DOCTOR_MODE=false
PROJECT=""

case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
    --list)
        (($# == 1)) || die "--list takes no arguments"
        need git
        need realpath
        list_projects
        exit 0
        ;;
    --init)
        shift
        init_project "$@"
        exit 0
        ;;
    --rebind)
        shift
        (($# >= 1 && $# <= 2)) || die "Usage: run-codex --rebind PROJECT [PATH]"
        rebind_project "$1" "${2:-$PWD}"
        exit 0
        ;;
    --set-profile)
        shift
        (($# == 2)) || die "Usage: run-codex --set-profile PROJECT generic|cuda"
        set_profile "$1" "$2"
        exit 0
        ;;
    --set-clojure-mcp)
        shift
        (($# == 2)) || die "Usage: run-codex --set-clojure-mcp PROJECT auto|on|off"
        set_clojure_mcp "$1" "$2"
        exit 0
        ;;
    --doctor)
        DOCTOR_MODE=true
        shift
        (($# <= 1)) || die "Usage: run-codex --doctor [PROJECT]"
        PROJECT="${1:-}"
        ;;
    --idea)
        IDEA_MODE=true
        shift
        (($# == 1)) || die "Usage: run-codex --idea PROJECT"
        PROJECT="$1"
        ;;
    *)
        parse_launch_args "$@"
        ;;
esac

if $DOCTOR_MODE; then
    run_doctor "$PROJECT"
    exit $?
fi

((HOST_UID > 0 && HOST_GID > 0)) ||
    die "Run this command as a non-root user with a non-root primary group"

if $IDEA_MODE; then
    need jq
    if [[ "$IDEA_MCP" == 1 ]]; then
        need socat
        need setpriv
        [[ "$IDEA_MCP_PORT" =~ ^[0-9]{1,5}$ ]] &&
            ((10#$IDEA_MCP_PORT >= 1024 && 10#$IDEA_MCP_PORT <= 65535)) ||
            die "CODEX_IDEA_MCP_PORT must be an unprivileged TCP port (1024-65535)"
        IDEA_MCP_PORT="$((10#$IDEA_MCP_PORT))"
        [[ "$IDEA_MCP_PATH" =~ ^/[A-Za-z0-9._~/-]+$ ]] ||
            die "CODEX_IDEA_MCP_PATH must be an absolute URL path"
    fi
fi

# Resolve first so an unconfigured project gets useful setup instructions even
# on a new machine whose Docker setup is not complete yet.
need git
need realpath
resolve_project "$PROJECT"

PROJECT="$RESOLVED_NAME"
PROJECT_PATH="$RESOLVED_PATH"
PROFILE="$RESOLVED_PROFILE"
IMAGE="$(profile_image "$PROFILE")"
resolve_clojure_mcp "$PROJECT_PATH" "$RESOLVED_CLOJURE_MCP"
resolve_codex_image_options "$WORKSPACE_ROOT/$PROJECT"

# Git identity is resolved on the host and exposed as container-local Git
# configuration. This preserves normal per-repository/global Git identity
# selection without mounting the host ~/.gitconfig, which may contain
# host-specific includes, credential helpers, signing configuration, or paths
# that do not exist inside the container. CODEX_GIT_USER_NAME and
# CODEX_GIT_USER_EMAIL can override it.
GIT_USER_NAME="${CODEX_GIT_USER_NAME:-$(git -C "$PROJECT_PATH" config --get user.name 2>/dev/null || true)}"
GIT_USER_EMAIL="${CODEX_GIT_USER_EMAIL:-$(git -C "$PROJECT_PATH" config --get user.email 2>/dev/null || true)}"

if [[ -z "$GIT_USER_NAME" || -z "$GIT_USER_EMAIL" ]]; then
    echo "WARNING: Git commit identity is not fully configured." >&2
    echo "  Set user.name and user.email in Git on the host, or export:" >&2
    echo "    CODEX_GIT_USER_NAME='Your Name'" >&2
    echo "    CODEX_GIT_USER_EMAIL='you@example.com'" >&2
    echo >&2
fi

need docker
need flock

docker info >/dev/null 2>&1 || die "Docker daemon is not available"

[[ "$APPARMOR_PROFILE" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] ||
    die "Invalid CODEX_APPARMOR_PROFILE: $APPARMOR_PROFILE"
[[ -f "$SECCOMP_PROFILE" && -r "$SECCOMP_PROFILE" ]] || {
    echo "ERROR: Codex host sandbox policy is not installed:" >&2
    echo "  $SECCOMP_PROFILE" >&2
    echo >&2
    echo "From the codex-universal checkout, run:" >&2
    echo "  bin/setup-codex-host-security" >&2
    exit 1
}
SECCOMP_PROFILE="$(realpath -e -- "$SECCOMP_PROFILE")"

docker image inspect "$IMAGE" >/dev/null 2>&1 || {
    echo "ERROR: Required image is not available locally:" >&2
    echo "  $IMAGE" >&2
    echo >&2
    echo "Build it from the codex-universal Docker source directory with:" >&2
    echo "  ./docker-build.sh '$PROFILE'" >&2
    exit 1
}

if ! sandbox_probe_output="$(run_sandbox_probe "$IMAGE" 2>&1)"; then
    [[ -z "$sandbox_probe_output" ]] || printf '%s\n' "$sandbox_probe_output" >&2
    echo "ERROR: Bubblewrap cannot start with the installed host sandbox policy." >&2
    echo "Re-run bin/setup-codex-host-security from the codex-universal checkout." >&2
    exit 1
fi

mkdir -p "$HOME/.codex" "$HOME/.m2" "$(dirname "$LOCK_FILE")" "$CONFIG_ROOT/runtime"

CONTAINER_BASE_NAME="codex-$PROJECT"
CONTAINER_NAME="$CONTAINER_BASE_NAME"
CONTAINER_PROJECT="$WORKSPACE_ROOT/$PROJECT"

if $IDEA_MODE; then
    # IDEA sends the host project path in ACP session requests. Mounting the
    # checkout at that same absolute path lets Codex and IDEA agree on file
    # references without granting access to the host path's parent directory.
    # Do not allow a registered checkout to mask container runtime paths.
    case "$PROJECT_PATH" in
        /|/bin|/bin/*|/dev|/dev/*|/etc|/etc/*|/lib|/lib/*|/lib64|/lib64/*|\
        /opt|/opt/*|/proc|/proc/*|/run|/run/*|/sbin|/sbin/*|/sys|/sys/*|\
        /usr|/usr/*|/var|/var/*)
            die "IDEA mode cannot mount a project over a container system path: $PROJECT_PATH"
            ;;
    esac
    if [[ "$CONTAINER_HOME" == "$PROJECT_PATH" ||
          "$CONTAINER_HOME" == "$PROJECT_PATH/"* ]]; then
        die "IDEA mode cannot mount a project over the container home: $PROJECT_PATH"
    fi
    for state_path in "$CONTAINER_HOME/.codex" "$CONTAINER_HOME/.m2"; do
        if [[ "$state_path" == "$PROJECT_PATH" ||
              "$state_path" == "$PROJECT_PATH/"* ||
              "$PROJECT_PATH" == "$state_path/"* ]]; then
            die "IDEA mode project path overlaps container state '$state_path': $PROJECT_PATH"
        fi
    done
    CONTAINER_PROJECT="$PROJECT_PATH"
fi

running_project_containers="$(
    docker ps \
        --filter "label=codex-universal.project=$PROJECT" \
        --format '{{.Names}}'
)"

if $IDEA_MODE; then
    running_terminal="$(
        docker ps \
            --filter "label=codex-universal.project=$PROJECT" \
            --filter 'label=codex-universal.mode=terminal' \
            --format '{{.Names}}'
    )"
    [[ -z "$running_terminal" ]] ||
        die "Terminal container '$running_terminal' is already using project '$PROJECT'"

    # A container with the old deterministic name may be an IDEA session from
    # the immediately preceding launcher version. Allow it only when its label
    # proves that it is an IDEA-owned instance; an unlabeled container may be
    # a terminal session and must not be interrupted.
    if docker ps --format '{{.Names}}' | grep -Fxq "$CONTAINER_BASE_NAME"; then
        existing_mode="$(
            docker inspect \
                --format '{{index .Config.Labels "codex-universal.mode"}}' \
                "$CONTAINER_BASE_NAME" 2>/dev/null || true
        )"
        [[ "$existing_mode" == idea ]] ||
            die "Container '$CONTAINER_BASE_NAME' is already running"
    fi
else
    if [[ -n "$running_project_containers" ]] ||
       docker ps --format '{{.Names}}' | grep -Fxq "$CONTAINER_BASE_NAME"; then
        die "Project '$PROJECT' already has a running Codex container"
    fi
fi

# Shared lock: multiple Codex projects may run simultaneously, while
# codex-push/codex-pull take this same lock exclusively.
exec 9>"$LOCK_FILE"
flock -s 9

# Multiple IDEA chats for one project may run concurrently. A terminal session
# remains mutually exclusive with all IDEA chats for that project.
exec 8>"$CONFIG_ROOT/runtime/$PROJECT.lock"
if $IDEA_MODE; then
    flock -sn 8 || die "A terminal Codex session is already using project '$PROJECT'"
else
    flock -xn 8 || die "An IDEA Codex session is already using project '$PROJECT'"
fi

docker_args=(
    run
    --rm
    --init
    --read-only
    --tmpfs "$HOME_TMPFS_SPEC"
    --tmpfs "$TMP_TMPFS_SPEC"
    --cap-drop=ALL
    --security-opt=no-new-privileges
    --security-opt "apparmor=$APPARMOR_PROFILE"
    --security-opt "seccomp=$SECCOMP_PROFILE"
    --entrypoint /usr/local/bin/codex-entrypoint
)

if $IDEA_MODE; then
    # IDEA may terminate its ACP subprocess without giving the attached Docker
    # client enough time to stop the container. Keep this launcher process
    # around, record the exact container ID created by this invocation, and
    # remove only that container when the ACP process exits or is signaled.
    # Keep the path short enough for the platform Unix-socket length limit.
    # mktemp creates this directory mode 0700, so no other host user can
    # connect to the unauthenticated loopback MCP service through the relay.
    IDEA_RUNTIME_DIR="$(mktemp -d -- /tmp/codex-idea-mcp.XXXXXX)"
    IDEA_CID_FILE="$IDEA_RUNTIME_DIR/container.cid"
    IDEA_MCP_RELAY_SOCKET="$IDEA_RUNTIME_DIR/idea-mcp.sock"
    IDEA_MCP_RELAY_LOG="$IDEA_RUNTIME_DIR/idea-mcp-relay.log"
    IDEA_MCP_RELAY_PID=""
    IDEA_INSTANCE="${IDEA_RUNTIME_DIR##*.}"
    CONTAINER_NAME="$CONTAINER_BASE_NAME-idea-$IDEA_INSTANCE"

    cleanup_idea_container() {
        local status=$?
        local container_id=""
        local job_pid=""
        local relay_is_our_job=false

        trap - EXIT HUP INT TERM
        if [[ "$IDEA_MCP_RELAY_PID" =~ ^[0-9]+$ ]]; then
            # Only signal a process Bash still tracks as our background job;
            # never risk acting on a PID that exited and was later reused.
            for job_pid in $(jobs -pr); do
                if [[ "$job_pid" == "$IDEA_MCP_RELAY_PID" ]]; then
                    relay_is_our_job=true
                    break
                fi
            done
            if $relay_is_our_job; then
                kill "$IDEA_MCP_RELAY_PID" >/dev/null 2>&1 || true
            fi
            wait "$IDEA_MCP_RELAY_PID" 2>/dev/null || true
        fi
        if [[ -s "$IDEA_CID_FILE" && ! -L "$IDEA_CID_FILE" ]]; then
            container_id="$(<"$IDEA_CID_FILE")"
            if [[ "$container_id" =~ ^[0-9a-f]{64}$ ]]; then
                docker rm -f -- "$container_id" >/dev/null 2>&1 || true
            fi
        fi
        rm -f -- \
            "$IDEA_CID_FILE" \
            "$IDEA_MCP_RELAY_SOCKET" \
            "$IDEA_MCP_RELAY_LOG"
        rmdir -- "$IDEA_RUNTIME_DIR" 2>/dev/null || true
        return "$status"
    }

    trap cleanup_idea_container EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    if [[ "$IDEA_MCP" == 1 &&
          "${CODEX_TEST_SKIP_IDEA_MCP_RELAY:-0}" != 1 ]]; then
        # IDEA deliberately listens on host loopback. Bridge only that one TCP
        # port into a private per-chat Unix socket; do not publish a host port
        # or give the Codex container the host network namespace.
        RUN_CODEX_SELF="$(realpath -e -- "${BASH_SOURCE[0]}")"
        # The guard gets a parent-death signal even if IDEA kills this launcher
        # with SIGKILL. Closing the lock descriptors here prevents the relay or
        # guard from making a finished chat look permanently active.
        IDEA_LAUNCHER_PID="$BASHPID"
        setpriv --pdeathsig TERM -- \
            "$RUN_CODEX_SELF" --internal-idea-relay-guard \
            "$IDEA_LAUNCHER_PID" \
            "$IDEA_RUNTIME_DIR" \
            "$IDEA_MCP_RELAY_SOCKET" \
            "$IDEA_MCP_RELAY_LOG" \
            "$IDEA_MCP_PORT" \
            "$IDEA_CID_FILE" \
            8>&- 9>&- &
        IDEA_MCP_RELAY_PID=$!

        relay_ready=false
        for _ in {1..100}; do
            if [[ -S "$IDEA_MCP_RELAY_SOCKET" ]]; then
                relay_ready=true
                break
            fi
            kill -0 "$IDEA_MCP_RELAY_PID" 2>/dev/null || break
            sleep 0.05
        done
        if ! $relay_ready; then
            [[ ! -s "$IDEA_MCP_RELAY_LOG" ]] || cat -- "$IDEA_MCP_RELAY_LOG" >&2
            die "Failed to start the host-side IntelliJ MCP relay"
        fi
    fi

    # ACP is a line-oriented stdio protocol. Allocating a TTY or printing
    # launcher diagnostics to stdout would corrupt the protocol stream.
    docker_args+=(
        -i
        --cidfile "$IDEA_CID_FILE"
        --label codex-universal.mode=idea
        --label "codex-universal.project=$PROJECT"
    )
    if [[ "$IDEA_MCP" == 1 ]]; then
        docker_args+=(
            -v "$IDEA_RUNTIME_DIR:/run/codex-idea-mcp:ro"
            -e "CODEX_IDEA_MCP_RELAY_SOCKET=/run/codex-idea-mcp/idea-mcp.sock"
            -e "CODEX_IDEA_MCP_RELAY_PORT=$IDEA_MCP_PORT"
        )
    fi
else
    docker_args+=(
        -it
        --label codex-universal.mode=terminal
        --label "codex-universal.project=$PROJECT"
    )
fi

if [[ "$PROFILE" == cuda ]]; then
    docker_args+=(--gpus all)
fi

docker_args+=(
    --user "$HOST_UID:$HOST_GID"
    -e "HOME=$CONTAINER_HOME"
    -e "CODEX_UNIVERSAL_WORKFLOW=$WORKFLOW_ENABLED"
)

if $IDEA_MODE; then
    if [[ "$IDEA_MCP" == 1 ]]; then
        IDEA_MCP_URL="http://127.0.0.1:${IDEA_MCP_PORT}${IDEA_MCP_PATH}"
        IDEA_CODEX_CONFIG="$(
            jq -cn \
                --arg url "$IDEA_MCP_URL" \
                --arg home "$CONTAINER_HOME" \
                --argjson enabled_tools "$IDEA_MCP_ALLOWED_TOOLS" \
                '{
                    sandbox_mode: "workspace-write",
                    approval_policy: "on-request",
                    approvals_reviewer: "user",
                    sandbox_workspace_write: {
                        network_access: false,
                        writable_roots: [$home]
                    },
                    network: {allow_local_binding: true},
                    mcp_optional_startup_grace_ms: 5000,
                    mcp_servers: {
                        idea: {
                            url: $url,
                            enabled: true,
                            required: false,
                            enabled_tools: $enabled_tools,
                            default_tools_approval_mode: "writes",
                            startup_timeout_sec: 30,
                            tool_timeout_sec: 120
                        }
                    }
                }'
        )"
    else
        IDEA_CODEX_CONFIG="$(
            jq -cn \
                --arg home "$CONTAINER_HOME" \
                '{
                    sandbox_mode: "workspace-write",
                    approval_policy: "on-request",
                    approvals_reviewer: "user",
                    sandbox_workspace_write: {
                        network_access: false,
                        writable_roots: [$home]
                    },
                    network: {allow_local_binding: true}
                }'
        )"
    fi

    docker_args+=(
        -e "CODEX_PATH=/usr/local/share/npm-global/bin/codex"
        # codex-acp calls this mode "read-only" internally but presents it as
        # "Ask for approval" and maps it to workspace-write/on-request with
        # approvals routed to the user. Its "agent" mode enables auto-review,
        # which is intentionally forbidden by the managed image policy.
        -e "INITIAL_AGENT_MODE=read-only"
        -e "NO_BROWSER=1"
        -e "CODEX_CONFIG=$IDEA_CODEX_CONFIG"
    )
fi

if [[ -n "$GIT_USER_NAME" && -n "$GIT_USER_EMAIL" ]]; then
    docker_args+=(
        -e "GIT_CONFIG_COUNT=2"
        -e "GIT_CONFIG_KEY_0=user.name"
        -e "GIT_CONFIG_VALUE_0=$GIT_USER_NAME"
        -e "GIT_CONFIG_KEY_1=user.email"
        -e "GIT_CONFIG_VALUE_1=$GIT_USER_EMAIL"
    )
fi

docker_args+=(
    -v "$HOME/.codex:$CONTAINER_HOME/.codex"
    -v "$HOME/.m2:$CONTAINER_HOME/.m2"
    -v "$PROJECT_PATH:$CONTAINER_PROJECT"
    -w "$CONTAINER_PROJECT"
    --name "$CONTAINER_NAME"
    "$IMAGE"
)

# Routine commands and working-tree edits run without prompts inside the
# project and container home. Codex protects .git and .codex recursively within
# writable roots, so any repository-metadata write must be elevated. Keep those
# approval requests routed to the human user, regardless of user-level config.
codex_args=(
    --sandbox workspace-write
    --ask-for-approval on-request
    -c 'approvals_reviewer="user"'
    -c "sandbox_workspace_write.network_access=false"
    -c "sandbox_workspace_write.writable_roots=[\"$CONTAINER_HOME\"]"
    # This permits only container-local listeners such as the nREPL helper;
    # external network access remains disabled above.
    -c 'network.allow_local_binding=true'
)

if ! $IDEA_MODE && [[ "$EFFECTIVE_CLOJURE_LSP_MCP" == 1 ]]; then
    codex_args+=(
        -c 'mcp_servers.clojure_lsp.command="/usr/local/bin/codex-clojure-lsp-mcp"'
        -c 'mcp_servers.clojure_lsp.args=["clojure:clojure-lsp"]'
        -c 'mcp_servers.clojure_lsp.enabled=true'
        -c 'mcp_servers.clojure_lsp.required=false'
        -c "mcp_servers.clojure_lsp.enabled_tools=$CLOJURE_LSP_MCP_ALLOWED_TOOLS"
        -c 'mcp_servers.clojure_lsp.default_tools_approval_mode="writes"'
        -c 'mcp_servers.clojure_lsp.startup_timeout_sec=30'
        -c 'mcp_servers.clojure_lsp.tool_timeout_sec=120'
    )
fi

if $IDEA_MODE; then
    echo "Starting IntelliJ ACP agent for '$PROJECT'" >&2
elif $NEW_SESSION; then
    echo "Starting new Codex session for '$PROJECT'"
else
    echo "Resuming last Codex session for '$PROJECT'"
fi

if $IDEA_MODE; then
    echo "  profile: $PROFILE" >&2
    echo "  image:   $IMAGE" >&2
    echo "  project: $PROJECT_PATH -> $CONTAINER_PROJECT" >&2
    echo "  policy:  workspace-write; human approval; no full-access mode" >&2
else
    echo "  profile: $PROFILE"
    echo "  image:   $IMAGE"
    echo "  project: $PROJECT_PATH -> $CONTAINER_PROJECT"
    if [[ "$EFFECTIVE_CLOJURE_LSP_MCP" == 1 ]]; then
        echo "  Clojure MCP: enabled ($EFFECTIVE_CLOJURE_LSP_MCP_REASON)"
    else
        echo "  Clojure MCP: disabled ($EFFECTIVE_CLOJURE_LSP_MCP_REASON)"
    fi
    echo "  policy:  workspace-write; Git metadata and network writes need your approval"
fi

# The launcher selects the portable-user entrypoint explicitly. Terminal mode
# then supplies "codex" plus its arguments; IDEA mode supplies the ACP adapter.
# The CUDA wrapper runs NVIDIA initialization before either command.
if $IDEA_MODE; then
    docker "${docker_args[@]}" /usr/local/bin/codex-acp-entrypoint
else
    session_args=(codex "${codex_args[@]}")
    if ! $NEW_SESSION; then
        session_args+=(resume --last)
    fi
    session_args+=("${CODEX_FORWARD_ARGS[@]}")
    if $CODEX_PROMPT_SET; then
        session_args+=(-- "$CODEX_INITIAL_PROMPT")
    fi
    exec docker "${docker_args[@]}" "${session_args[@]}"
fi
