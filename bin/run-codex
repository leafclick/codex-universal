SECCOMP_PROFILE="${CODEX_SECCOMP_PROFILE:-$CONFIG_ROOT/security/codex-bwrap.json}"
CLOJURE_LSP_MCP_OVERRIDE="${CODEX_CLOJURE_LSP_MCP:-}"
