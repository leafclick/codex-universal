usage() {
    cat <<'USAGE'
Usage:
  run-codex [PROJECT] [--lane LANE] [--new] [--image-version VERSION] [--codex-option OPTION]...
  run-codex --new [PROJECT] [--lane LANE] [--image-version VERSION] [--codex-option OPTION]...
  run-codex [PROJECT] [--lane LANE] --sessions
  run-codex [PROJECT] [--lane LANE] --resume QUERY [--image-version VERSION] [--codex-option OPTION]...
  run-codex PROJECT --lane LANE --review REVISION [--codex-option model=MODEL]...
  run-codex --idea
  run-codex --idea PROJECT  # compatibility/direct project launch

  run-codex --init [--lane LANE] [--profile generic|cuda] [--clojure-mcp auto|on|off] [--bootstrap-codex-home DIR] [PROJECT [PATH]]
  run-codex --rebind PROJECT [PATH] [--lane LANE]
  run-codex PROJECT --lane LANE --create REVISION
  run-codex PROJECT --lane LANE --import REVISION
  run-codex PROJECT --lane LANE --remove
  run-codex PROJECT [--lane LANE] --check
  run-codex PROJECT [--lane LANE] --onboard [--from CHECKOUT]
  run-codex PROJECT [--lane LANE] --setup
  run-codex PROJECT [--lane LANE] --push-state
  run-codex PROJECT [--lane LANE] --pull-state
  run-codex PROJECT [--lane LANE] --list-state
  run-codex PROJECT [--lane LANE] --force-state GENERATION
  run-codex PROJECT --set profile generic|cuda
  run-codex PROJECT --set clojure-mcp auto|on|off
  run-codex PROJECT --set model MODEL
  run-codex PROJECT --set reasoning minimal|low|medium|high|xhigh
  run-codex PROJECT --lane LANE --set profile generic|cuda
  run-codex PROJECT --lane LANE --set clojure-mcp auto|on|off
  run-codex PROJECT --lane LANE --set model MODEL
  run-codex PROJECT --lane LANE --set reasoning minimal|low|medium|high|xhigh
  run-codex --doctor [PROJECT]
  run-codex --list

Codex options (terminal mode, repeat --codex-option as needed):
  model=MODEL
  reasoning=minimal|low|medium|high|xhigh
  search
  no-alt-screen
  strict-config
  image=PROJECT_PATH
  prompt=TEXT

Examples:
  cd ~/src/cortex
  run-codex --init --profile cuda
  run-codex

  run-codex cortex
  run-codex cortex --new
  run-codex cortex --new --image-version 0.5.5-2-g2594e2265f3
  run-codex cortex --sessions
  run-codex cortex --resume gpu-tuning
  run-codex cortex --lane review --new --codex-option model=gpt-5.6-sol
  run-codex cortex --lane review --review origin/main --codex-option model=gpt-5.6-sol
  run-codex cortex --new --codex-option model=gpt-5.6-sol --codex-option reasoning=high
  run-codex cortex --codex-option no-alt-screen
  run-codex --idea
  run-codex --doctor cortex
  run-codex cortex --set profile generic
  run-codex cortex --set clojure-mcp auto

Environment:
  CODEX_IMAGE_SLUG=leafclick/codex-universal
  CODEX_IMAGE_PREFIX=SLUG  Compatibility alias for CODEX_IMAGE_SLUG
  CODEX_IMAGE_TAG=latest
  CODEX_DEFAULT_PROFILE=generic
  CODEX_CONTAINER_HOME=/home/codex
  CODEX_WORKSPACE_ROOT=/workspace
  CODEX_LOCK_FILE=PATH       Override scoped handoff lock (legacy default: ~/.cache/codex-handoff.lock)
  CODEX_SYNC_ROOT=~/Seafile/CodexSync
  CODEX_APPARMOR_PROFILE=codex-universal
  CODEX_SECCOMP_PROFILE=~/.config/run-codex/security/codex-bwrap.json
  CODEX_CLOJURE_LSP_MCP=VALUE  Override project setting: auto, on/off, or 1/0
  CODEX_IDEA_MCP=1         Enable the private IntelliJ HTTP relay in IDEA mode
  CODEX_IDEA_MCP_PORT=64342
  CODEX_IDEA_MCP_PATH=/stream
  CODEX_UNIVERSAL_WORKFLOW=0|1|uninstall
  CODEX_GIT_USER_NAME=NAME
  CODEX_GIT_USER_EMAIL=EMAIL
USAGE
}

die() {
    echo "ERROR: $*" >&2
    exit 1
}

validate_container_mount_path() {
    local variable="$1"
    local value="${!variable}"

    [[ "$value" == /* && "$value" != / ]] ||
        die "$variable must be an absolute non-root container path: $value"
    [[ "$value" != *:* && "$value" != *,* && "$value" != *$'\n'* ]] ||
        die "$variable contains a Docker mount delimiter: $value"
    [[ "$value" != */ && "$value" != *//* &&
       "$value" != */./* && "$value" != */../* &&
       "$value" != */. && "$value" != */.. ]] ||
        die "$variable must be lexically normalized: $value"
}

container_paths_overlap() {
    [[ "$1" == "$2" || "$1" == "$2/"* || "$2" == "$1/"* ]]
}

need() {
    command -v "$1" >/dev/null 2>&1 || die "Missing command: $1"
}

run_idea_dispatcher() {
    need jq
    need realpath
    ((HOST_UID > 0 && HOST_GID > 0)) ||
        die "Run this command as a non-root user with a non-root primary group"

    local initialize_line=""
    local initialize_id=""
    local request_line=""
    local request_method=""
    local request_cwd=""
    local backend_line=""
    local backend_pid=""
    local frontend_input_pid=""
    local backend_input_fd=""
    local backend_output_fd=""
    local coproc_input_fd=""
    local coproc_output_fd=""
    local client_input_fd=""
    local run_codex_self=""
    local status=0
    local backend_initialized=false

    IFS= read -r initialize_line ||
        die "IDEA ACP client closed before initialize"
    jq -e '
        type == "object" and .jsonrpc == "2.0" and
        .method == "initialize" and has("id") and
        (.params.protocolVersion == 1)
    ' <<<"$initialize_line" >/dev/null ||
        die "IDEA ACP dispatcher expected a protocol-version 1 initialize request"
    initialize_id="$(jq -c '.id' <<<"$initialize_line")"

    # Project selection is intentionally deferred until IDEA supplies cwd in a
    # session request. Advertise only the capabilities that this one-project
    # dispatcher can route without choosing or exposing another checkout.
    jq -cn \
        --argjson id "$initialize_id" \
        '{
            jsonrpc: "2.0",
            id: $id,
            result: {
                protocolVersion: 1,
                agentInfo: {
                    name: "codex-universal",
                    title: "Dockerized Codex",
                    version: "1"
                },
                agentCapabilities: {
                    loadSession: true,
                    promptCapabilities: {
                        embeddedContext: true,
                        image: true
                    },
                    sessionCapabilities: {
                        resume: {},
                        list: {},
                        close: {},
                        delete: {},
                        fork: {}
                    },
                    mcpCapabilities: {
                        acp: false,
                        http: true,
                        sse: false
                    }
                },
                authMethods: []
            }
        }'

    # session/new and every supported resume/load request carry an absolute
    # cwd. Do not guess from the IDE process cwd or expose all registered
    # checkouts to a placeholder container.
    while IFS= read -r request_line; do
        request_method="$(jq -er '.method | strings' <<<"$request_line" 2>/dev/null || true)"
        case "$request_method" in
            session/new|session/load|session/resume|session/list|session/fork)
                request_cwd="$(
                    jq -er '.params.cwd | strings | select(startswith("/"))' \
                        <<<"$request_line" 2>/dev/null || true
                )"
                [[ -n "$request_cwd" ]] ||
                    die "IDEA ACP $request_method request did not include an absolute cwd"
                break
                ;;
            \$/cancel_request)
                continue
                ;;
            *)
                die "IDEA ACP dispatcher cannot route '$request_method' before receiving a project cwd"
                ;;
        esac
    done
    [[ -n "$request_cwd" ]] ||
        die "IDEA ACP client closed before selecting a project"

    run_codex_self="$(realpath -e -- "${BASH_SOURCE[0]}")"
    coproc IDEA_BACKEND {
        exec "$run_codex_self" --internal-idea-backend "$request_cwd"
    }
    backend_pid="$IDEA_BACKEND_PID"
    coproc_output_fd="${IDEA_BACKEND[0]}"
    coproc_input_fd="${IDEA_BACKEND[1]}"
    exec {backend_output_fd}<&"$coproc_output_fd"
    exec {backend_input_fd}>&"$coproc_input_fd"
    # Keep only descriptors whose lifetime is managed below. Otherwise the
    # original coprocess input descriptor prevents the backend from seeing EOF.
    exec {coproc_output_fd}<&-
    exec {coproc_input_fd}>&-

    cleanup_idea_dispatcher() {
        local cleanup_status=$?
        trap - EXIT HUP INT TERM
        if [[ "$frontend_input_pid" =~ ^[0-9]+$ ]]; then
            kill "$frontend_input_pid" >/dev/null 2>&1 || true
            wait "$frontend_input_pid" 2>/dev/null || true
        fi
        if [[ "$backend_pid" =~ ^[0-9]+$ ]]; then
            kill "$backend_pid" >/dev/null 2>&1 || true
            wait "$backend_pid" 2>/dev/null || true
        fi
        exit "$cleanup_status"
    }
    trap cleanup_idea_dispatcher EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    printf '%s\n' "$initialize_line" >&"$backend_input_fd"
    while IFS= read -r backend_line <&"$backend_output_fd"; do
        if jq -e --argjson id "$initialize_id" \
            '.id == $id and (.result.protocolVersion == 1)' \
            <<<"$backend_line" >/dev/null 2>&1; then
            backend_initialized=true
            break
        fi
        printf '%s\n' "$backend_line"
    done
    $backend_initialized ||
        die "Dockerized Codex exited before completing ACP initialization"

    printf '%s\n' "$request_line" >&"$backend_input_fd"
    # Bash connects an asynchronous command's fd 0 to /dev/null when job
    # control is disabled. Preserve IDEA's protocol input on an explicit fd
    # before starting the background client-to-agent relay.
    exec {client_input_fd}<&0
    (
        while IFS= read -r request_line <&"$client_input_fd"; do
            printf '%s\n' "$request_line" >&"$backend_input_fd" || break
        done
        exec {client_input_fd}<&-
        exec {backend_input_fd}>&-
    ) &
    frontend_input_pid=$!
    exec {client_input_fd}<&-
    exec {backend_input_fd}>&-
    cat <&"$backend_output_fd"

    set +e
    wait "$backend_pid"
    status=$?
    kill "$frontend_input_pid" >/dev/null 2>&1 || true
    wait "$frontend_input_pid" 2>/dev/null
    set -e
    backend_pid=""
    frontend_input_pid=""
    trap - EXIT HUP INT TERM
    return "$status"
}

run_idea_relay_guard() {
    (($# == 6)) || die "Invalid IntelliJ relay guard invocation"

    IDEA_GUARD_LAUNCHER_PID="$1"
    IDEA_GUARD_RUNTIME_DIR="$2"
    IDEA_GUARD_RELAY_SOCKET="$3"
    IDEA_GUARD_RELAY_LOG="$4"
    IDEA_GUARD_RELAY_PORT="$5"
    IDEA_GUARD_CID_FILE="$6"
    IDEA_GUARD_RELAY_PID=""
    local runtime_owner_mode=""

    [[ "$IDEA_GUARD_LAUNCHER_PID" =~ ^[0-9]+$ ]] &&
        ((IDEA_GUARD_LAUNCHER_PID > 1)) ||
        die "Invalid IntelliJ relay guard parent PID"
    [[ "$IDEA_GUARD_RUNTIME_DIR" =~ ^/tmp/codex-idea-mcp\.[A-Za-z0-9]{6}$ ]] ||
        die "Invalid IntelliJ relay guard runtime directory"
    [[ -d "$IDEA_GUARD_RUNTIME_DIR" && ! -L "$IDEA_GUARD_RUNTIME_DIR" ]] ||
        die "Invalid IntelliJ relay guard runtime directory"
    [[ "$IDEA_GUARD_RELAY_SOCKET" == "$IDEA_GUARD_RUNTIME_DIR/idea-mcp.sock" &&
       "$IDEA_GUARD_RELAY_LOG" == "$IDEA_GUARD_RUNTIME_DIR/idea-mcp-relay.log" &&
       "$IDEA_GUARD_CID_FILE" == "$IDEA_GUARD_RUNTIME_DIR/container.cid" ]] ||
        die "Invalid IntelliJ relay guard path"
    [[ "$IDEA_GUARD_RELAY_PORT" =~ ^[0-9]+$ ]] &&
        ((10#$IDEA_GUARD_RELAY_PORT >= 1024 && 10#$IDEA_GUARD_RELAY_PORT <= 65535)) ||
        die "Invalid IntelliJ relay guard port"

    cleanup_idea_relay_guard() {
        local status=$?
        local job_pid=""
        local relay_is_our_job=false

        trap - EXIT HUP INT TERM
        if [[ "$IDEA_GUARD_RELAY_PID" =~ ^[0-9]+$ ]]; then
            # Avoid signaling a recycled PID if socat exited independently.
            for job_pid in $(jobs -pr); do
                if [[ "$job_pid" == "$IDEA_GUARD_RELAY_PID" ]]; then
                    relay_is_our_job=true
                    break
                fi
            done
            if $relay_is_our_job; then
                kill "$IDEA_GUARD_RELAY_PID" >/dev/null 2>&1 || true
            fi
            wait "$IDEA_GUARD_RELAY_PID" 2>/dev/null || true
        fi
        if [[ -s "$IDEA_GUARD_CID_FILE" && ! -L "$IDEA_GUARD_CID_FILE" ]]; then
            local container_id="$(<"$IDEA_GUARD_CID_FILE")"
            if [[ "$container_id" =~ ^[0-9a-f]{64}$ ]]; then
                docker rm -f -- "$container_id" >/dev/null 2>&1 || true
            fi
        fi
        rm -f -- \
            "$IDEA_GUARD_CID_FILE" \
            "$IDEA_GUARD_RELAY_SOCKET" \
            "$IDEA_GUARD_RELAY_LOG"
        rmdir -- "$IDEA_GUARD_RUNTIME_DIR" 2>/dev/null || true
        exit "$status"
    }

    trap cleanup_idea_relay_guard EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    # setpriv installs the parent-death signal before execing this guard. The
    # trap and explicit check close the race where the launcher exits first.
    [[ "$PPID" == "$IDEA_GUARD_LAUNCHER_PID" ]] ||
        die "IntelliJ relay launcher exited before guard startup"

    need stat
    need docker
    need socat
    runtime_owner_mode="$(stat -c '%u:%a' -- "$IDEA_GUARD_RUNTIME_DIR")"
    [[ "$runtime_owner_mode" == "$EUID:700" ]] ||
        die "Unsafe IntelliJ relay guard runtime directory permissions"

    socat \
        "UNIX-LISTEN:${IDEA_GUARD_RELAY_SOCKET},fork,mode=0600" \
        "TCP4:127.0.0.1:${IDEA_GUARD_RELAY_PORT}" \
        >"$IDEA_GUARD_RELAY_LOG" 2>&1 &
    IDEA_GUARD_RELAY_PID=$!
    wait "$IDEA_GUARD_RELAY_PID"
}

if [[ "${1:-}" == --internal-idea-relay-guard ]]; then
    shift
    run_idea_relay_guard "$@"
    exit $?
fi

case "$CLOJURE_LSP_MCP_OVERRIDE" in
    ''|auto|on|off|0|1) ;;
    *) die "CODEX_CLOJURE_LSP_MCP must be auto, on, off, 1, or 0" ;;
esac

case "$IDEA_MCP" in
    0|1) ;;
    *) die "CODEX_IDEA_MCP must be 0 or 1" ;;
esac
case "$WORKFLOW_ENABLED" in
    0|1|uninstall) ;;
    *) die "CODEX_UNIVERSAL_WORKFLOW must be 0, 1, or uninstall" ;;
esac

validate_container_mount_path CONTAINER_HOME
validate_container_mount_path WORKSPACE_ROOT
container_paths_overlap "$CONTAINER_HOME" /workspace &&
    die "CODEX_CONTAINER_HOME must not overlap the image workspace"
container_paths_overlap "$CONTAINER_HOME" "$WORKSPACE_ROOT" &&
    die "CODEX_CONTAINER_HOME and CODEX_WORKSPACE_ROOT must not overlap"
for reserved_runtime_path in \
    /tmp \
    /run/codex-idea-mcp; do
    container_paths_overlap "$CONTAINER_HOME" "$reserved_runtime_path" &&
        die "CODEX_CONTAINER_HOME overlaps reserved runtime path $reserved_runtime_path"
    container_paths_overlap "$WORKSPACE_ROOT" "$reserved_runtime_path" &&
        die "CODEX_WORKSPACE_ROOT overlaps reserved runtime path $reserved_runtime_path"
done
unset reserved_runtime_path

# Docker makes tmpfs mounts noexec by default. Native runtimes must be able to
# map libraries from both temporary locations: JavaCPP defaults to
# $HOME/.javacpp/cache, while others use java.io.tmpdir.
HOME_TMPFS_SPEC="${CONTAINER_HOME}:rw,exec,nosuid,nodev,uid=${HOST_UID},gid=${HOST_GID},mode=0700"
TMP_TMPFS_SPEC="/tmp:rw,exec,nosuid,nodev,mode=1777"
DOCTOR_WORKSPACE_TMPFS_SPEC="/workspace:rw,nosuid,nodev,uid=${HOST_UID},gid=${HOST_GID},mode=0700"

validate_project_name() {
    local name="$1"
    [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] ||
        die "Invalid project name '$name'. Use letters, digits, '.', '_' or '-'."
}

validate_lane_name() {
    local name="$1"
    [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] ||
        die "Invalid lane name '$name'. Use letters, digits, '.', '_' or '-'."
}

validate_profile() {
    case "$1" in
        generic|cuda) ;;
        *) die "Invalid profile '$1'. Supported profiles: generic, cuda" ;;
    esac
}

validate_clojure_mcp_setting() {
    case "$1" in
        auto|on|off) ;;
        *) die "Invalid Clojure MCP setting '$1'. Supported values: auto, on, off" ;;
    esac
}

validate_image_tag() {
    local tag="$1"
    [[ "$tag" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$ ]] ||
        die "Invalid image tag '$tag'"
}

normalize_clojure_mcp_setting() {
    case "$1" in
        1) printf '%s\n' on ;;
        0) printf '%s\n' off ;;
        auto|on|off) printf '%s\n' "$1" ;;
        *) return 1 ;;
    esac
}

validate_codex_model() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._:/-]*$ ]] ||
        die "Invalid Codex model '$1'"
}

validate_codex_reasoning() {
    case "$1" in
        minimal|low|medium|high|xhigh) ;;
        *) die "Invalid Codex reasoning effort '$1'. Supported values: minimal, low, medium, high, xhigh" ;;
    esac
}

CODEX_FORWARD_ARGS=()
CODEX_IMAGE_REQUESTS=()
CODEX_INITIAL_PROMPT=""
CODEX_MODEL_SET=false
CODEX_REASONING_SET=false
CODEX_SEARCH_SET=false
CODEX_NO_ALT_SCREEN_SET=false
CODEX_STRICT_CONFIG_SET=false
CODEX_PROMPT_SET=false
LANE="default"
LANE_SET=false
REVIEW_REVISION=""
REVIEW_REVISION_SET=false
ONBOARD_CHECK_MODE=false
ONBOARD_APPLY_MODE=false
ONBOARD_SOURCE=""
SETUP_SESSION=false
STATE_SYNC_MODE=""
STATE_SYNC_GENERATION=""
LANE_MANAGEMENT_MODE=""
LANE_MANAGEMENT_REVISION=""

add_codex_option() {
    local option="$1"
    local value=""

    [[ -n "$option" ]] || die "--codex-option cannot be empty"

    case "$option" in
        clojure-mcp=*)
            die "'clojure-mcp' is a project setting, not a Codex option. Use: run-codex PROJECT --set clojure-mcp auto|on|off"
            ;;
        profile=*)
            die "'profile' is a project setting, not a Codex option. Use: run-codex PROJECT --set profile generic|cuda"
            ;;
        model=*)
            value="${option#model=}"
            validate_codex_model "$value"
            ! $CODEX_MODEL_SET || die "Codex option 'model' may be specified only once"
            CODEX_MODEL_SET=true
            CODEX_FORWARD_ARGS+=(--model "$value")
            ;;
        reasoning=*)
            value="${option#reasoning=}"
            validate_codex_reasoning "$value"
            ! $CODEX_REASONING_SET ||
                die "Codex option 'reasoning' may be specified only once"
            CODEX_REASONING_SET=true
            CODEX_FORWARD_ARGS+=(-c "model_reasoning_effort=\"$value\"")
            ;;
        search)
            ! $CODEX_SEARCH_SET || die "Codex option 'search' may be specified only once"
            CODEX_SEARCH_SET=true
            CODEX_FORWARD_ARGS+=(--search)
            ;;
        no-alt-screen)
            ! $CODEX_NO_ALT_SCREEN_SET ||
                die "Codex option 'no-alt-screen' may be specified only once"
            CODEX_NO_ALT_SCREEN_SET=true
            CODEX_FORWARD_ARGS+=(--no-alt-screen)
            ;;
        strict-config)
            ! $CODEX_STRICT_CONFIG_SET ||
                die "Codex option 'strict-config' may be specified only once"
            CODEX_STRICT_CONFIG_SET=true
            CODEX_FORWARD_ARGS+=(--strict-config)
            ;;
        image=*)
            value="${option#image=}"
            [[ -n "$value" ]] || die "Codex option 'image' requires a project file path"
            CODEX_IMAGE_REQUESTS+=("$value")
            ;;
        prompt=*)
            value="${option#prompt=}"
            [[ -n "$value" ]] || die "Codex option 'prompt' cannot be empty"
            ! $CODEX_PROMPT_SET || die "Codex option 'prompt' may be specified only once"
            CODEX_PROMPT_SET=true
            CODEX_INITIAL_PROMPT="$value"
            ;;
        *)
            die "Unsupported Codex option '$option'. Supported options: model=MODEL, reasoning=EFFORT, search, no-alt-screen, strict-config, image=PATH, prompt=TEXT"
            ;;
    esac
}

resolve_codex_image_options() {
    local container_project="$1"
    local requested candidate host_image relative

    for requested in "${CODEX_IMAGE_REQUESTS[@]}"; do
        if [[ "$requested" == /* ]]; then
            candidate="$requested"
        else
            candidate="$PROJECT_PATH/$requested"
        fi

        host_image="$(realpath -e -- "$candidate")" ||
            die "Codex image file does not exist: $requested"
        [[ -f "$host_image" && -r "$host_image" ]] ||
            die "Codex image is not a readable file: $requested"
        [[ "$host_image" == "$PROJECT_PATH/"* ]] ||
            die "Codex image must resolve inside the registered project: $requested"

        relative="${host_image#"$PROJECT_PATH/"}"
        CODEX_FORWARD_ARGS+=(--image "$container_project/$relative")
    done
}

parse_launch_args() {
    while (($#)); do
        case "$1" in
            --new)
                ! $NEW_SESSION || die "--new may be specified only once"
                NEW_SESSION=true
                shift
                ;;
            --sessions)
                ! $SESSION_LIST_MODE || die "--sessions may be specified only once"
                SESSION_LIST_MODE=true
                shift
                ;;
            --resume)
                (($# >= 2)) || die "--resume requires a session name substring or UUID"
                ! $RESUME_QUERY_SET || die "--resume may be specified only once"
                RESUME_QUERY_SET=true
                RESUME_QUERY="$2"
                shift 2
                ;;
            --resume=*)
                ! $RESUME_QUERY_SET || die "--resume may be specified only once"
                RESUME_QUERY_SET=true
                RESUME_QUERY="${1#--resume=}"
                shift
                ;;
            --lane)
                (($# >= 2)) || die "--lane requires a lane name"
                ! $LANE_SET || die "--lane may be specified only once"
                LANE="$2"
                validate_lane_name "$LANE"
                LANE_SET=true
                shift 2
                ;;
            --lane=*)
                ! $LANE_SET || die "--lane may be specified only once"
                LANE="${1#--lane=}"
                validate_lane_name "$LANE"
                LANE_SET=true
                shift
                ;;
            --review)
                (($# >= 2)) || die "--review requires a Git revision"
                ! $REVIEW_REVISION_SET || die "--review may be specified only once"
                REVIEW_REVISION="$2"
                REVIEW_REVISION_SET=true
                shift 2
                ;;
            --review=*)
                ! $REVIEW_REVISION_SET || die "--review may be specified only once"
                REVIEW_REVISION="${1#--review=}"
                REVIEW_REVISION_SET=true
                shift
                ;;
            --create|--import)
                (($# >= 2)) || die "$1 requires an immutable Git revision"
                [[ -z "$LANE_MANAGEMENT_MODE" ]] ||
                    die "Only one lane management action may be specified"
                LANE_MANAGEMENT_MODE="${1#--}"
                LANE_MANAGEMENT_REVISION="$2"
                shift 2
                ;;
            --remove)
                [[ -z "$LANE_MANAGEMENT_MODE" ]] ||
                    die "Only one lane management action may be specified"
                LANE_MANAGEMENT_MODE="remove"
                shift
                ;;
            --check)
                ! $ONBOARD_CHECK_MODE || die "--check may be specified only once"
                ONBOARD_CHECK_MODE=true
                shift
                ;;
            --onboard)
                ! $ONBOARD_APPLY_MODE || die "--onboard may be specified only once"
                ONBOARD_APPLY_MODE=true
                shift
                ;;
            --from)
                (($# >= 2)) || die "--from requires a source checkout"
                [[ -z "$ONBOARD_SOURCE" ]] || die "--from may be specified only once"
                ONBOARD_SOURCE="$2"
                shift 2
                ;;
            --from=*)
                [[ -z "$ONBOARD_SOURCE" ]] || die "--from may be specified only once"
                ONBOARD_SOURCE="${1#--from=}"
                shift
                ;;
            --setup)
                ! $SETUP_SESSION || die "--setup may be specified only once"
                SETUP_SESSION=true
                NEW_SESSION=true
                shift
                ;;
            --push-state|--pull-state|--list-state)
                [[ -z "$STATE_SYNC_MODE" ]] ||
                    die "Only one state synchronization action may be specified"
                STATE_SYNC_MODE="${1#--}"
                shift
                ;;
            --force-state)
                (($# >= 2)) || die "--force-state requires a generation"
                [[ -z "$STATE_SYNC_MODE" ]] ||
                    die "Only one state synchronization action may be specified"
                [[ "$2" =~ ^[0-9]+$ ]] && ((10#$2 > 0)) ||
                    die "--force-state generation must be a positive integer"
                STATE_SYNC_MODE="force-state"
                STATE_SYNC_GENERATION="$((10#$2))"
                shift 2
                ;;
            --codex-option)
                (($# >= 2)) || die "--codex-option requires a value"
                add_codex_option "$2"
                shift 2
                ;;
            --codex-option=*)
                add_codex_option "${1#--codex-option=}"
                shift
                ;;
            --image-version)
                (($# >= 2)) || die "--image-version requires a Docker image version"
                ! $IMAGE_TAG_OPTION_SET || die "--image-version may be specified only once"
                IMAGE_TAG_OPTION_SET=true
                IMAGE_TAG="$2"
                validate_image_tag "$IMAGE_TAG"
                shift 2
                ;;
            --image-version=*)
                ! $IMAGE_TAG_OPTION_SET || die "--image-version may be specified only once"
                IMAGE_TAG_OPTION_SET=true
                IMAGE_TAG="${1#--image-version=}"
                validate_image_tag "$IMAGE_TAG"
                shift
                ;;
            --set-clojure-mcp)
                die "Use: run-codex PROJECT --set clojure-mcp auto|on|off"
                ;;
            --set-profile)
                die "Use: run-codex PROJECT --set profile generic|cuda"
                ;;
            --*)
                die "Unknown launch option '$1'. Use --codex-option for supported Codex options."
                ;;
            *)
                [[ -z "$PROJECT" ]] || die "Only one project may be specified"
                PROJECT="$1"
                shift
                ;;
        esac
    done
}

SESSION_ROWS='[]'
RESOLVED_SESSION_ID=""
RESOLVED_SESSION_NAME=""

load_project_sessions() {
    local container_cwd="$1"
    local codex_home="$2"
    local state_db="$codex_home/state_5.sqlite"
    local rows=""

    need jq
    need sqlite3

    if [[ ! -e "$state_db" ]]; then
        SESSION_ROWS='[]'
        return 0
    fi
    [[ -f "$state_db" && -r "$state_db" ]] ||
        die "Codex session index is not a readable regular file: $state_db"

    if ! rows="$(
        sqlite3 -readonly -json -cmd '.timeout 2000' -- "$state_db" \
            "SELECT id,
                    COALESCE(name, '') AS name,
                    strftime('%Y-%m-%dT%H:%M:%SZ', updated_at, 'unixepoch') AS updated_at,
                    cwd
               FROM threads
              WHERE archived = 0
              ORDER BY updated_at DESC, id DESC;"
    )"; then
        die "Unable to read the Codex session index: $state_db"
    fi
    [[ -n "$rows" ]] || rows='[]'
    SESSION_ROWS="$(
        jq -ce --arg cwd "$container_cwd" \
            '[.[] | select(.cwd == $cwd) | {id, name, updated_at}]' <<<"$rows"
    )" || die "Codex session index returned invalid data"
}

print_session_rows() {
    local rows="$1"
    local count
    count="$(jq -r 'length' <<<"$rows")"

    printf '%-20s %-36s %s\n' UPDATED ID NAME
    if ((count == 0)); then
        echo "(no matching active sessions)"
        return 0
    fi

    while IFS=$'\t' read -r updated_at session_id session_name; do
        [[ -n "$session_name" ]] || session_name="(unnamed)"
        printf '%-20s %-36s %s\n' "$updated_at" "$session_id" "$session_name"
    done < <(
        jq -r '.[] |
            [(.updated_at // "-"), .id,
             ((.name // "") | gsub("[\\t\\r\\n]"; " "))] | @tsv' <<<"$rows"
    )
}

resolve_session_query() {
    local query="$1"
    local matches count

    [[ -n "$query" && "$query" != *$'\n'* && "$query" != *$'\r'* ]] ||
        die "--resume requires a non-empty single-line session name substring or UUID"

    matches="$(jq -ce --arg query "$query" \
        '[.[] | select(.id == $query)]' <<<"$SESSION_ROWS")"
    count="$(jq -r 'length' <<<"$matches")"
    if ((count == 0)); then
        matches="$(jq -ce --arg query "$query" \
            '[.[] | select(
                (.name // "") != "" and
                ((.name | ascii_downcase) | contains($query | ascii_downcase))
            )]' <<<"$SESSION_ROWS")"
        count="$(jq -r 'length' <<<"$matches")"
    fi

    case "$count" in
        0)
            echo "ERROR: No active session for project '$PROJECT' matches '$query'." >&2
            echo "List available sessions with: run-codex '$PROJECT' --sessions" >&2
            exit 1
            ;;
        1)
            RESOLVED_SESSION_ID="$(jq -r '.[0].id' <<<"$matches")"
            RESOLVED_SESSION_NAME="$(jq -r '.[0].name' <<<"$matches")"
            ;;
        *)
            echo "ERROR: Session query '$query' is ambiguous for project '$PROJECT'." >&2
            echo "Matching sessions:" >&2
            print_session_rows "$matches" >&2
            exit 2
            ;;
    esac
}

profile_image() {
    local profile="$1"
    validate_profile "$profile"
    validate_image_tag "$IMAGE_TAG"
    printf '%s-%s:%s\n' "$IMAGE_SLUG" "$profile" "$IMAGE_TAG"
}

canonical_dir() {
    local path="$1"
    [[ -d "$path" ]] || return 1
    realpath -e -- "$path"
}

git_root_for() {
    local path="$1"
    local root

    root="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null)" || return 1
    canonical_dir "$root"
}

GIT_LAYOUT="ordinary"
GIT_COMMON_DIR=""

inspect_git_layout() {
    local root="$1"
    local git_dir common_dir raw_git_dir raw_common_dir pointer_line back_pointer

    raw_git_dir="$(git -C "$root" rev-parse --path-format=absolute --git-dir 2>/dev/null)" ||
        die "Cannot resolve Git metadata for: $root"
    raw_common_dir="$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ||
        die "Cannot resolve common Git metadata for: $root"
    git_dir="$(realpath -e -- "$raw_git_dir")" ||
        die "Git metadata path does not exist: $raw_git_dir"
    common_dir="$(realpath -e -- "$raw_common_dir")" ||
        die "Common Git metadata path does not exist: $raw_common_dir"

    if [[ -f "$root/.git" ]]; then
        [[ "$git_dir" != "$common_dir" ]] ||
            die "Git submodules with a .git pointer file are not supported: $root"
        IFS= read -r pointer_line < "$root/.git" ||
            die "Cannot read linked-worktree pointer: $root/.git"
        [[ "$pointer_line" == "gitdir: $git_dir" &&
           "$raw_git_dir" == "$git_dir" &&
           "$raw_common_dir" == "$common_dir" ]] ||
            die "Linked worktree uses non-canonical Git pointer paths; recreate it from canonical checkout paths: $root"
        [[ -f "$git_dir/gitdir" && ! -L "$git_dir/gitdir" ]] ||
            die "Linked worktree has no safe Git back-pointer: $git_dir/gitdir"
        IFS= read -r back_pointer < "$git_dir/gitdir" ||
            die "Cannot read linked-worktree Git back-pointer: $git_dir/gitdir"
        [[ "$back_pointer" == "$root/.git" ]] ||
            die "Linked worktree Git back-pointer does not match its canonical checkout: $root"
        GIT_LAYOUT="linked-worktree"
    else
        [[ -d "$root/.git" && "$git_dir" == "$common_dir" ]] ||
            die "Unsupported Git repository layout: $root"
        GIT_LAYOUT="ordinary"
    fi
    GIT_COMMON_DIR="$common_dir"
}

CONFIG_PATH=""
CONFIG_PROFILE=""
CONFIG_CLOJURE_MCP=""
CONFIG_MODEL=""
CONFIG_REASONING=""
CONFIG_LANE="default"
CONFIG_STATE_MODE="legacy-global"
CONFIG_AGENT="codex"

registry_file_for() {
    local project="$1"
    local lane="$2"

    if [[ "$lane" == default ]]; then
        printf '%s\n' "$PROJECTS_DIR/$project"
    else
        printf '%s\n' "$LANES_DIR/$project/$lane"
    fi
}

read_project_config() {
    local file="$1"
    local first=""
    local path=""
    local profile=""
    local clojure_mcp=""
    local model=""
    local reasoning=""
    local lane=""
    local state_mode=""
    local agent=""

    [[ -f "$file" ]] || return 1
    IFS= read -r first < "$file" || true

    # Backward compatibility with the old registry format, which contained
    # only one line with the project path.
    if [[ "$first" != *=* ]]; then
        path="$first"
        profile="generic"
        clojure_mcp="auto"
    else
        while IFS= read -r line || [[ -n "$line" ]]; do
            case "$line" in
                path=*)
                    path="${line#path=}"
                    ;;
                profile=*)
                    profile="${line#profile=}"
                    ;;
                clojure_mcp=*)
                    clojure_mcp="${line#clojure_mcp=}"
                    ;;
                model=*)
                    model="${line#model=}"
                    ;;
                reasoning=*)
                    reasoning="${line#reasoning=}"
                    ;;
                lane=*)
                    lane="${line#lane=}"
                    ;;
                state=*)
                    state_mode="${line#state=}"
                    ;;
                agent=*)
                    agent="${line#agent=}"
                    ;;
                ''|'#'*)
                    ;;
                *)
                    die "Invalid project config line in $file: $line"
                    ;;
            esac
        done < "$file"
    fi

    [[ -n "$path" ]] || die "Project config has no path: $file"
    profile="${profile:-generic}"
    clojure_mcp="${clojure_mcp:-auto}"
    lane="${lane:-default}"
    state_mode="${state_mode:-legacy-global}"
    agent="${agent:-codex}"
    validate_profile "$profile"
    validate_clojure_mcp_setting "$clojure_mcp"
    [[ -z "$model" ]] || validate_codex_model "$model"
    [[ -z "$reasoning" ]] || validate_codex_reasoning "$reasoning"
    validate_lane_name "$lane"
    case "$state_mode" in
        isolated|legacy-global) ;;
        *) die "Invalid state mode '$state_mode' in $file" ;;
    esac
    case "$agent" in
        codex) ;;
        *) die "Unsupported agent adapter '$agent' in $file" ;;
    esac

    CONFIG_PATH="$path"
    CONFIG_PROFILE="$profile"
    CONFIG_CLOJURE_MCP="$clojure_mcp"
    CONFIG_MODEL="$model"
    CONFIG_REASONING="$reasoning"
    CONFIG_LANE="$lane"
    CONFIG_STATE_MODE="$state_mode"
    CONFIG_AGENT="$agent"
}

write_project_config() {
    local name="$1"
    local lane="$2"
    local path="$3"
    local profile="$4"
    local clojure_mcp="$5"
    local state_mode="${6:-isolated}"
    local agent="${7:-codex}"
    local model="${8:-}"
    local reasoning="${9:-}"
    local file
    file="$(registry_file_for "$name" "$lane")"
    local tmp="$file.tmp.$$"

    validate_project_name "$name"
    validate_lane_name "$lane"
    validate_profile "$profile"
    validate_clojure_mcp_setting "$clojure_mcp"
    [[ -z "$model" ]] || validate_codex_model "$model"
    [[ -z "$reasoning" ]] || validate_codex_reasoning "$reasoning"
    [[ "$state_mode" == isolated || "$state_mode" == legacy-global ]] ||
        die "Invalid lane state mode '$state_mode'"
    [[ "$agent" == codex ]] || die "Unsupported agent adapter '$agent'"

    mkdir -p -- "$(dirname -- "$file")"

    {
        printf 'path=%s\n' "$path"
        printf 'profile=%s\n' "$profile"
        printf 'clojure_mcp=%s\n' "$clojure_mcp"
        [[ -z "$model" ]] || printf 'model=%s\n' "$model"
        [[ -z "$reasoning" ]] || printf 'reasoning=%s\n' "$reasoning"
        printf 'lane=%s\n' "$lane"
        printf 'state=%s\n' "$state_mode"
        printf 'agent=%s\n' "$agent"
    } > "$tmp"

    mv -- "$tmp" "$file"
}

provision_missing_review_lane() {
    local name="$1"
    local lane="$2"
    local revision="$3"
    local default_file lane_file default_root commit
    local profile clojure_mcp agent managed_parent managed_path
    local provision_lock provision_lock_fd

    validate_project_name "$name"
    validate_lane_name "$lane"
    [[ "$lane" != default ]] || return 0
    [[ -n "$revision" && "$revision" != -* &&
       "$revision" != *$'\n'* && "$revision" != *$'\r'* ]] ||
        die "--review requires a valid Git revision"

    lane_file="$(registry_file_for "$name" "$lane")"
    [[ ! -f "$lane_file" ]] || return 0

    default_file="$(registry_file_for "$name" default)"
    [[ -f "$default_file" ]] || print_missing_project_help "$name"
    read_project_config "$default_file"
    [[ "$CONFIG_LANE" == default ]] ||
        die "Lane config identity mismatch in $default_file"
    default_root="$(git_root_for "$CONFIG_PATH")" ||
        die "Default lane for project '$name' is no longer a Git repository: $CONFIG_PATH"
    [[ "$default_root" == "$CONFIG_PATH" ]] ||
        die "Registered path for '$name' is not its Git repository root: $CONFIG_PATH"
    commit="$(
        git -C "$default_root" rev-parse --verify "${revision}^{commit}" 2>/dev/null
    )" || die "Review revision is not a commit in project '$name': $revision"

    profile="$CONFIG_PROFILE"
    clojure_mcp="$CONFIG_CLOJURE_MCP"
    agent="$CONFIG_AGENT"
    managed_parent="$(realpath -m -- "$CONFIG_ROOT/worktrees/$name")" ||
        die "Cannot resolve managed review worktree directory"
    managed_path="$managed_parent/$lane"
    if [[ "$managed_path" == "$default_root" ||
          "$managed_path" == "$default_root/"* ||
          "$default_root" == "$managed_path/"* ]]; then
        die "Managed review worktree path overlaps the default checkout: $managed_path"
    fi
    provision_lock="$CONFIG_ROOT/locks/$name/$lane.provision.lock"
    mkdir -p -- "$(dirname -- "$provision_lock")"
    exec {provision_lock_fd}>"$provision_lock"
    flock -x "$provision_lock_fd"

    # Another launcher may have completed provisioning while this invocation
    # waited for the project/lane provisioning lock.
    if [[ -f "$lane_file" ]]; then
        exec {provision_lock_fd}>&-
        return 0
    fi
    [[ ! -e "$managed_path" && ! -L "$managed_path" ]] ||
        die "Managed review worktree path already exists without a lane registration: $managed_path"

    mkdir -p -- "$managed_parent"
    echo "Creating managed review lane '$lane' at $managed_path" >&2
    git -C "$default_root" worktree add --detach "$managed_path" "$commit" >&2
    write_project_config "$name" "$lane" "$managed_path" "$profile" \
        "$clojure_mcp" isolated "$agent"
    exec {provision_lock_fd}>&-
}

managed_lane_path() {
    local name="$1"
    local lane="$2"
    realpath -m -- "$CONFIG_ROOT/worktrees/$name/$lane"
}

managed_lane_branch() {
    printf 'codex/%s/%s\n' "$1" "$2"
}

lane_handoff_lock() {
    local name="$1"
    local lane="$2"
    local lock_path

    if [[ -n "${CODEX_LOCK_FILE:-}" ]]; then
        [[ "$CODEX_LOCK_FILE" == /* ]] ||
            die "CODEX_LOCK_FILE must be an absolute path"
        lock_path="$(realpath -m -- "$CODEX_LOCK_FILE")" || return 1
    else
        lock_path="$(realpath -m -- "$CONFIG_ROOT/locks/$name/$lane.handoff.lock")" ||
            return 1
    fi
    [[ "$lock_path" != / ]] || die "CODEX_LOCK_FILE must not be the filesystem root"
    printf '%s\n' "$lock_path"
}

create_managed_lane() {
    local name="$1"
    local lane="$2"
    local revision="$3"
    local default_file lane_file default_root commit profile clojure_mcp agent
    local managed_parent managed_path branch lock_file lock_fd

    validate_project_name "$name"
    validate_lane_name "$lane"
    [[ "$lane" != default ]] || die "--create requires a non-default lane"
    [[ -n "$revision" && "$revision" != -* &&
       "$revision" != *$'\n'* && "$revision" != *$'\r'* ]] ||
        die "--create requires a valid Git revision"

    default_file="$(registry_file_for "$name" default)"
    lane_file="$(registry_file_for "$name" "$lane")"
    [[ -f "$default_file" ]] ||
        die "Initialize project '$name' default lane before creating lane '$lane'"
    [[ ! -e "$lane_file" && ! -L "$lane_file" ]] ||
        die "Project '$name' lane '$lane' is already registered"

    read_project_config "$default_file"
    [[ "$CONFIG_LANE" == default ]] ||
        die "Lane config identity mismatch in $default_file"
    default_root="$(git_root_for "$CONFIG_PATH")" ||
        die "Default lane for project '$name' is no longer a Git repository: $CONFIG_PATH"
    [[ "$default_root" == "$CONFIG_PATH" ]] ||
        die "Registered path for '$name' is not its Git repository root: $CONFIG_PATH"
    [[ -z "$(git -C "$default_root" status --porcelain=v1 --untracked-files=all)" ]] ||
        die "Default lane must be clean before creating a managed lane"
    commit="$(
        git -C "$default_root" rev-parse --verify "${revision}^{commit}" 2>/dev/null
    )" || die "Create revision is not a commit in project '$name': $revision"

    profile="$CONFIG_PROFILE"
    clojure_mcp="$CONFIG_CLOJURE_MCP"
    agent="$CONFIG_AGENT"
    managed_path="$(managed_lane_path "$name" "$lane")" ||
        die "Cannot resolve managed lane path"
    managed_parent="$(dirname -- "$managed_path")"
    [[ "$managed_path" != "$default_root" &&
       "$managed_path" != "$default_root/"* &&
       "$default_root" != "$managed_path/"* ]] ||
        die "Managed lane path overlaps the default checkout: $managed_path"
    [[ ! -e "$managed_path" && ! -L "$managed_path" ]] ||
        die "Managed lane path already exists without a registration: $managed_path"

    branch="$(managed_lane_branch "$name" "$lane")"
    git check-ref-format --branch "$branch" >/dev/null 2>&1 ||
        die "Invalid managed lane branch: $branch"
    ! git -C "$default_root" show-ref --verify --quiet "refs/heads/$branch" ||
        die "Managed lane branch already exists: $branch"

    lock_file="$(lane_handoff_lock "$name" default)" ||
        die "Cannot resolve default lane lock"
    mkdir -p -- "$(dirname -- "$lock_file")"
    exec {lock_fd}>"$lock_file"
    flock -n -x "$lock_fd" ||
        die "Stop project '$name' default lane before creating lane '$lane'"
    [[ ! -e "$lane_file" && ! -L "$lane_file" ]] ||
        die "Project '$name' lane '$lane' was registered while waiting for its lock"
    [[ ! -e "$managed_path" && ! -L "$managed_path" ]] ||
        die "Managed lane path appeared while waiting for its lock: $managed_path"
    ! git -C "$default_root" show-ref --verify --quiet "refs/heads/$branch" ||
        die "Managed lane branch appeared while waiting for its lock: $branch"
    [[ -z "$(git -C "$default_root" status --porcelain=v1 --untracked-files=all)" ]] ||
        die "Default lane changed while preparing managed lane '$lane'"

    (
        local rollback_pending=true
        local temp_worktree_created=false
        local registration_created=false
        local branch_created=false
        local temp_path=""
        local state_created=false
        local state_root=""
        local lane_state_path=""
        local state_owner=""
        local state_owner_file=""
        local state_quarantine=""

        rollback_managed_lane_create() {
            local status=$?
            local worktree_removed=true

            trap - EXIT HUP INT TERM
            if $rollback_pending && [[ -e "$managed_path" || -L "$managed_path" ]]; then
                echo "WARNING: managed lane reached its final path before interruption; preserving path '$managed_path', registration '$lane_file', and branch '$branch' for inspection." >&2
                exit "$status"
            fi
            if $rollback_pending && $temp_worktree_created; then
                set +e
                echo "Rolling back incomplete managed lane '$lane'" >&2
                if [[ -e "$temp_path" || -L "$temp_path" ]]; then
                    git -C "$default_root" worktree remove "$temp_path" \
                        >/dev/null 2>&1 || worktree_removed=false
                fi
                rm -f -- "$lane_file.tmp.$$"
                $registration_created && rm -f -- "$lane_file"
                if $worktree_removed && $branch_created; then
                    git -C "$default_root" update-ref -d \
                        "refs/heads/$branch" "$commit" >/dev/null 2>&1 || true
                fi
                if $state_created; then
                    if [[ -d "$lane_state_path" && ! -L "$lane_state_path" &&
                          -f "$state_owner_file" && ! -L "$state_owner_file" &&
                          "$(<"$state_owner_file")" == "$state_owner" ]]; then
                        state_quarantine="$lane_state_path.rollback.$state_owner"
                        if [[ ! -e "$state_quarantine" && ! -L "$state_quarantine" ]] &&
                           mv -T -- "$lane_state_path" "$state_quarantine"; then
                            if [[ -f "$state_quarantine/.run-codex-create-owner" &&
                                  ! -L "$state_quarantine/.run-codex-create-owner" &&
                                  "$(<"$state_quarantine/.run-codex-create-owner")" == "$state_owner" ]]; then
                                rm -rf -- "$state_quarantine"
                            else
                                echo "WARNING: quarantined lane state ownership changed; preserving '$state_quarantine' for inspection." >&2
                            fi
                        else
                            echo "WARNING: could not quarantine owned lane state; preserving '$lane_state_path' for inspection." >&2
                        fi
                    else
                        echo "WARNING: managed lane state ownership changed; preserving '$lane_state_path' for inspection." >&2
                    fi
                fi
                if [[ -e "$temp_path" || -L "$temp_path" ||
                      -e "$managed_path" || -L "$managed_path" ||
                      -e "$lane_file" || -L "$lane_file" ||
                      ( "$state_created" == true &&
                        ( -e "$lane_state_path" || -e "$state_quarantine" ) ) ]] ||
                   git -C "$default_root" show-ref --verify --quiet \
                       "refs/heads/$branch"; then
                    echo "WARNING: incomplete lane artifacts remain; inspect temporary path '$temp_path', final path '$managed_path', registration '$lane_file', branch '$branch', and state '$lane_state_path'." >&2
                fi
            fi
            exit "$status"
        }

        trap rollback_managed_lane_create EXIT
        trap 'exit 129' HUP
        trap 'exit 130' INT
        trap 'exit 143' TERM

        need mktemp
        mkdir -p -- "$managed_parent"
        temp_path="$(mktemp -d "$managed_parent/.${lane}.create.XXXXXX")"
        rmdir -- "$temp_path"
        echo "Creating managed lane '$lane' at $managed_path" >&2
        git -C "$default_root" worktree add --detach "$temp_path" "$commit" >&2
        temp_worktree_created=true
        mkdir -p -- "$LANE_STATE_ROOT"
        state_root="$(realpath -e -- "$LANE_STATE_ROOT")" ||
            die "Cannot resolve lane state root: $LANE_STATE_ROOT"
        lane_state_path="$(realpath -m -- "$state_root/$name/$lane")" ||
            die "Cannot resolve managed lane state path"
        [[ "$lane_state_path" == "$state_root/"* ]] ||
            die "Managed lane state path escapes its root: $lane_state_path"
        if [[ -e "$lane_state_path" || -L "$lane_state_path" ]]; then
            [[ -d "$lane_state_path" && ! -L "$lane_state_path" ]] ||
                die "Managed lane state must be a directory, not a symlink: $lane_state_path"
        else
            mkdir -p -- "$lane_state_path"
            state_owner="$(basename -- "$temp_path")"
            state_owner_file="$lane_state_path/.run-codex-create-owner"
            printf '%s\n' "$state_owner" > "$state_owner_file"
            state_created=true
            seed_new_managed_lane_codex_home "$name" "$lane"
        fi
        write_project_config "$name" "$lane" "$managed_path" "$profile" \
            "$clojure_mcp" isolated "$agent"
        registration_created=true
        git -C "$temp_path" switch -c "$branch" >&2
        branch_created=true
        git -C "$default_root" worktree move "$temp_path" "$managed_path"

        rollback_pending=false
        trap - EXIT HUP INT TERM
        if $state_created && ! rm -f -- "$state_owner_file"; then
            echo "WARNING: retained managed lane creation marker: $state_owner_file" >&2
        fi
        echo "Created project '$name' lane '$lane':"
        echo "  path:   $managed_path"
        echo "  branch: $branch"
        echo "  commit: $commit"
        echo "Complete local inputs with:"
        echo "  run-codex '$name' --lane '$lane' --onboard --from '$default_root'"
    )
}

import_lane_result() {
    local name="$1"
    local lane="$2"
    local revision="$3"
    local default_file lane_file default_root lane_root commit lane_head default_head
    local default_common lane_common default_lock lane_lock default_lock_fd lane_lock_fd

    validate_project_name "$name"
    validate_lane_name "$lane"
    [[ "$lane" != default ]] || die "--import requires a non-default source lane"
    [[ "$revision" =~ ^[0-9a-f]{40}$ || "$revision" =~ ^[0-9a-f]{64}$ ]] ||
        die "--import requires a full immutable commit ID"
    default_file="$(registry_file_for "$name" default)"
    lane_file="$(registry_file_for "$name" "$lane")"
    [[ -f "$default_file" && -f "$lane_file" ]] ||
        die "Project '$name' default lane and source lane '$lane' must both be registered"

    read_project_config "$default_file"
    default_root="$(git_root_for "$CONFIG_PATH")" ||
        die "Default lane checkout is unavailable: $CONFIG_PATH"
    inspect_git_layout "$default_root"
    default_common="$GIT_COMMON_DIR"
    read_project_config "$lane_file"
    lane_root="$(git_root_for "$CONFIG_PATH")" ||
        die "Source lane checkout is unavailable: $CONFIG_PATH"
    inspect_git_layout "$lane_root"
    lane_common="$GIT_COMMON_DIR"
    [[ "$default_common" == "$lane_common" ]] ||
        die "Source lane '$lane' no longer shares project '$name' Git metadata"

    commit="$(git -C "$lane_root" rev-parse --verify "${revision}^{commit}" 2>/dev/null)" ||
        die "Import commit is unavailable in lane '$lane': $revision"
    [[ "$commit" == "$revision" ]] ||
        die "--import requires the canonical full commit ID: $commit"
    lane_head="$(git -C "$lane_root" rev-parse --verify HEAD^{commit})" ||
        die "Cannot resolve source lane HEAD"
    [[ "$lane_head" == "$commit" ]] ||
        die "Import commit must equal lane '$lane' HEAD ($lane_head)"

    default_lock="$(lane_handoff_lock "$name" default)" ||
        die "Cannot resolve default lane lock"
    lane_lock="$(lane_handoff_lock "$name" "$lane")" ||
        die "Cannot resolve source lane lock"
    mkdir -p -- "$(dirname -- "$default_lock")" "$(dirname -- "$lane_lock")"
    exec {default_lock_fd}>"$default_lock"
    flock -n -x "$default_lock_fd" ||
        die "Stop project '$name' default lane before importing"
    if [[ "$lane_lock" != "$default_lock" ]]; then
        exec {lane_lock_fd}>"$lane_lock"
        flock -n -x "$lane_lock_fd" ||
            die "Stop project '$name' lane '$lane' before importing"
    fi

    [[ -z "$(git -C "$default_root" status --porcelain=v1 --untracked-files=all)" ]] ||
        die "Default lane must be clean before importing"
    [[ -z "$(git -C "$lane_root" status --porcelain=v1 --untracked-files=all)" ]] ||
        die "Source lane '$lane' must be clean before importing"
    lane_head="$(git -C "$lane_root" rev-parse --verify HEAD^{commit})" ||
        die "Cannot recheck source lane HEAD"
    [[ "$lane_head" == "$commit" ]] ||
        die "Source lane HEAD changed while preparing import"
    [[ -n "$(git -C "$default_root" symbolic-ref -q HEAD)" ]] ||
        die "Default lane must be on a branch before importing"
    default_head="$(git -C "$default_root" rev-parse --verify HEAD^{commit})" ||
        die "Cannot resolve default lane HEAD"
    git -C "$default_root" merge-base --is-ancestor "$default_head" "$commit" ||
        die "Import commit $commit does not fast-forward default HEAD $default_head"

    if [[ "$default_head" == "$commit" ]]; then
        echo "No changes. Default lane already contains $commit."
        return 0
    fi
    [[ "$(git -C "$default_root" rev-parse --verify HEAD^{commit})" == "$default_head" ]] ||
        die "Default lane HEAD changed while preparing import"
    git -C "$default_root" merge --ff-only "$commit"
    echo "Imported project '$name' lane '$lane' result at $commit."
}

remove_managed_lane() {
    local name="$1"
    local lane="$2"
    local default_file lane_file default_root lane_root expected_path lane_head default_head
    local branch expected_branch lock_file lock_fd manifest entry path
    local default_common lane_common

    validate_project_name "$name"
    validate_lane_name "$lane"
    [[ "$lane" != default ]] || die "The default lane cannot be removed"
    default_file="$(registry_file_for "$name" default)"
    lane_file="$(registry_file_for "$name" "$lane")"
    [[ -f "$default_file" && -f "$lane_file" ]] ||
        die "Project '$name' lane '$lane' is not registered"

    read_project_config "$default_file"
    default_root="$(git_root_for "$CONFIG_PATH")" ||
        die "Default lane checkout is unavailable: $CONFIG_PATH"
    inspect_git_layout "$default_root"
    default_common="$GIT_COMMON_DIR"
    read_project_config "$lane_file"
    lane_root="$(git_root_for "$CONFIG_PATH")" ||
        die "Lane '$lane' checkout is unavailable: $CONFIG_PATH"
    inspect_git_layout "$lane_root"
    lane_common="$GIT_COMMON_DIR"
    [[ "$default_common" == "$lane_common" ]] ||
        die "Lane '$lane' no longer shares project '$name' Git metadata"
    expected_path="$(managed_lane_path "$name" "$lane")" ||
        die "Cannot resolve managed lane path"
    [[ "$lane_root" == "$expected_path" ]] ||
        die "Refusing to remove adopted checkout $lane_root; only managed lanes can be removed"

    lock_file="$(lane_handoff_lock "$name" "$lane")" ||
        die "Cannot resolve lane lock"
    mkdir -p -- "$(dirname -- "$lock_file")"
    exec {lock_fd}>"$lock_file"
    flock -n -x "$lock_fd" ||
        die "Stop project '$name' lane '$lane' before removing it"

    PROJECT="$name"
    LANE="$lane"
    PROJECT_PATH="$lane_root"
    need jq
    load_onboarding_manifests "$name" "$lane"
    for manifest in "${ONBOARDING_MANIFESTS[@]}"; do
        while IFS= read -r entry; do
            path="$(jq -r '.path' <<<"$entry")"
            if [[ -e "$lane_root/$path" || -L "$lane_root/$path" ]]; then
                die "Lane '$lane' still contains declared local input '$path'; preserve or remove it before cleanup"
            fi
        done < <(jq -c '.files[]' "$manifest")
    done

    [[ -z "$(git -C "$lane_root" status --porcelain=v1 --untracked-files=all)" ]] ||
        die "Lane '$lane' has uncommitted or untracked files; preserve them before cleanup"
    [[ -z "$(git -C "$lane_root" status --porcelain=v1 --ignored=matching --untracked-files=all)" ]] ||
        die "Lane '$lane' has ignored files; preserve or remove them before cleanup"
    lane_head="$(git -C "$lane_root" rev-parse --verify HEAD^{commit})" ||
        die "Cannot resolve lane '$lane' HEAD"
    default_head="$(git -C "$default_root" rev-parse --verify HEAD^{commit})" ||
        die "Cannot resolve default lane HEAD"
    git -C "$default_root" merge-base --is-ancestor "$lane_head" "$default_head" ||
        die "Lane '$lane' has commits not integrated into the default lane"

    branch="$(git -C "$lane_root" symbolic-ref --short -q HEAD || true)"
    expected_branch="$(managed_lane_branch "$name" "$lane")"
    git -C "$default_root" worktree remove "$lane_root"
    rm -- "$lane_file"
    if [[ "$branch" == "$expected_branch" ]] &&
       ! git -C "$default_root" branch -d "$branch" >/dev/null 2>&1; then
        echo "WARNING: retained managed branch '$branch'; remove it after inspection." >&2
    fi

    echo "Removed managed checkout and registration for project '$name' lane '$lane'."
    echo "Retained lane state: $CONFIG_ROOT/state/$name/$lane"
    echo "Retained synchronization history: $SYNC_ROOT/projects/$name/lanes/$lane"
}

FOUND_PROJECT=""
FOUND_LANE=""

find_binding_for_path() {
    local root="$1"
    local file project lane
    local restore_nullglob=false

    FOUND_PROJECT=""
    FOUND_LANE=""

    if ! shopt -q nullglob; then
        shopt -s nullglob
        restore_nullglob=true
    fi
    for file in "$PROJECTS_DIR"/* "$LANES_DIR"/*/*; do
        [[ -f "$file" ]] || continue
        read_project_config "$file"

        if [[ "$CONFIG_PATH" == "$root" ]]; then
            [[ -z "$FOUND_PROJECT" ]] ||
                die "Checkout $root is registered to multiple project lanes"
            if [[ "$file" == "$PROJECTS_DIR/"* ]]; then
                project="$(basename -- "$file")"
                lane="default"
            else
                project="$(basename -- "$(dirname -- "$file")")"
                lane="$(basename -- "$file")"
            fi
            [[ "$CONFIG_LANE" == "$lane" ]] ||
                die "Lane config identity mismatch in $file"
            FOUND_PROJECT="$project"
            FOUND_LANE="$lane"
        fi
    done
    if $restore_nullglob; then
        shopt -u nullglob
    fi
}

project_uses_clojure() {
    local root="$1"
    local marker source_file

    for marker in deps.edn project.clj bb.edn shadow-cljs.edn build.boot; do
        [[ -f "$root/$marker" ]] && return 0
    done

    # Include untracked, non-ignored source so a newly created Clojure project
    # is detected before its first commit without crawling ignored build trees.
    while IFS= read -r -d '' source_file; do
        [[ -n "$source_file" ]] && return 0
    done < <(
        git -C "$root" ls-files -z --cached --others --exclude-standard -- \
            '*.clj' '*.cljc' '*.cljs'
    )

    return 1
}

EFFECTIVE_CLOJURE_LSP_MCP=0
EFFECTIVE_CLOJURE_LSP_MCP_REASON=""

resolve_clojure_mcp() {
    local root="$1"
    local project_setting="$2"
    local setting="$project_setting"
    local source="project setting"

    if [[ -n "$CLOJURE_LSP_MCP_OVERRIDE" ]]; then
        setting="$(normalize_clojure_mcp_setting "$CLOJURE_LSP_MCP_OVERRIDE")" ||
            die "Invalid CODEX_CLOJURE_LSP_MCP: $CLOJURE_LSP_MCP_OVERRIDE"
        source="environment override"
    fi

    case "$setting" in
        on)
            EFFECTIVE_CLOJURE_LSP_MCP=1
            EFFECTIVE_CLOJURE_LSP_MCP_REASON="$source: on"
            ;;
        off)
            EFFECTIVE_CLOJURE_LSP_MCP=0
            EFFECTIVE_CLOJURE_LSP_MCP_REASON="$source: off"
            ;;
        auto)
            if project_uses_clojure "$root"; then
                EFFECTIVE_CLOJURE_LSP_MCP=1
                EFFECTIVE_CLOJURE_LSP_MCP_REASON="auto-detected Clojure project"
            else
                EFFECTIVE_CLOJURE_LSP_MCP=0
                EFFECTIVE_CLOJURE_LSP_MCP_REASON="no Clojure project signals detected"
            fi
            ;;
    esac
}

init_project() {
    local profile="$DEFAULT_PROFILE"
    local profile_explicit=false
    local clojure_mcp="auto"
    local clojure_mcp_explicit=false
    local lane="default"
    local agent="codex"
    local bootstrap_codex_home=""
    local positional=()

    while (($#)); do
        case "$1" in
            --profile)
                (($# >= 2)) || die "--profile requires generic or cuda"
                profile="$2"
                profile_explicit=true
                shift 2
                ;;
            --profile=*)
                profile="${1#--profile=}"
                profile_explicit=true
                shift
                ;;
            --clojure-mcp)
                (($# >= 2)) || die "--clojure-mcp requires auto, on, or off"
                clojure_mcp="$2"
                clojure_mcp_explicit=true
                shift 2
                ;;
            --clojure-mcp=*)
                clojure_mcp="${1#--clojure-mcp=}"
                clojure_mcp_explicit=true
                shift
                ;;
            --lane)
                (($# >= 2)) || die "--lane requires a lane name"
                lane="$2"
                shift 2
                ;;
            --lane=*)
                lane="${1#--lane=}"
                shift
                ;;
            --agent)
                (($# >= 2)) || die "--agent requires an adapter name"
                agent="$2"
                shift 2
                ;;
            --agent=*)
                agent="${1#--agent=}"
                shift
                ;;
            --bootstrap-codex-home)
                (($# >= 2)) || die "--bootstrap-codex-home requires a directory"
                [[ -z "$bootstrap_codex_home" ]] ||
                    die "--bootstrap-codex-home may be specified only once"
                bootstrap_codex_home="$2"
                shift 2
                ;;
            --bootstrap-codex-home=*)
                [[ -z "$bootstrap_codex_home" ]] ||
                    die "--bootstrap-codex-home may be specified only once"
                bootstrap_codex_home="${1#--bootstrap-codex-home=}"
                shift
                ;;
            --)
                shift
                positional+=("$@")
                break
                ;;
            -* )
                die "Unknown --init option: $1"
                ;;
            *)
                positional+=("$1")
                shift
                ;;
        esac
    done

    validate_profile "$profile"
    validate_clojure_mcp_setting "$clojure_mcp"
    validate_lane_name "$lane"
    [[ "$agent" == codex ]] ||
        die "Unsupported agent adapter '$agent'. Available adapters: codex"
    ((${#positional[@]} <= 2)) ||
        die "Usage: run-codex --init [--lane LANE] [--profile generic|cuda] [--clojure-mcp auto|on|off] [--bootstrap-codex-home DIR] [PROJECT [PATH]]"

    local requested_name="${positional[0]:-}"
    local requested_path="${positional[1]:-$PWD}"
    local path root name file
    local candidate_git_layout candidate_git_common_dir default_file default_root

    need git
    need realpath
    mkdir -p "$PROJECTS_DIR"

    path="$(canonical_dir "$requested_path")" ||
        die "Directory does not exist: $requested_path"

    root="$(git_root_for "$path")" ||
        die "$path is not inside a Git repository"

    inspect_git_layout "$root"
    candidate_git_layout="$GIT_LAYOUT"
    candidate_git_common_dir="$GIT_COMMON_DIR"

    name="${requested_name:-$(basename "$root")}"
    validate_project_name "$name"
    file="$(registry_file_for "$name" "$lane")"

    if [[ "$lane" != default ]]; then
        default_file="$(registry_file_for "$name" default)"
        [[ -f "$default_file" ]] ||
            die "Initialize project '$name' default lane before adding lane '$lane'"
        read_project_config "$default_file"
        default_root="$(git_root_for "$CONFIG_PATH")" ||
            die "Default lane for project '$name' is no longer a Git repository: $CONFIG_PATH"
        inspect_git_layout "$default_root"
        [[ "$GIT_COMMON_DIR" == "$candidate_git_common_dir" ]] ||
            die "Lane '$lane' must be a linked worktree of project '$name' in this initial implementation"
        if ! $profile_explicit; then
            profile="$CONFIG_PROFILE"
        fi
        if ! $clojure_mcp_explicit; then
            clojure_mcp="$CONFIG_CLOJURE_MCP"
        fi
        GIT_LAYOUT="$candidate_git_layout"
        GIT_COMMON_DIR="$candidate_git_common_dir"
    fi

    if [[ -f "$file" ]]; then
        read_project_config "$file"

        [[ "$CONFIG_LANE" == "$lane" ]] ||
            die "Lane config identity mismatch in $file"

        if [[ "$CONFIG_PATH" == "$root" ]]; then
            if { ! $profile_explicit || [[ "$CONFIG_PROFILE" == "$profile" ]]; } &&
               { ! $clojure_mcp_explicit || [[ "$CONFIG_CLOJURE_MCP" == "$clojure_mcp" ]]; }; then
                echo "Project '$name' lane '$lane' is already initialized:"
                echo "  path:    $root"
                echo "  profile: $CONFIG_PROFILE"
                echo "  Clojure MCP: $CONFIG_CLOJURE_MCP"
                return 0
            fi

            echo "Project '$name' already exists with:" >&2
            echo "  profile:     $CONFIG_PROFILE" >&2
            echo "  Clojure MCP: $CONFIG_CLOJURE_MCP" >&2
            if $profile_explicit && [[ "$CONFIG_PROFILE" != "$profile" ]]; then
                echo "Change its profile with:" >&2
                echo "  run-codex '$name' --lane '$lane' --set profile '$profile'" >&2
            fi
            if $clojure_mcp_explicit && [[ "$CONFIG_CLOJURE_MCP" != "$clojure_mcp" ]]; then
                echo "Change its Clojure MCP setting with:" >&2
                echo "  run-codex '$name' --lane '$lane' --set clojure-mcp '$clojure_mcp'" >&2
            fi
            exit 1
        fi

        echo "Project '$name' lane '$lane' is already registered as:" >&2
        echo "  $CONFIG_PATH" >&2
        echo >&2
        echo "To intentionally change its local checkout path:" >&2
        echo "  run-codex --rebind '$name' '$root' --lane '$lane'" >&2
        exit 1
    fi

    find_binding_for_path "$root"
    [[ -z "$FOUND_PROJECT" ]] ||
        die "$root is already registered as project '$FOUND_PROJECT' lane '$FOUND_LANE'"

    if [[ -n "$bootstrap_codex_home" ]]; then
        bootstrap_lane_codex_home "$name" "$lane" "$bootstrap_codex_home"
    fi
    write_project_config "$name" "$lane" "$root" "$profile" "$clojure_mcp" isolated "$agent"

    echo "Initialized project '$name' lane '$lane':"
    echo "  path:        $root"
    echo "  profile:     $profile"
    echo "  Clojure MCP: $clojure_mcp"
    echo "  agent:       $agent"
    echo "  state:       isolated"
    echo "  Git layout:  $GIT_LAYOUT"
    echo "  image:       $(profile_image "$profile")"
    if [[ "$lane" == default ]]; then
        echo "  container:   $WORKSPACE_ROOT/$name"
    else
        echo "  container:   $WORKSPACE_ROOT/$name--$lane"
    fi
}

rebind_project() {
    local name="$1"
    local requested_path="${2:-$PWD}"
    local lane="${3:-default}"
    local file
    local path root profile clojure_mcp model reasoning state_mode agent
    local candidate_git_layout candidate_git_common_dir default_file default_root
    local lane_file lane_root restore_nullglob=false

    validate_project_name "$name"
    validate_lane_name "$lane"
    file="$(registry_file_for "$name" "$lane")"
    [[ -f "$file" ]] || die "Project '$name' is not registered. Use --init instead."

    need git
    need realpath

    read_project_config "$file"
    profile="$CONFIG_PROFILE"
    clojure_mcp="$CONFIG_CLOJURE_MCP"
    model="$CONFIG_MODEL"
    reasoning="$CONFIG_REASONING"
    state_mode="$CONFIG_STATE_MODE"
    agent="$CONFIG_AGENT"

    path="$(canonical_dir "$requested_path")" ||
        die "Directory does not exist: $requested_path"

    root="$(git_root_for "$path")" ||
        die "$path is not inside a Git repository"

    inspect_git_layout "$root"
    candidate_git_layout="$GIT_LAYOUT"
    candidate_git_common_dir="$GIT_COMMON_DIR"

    if [[ "$lane" != default ]]; then
        default_file="$(registry_file_for "$name" default)"
        [[ -f "$default_file" ]] ||
            die "Project '$name' default lane is not registered"
        read_project_config "$default_file"
        default_root="$(git_root_for "$CONFIG_PATH")" ||
            die "Default lane for project '$name' is no longer a Git repository: $CONFIG_PATH"
        inspect_git_layout "$default_root"
        [[ "$GIT_COMMON_DIR" == "$candidate_git_common_dir" ]] ||
            die "Lane '$lane' must be a linked worktree of project '$name' in this initial implementation"
        GIT_LAYOUT="$candidate_git_layout"
        GIT_COMMON_DIR="$candidate_git_common_dir"
    else
        if ! shopt -q nullglob; then
            shopt -s nullglob
            restore_nullglob=true
        fi
        for lane_file in "$LANES_DIR/$name"/*; do
            [[ -f "$lane_file" ]] || continue
            read_project_config "$lane_file"
            lane_root="$(git_root_for "$CONFIG_PATH")" ||
                die "Registered lane '${CONFIG_LANE}' for project '$name' is no longer a Git repository: $CONFIG_PATH"
            inspect_git_layout "$lane_root"
            [[ "$GIT_COMMON_DIR" == "$candidate_git_common_dir" ]] ||
                die "Cannot rebind the default lane away from registered lane '${CONFIG_LANE}'; re-create the project lane set together"
        done
        if $restore_nullglob; then
            shopt -u nullglob
        fi
        GIT_LAYOUT="$candidate_git_layout"
        GIT_COMMON_DIR="$candidate_git_common_dir"
    fi

    find_binding_for_path "$root"
    if [[ -n "$FOUND_PROJECT" ]] &&
       { [[ "$FOUND_PROJECT" != "$name" ]] || [[ "$FOUND_LANE" != "$lane" ]]; }; then
        die "$root is already registered as project '$FOUND_PROJECT' lane '$FOUND_LANE'"
    fi

    write_project_config "$name" "$lane" "$root" "$profile" "$clojure_mcp" \
        "$state_mode" "$agent" "$model" "$reasoning"

    echo "Rebound project '$name' lane '$lane':"
    echo "  path:        $root"
    echo "  profile:     $profile"
    echo "  Clojure MCP: $clojure_mcp"
}

set_profile() {
    local name="$1"
    local lane="$2"
    local profile="$3"
    local file

    validate_project_name "$name"
    validate_lane_name "$lane"
    validate_profile "$profile"
    file="$(registry_file_for "$name" "$lane")"
    [[ -f "$file" ]] || die "Project '$name' is not registered"

    read_project_config "$file"
    write_project_config "$name" "$lane" "$CONFIG_PATH" "$profile" \
        "$CONFIG_CLOJURE_MCP" "$CONFIG_STATE_MODE" "$CONFIG_AGENT" \
        "$CONFIG_MODEL" "$CONFIG_REASONING"

    echo "Project '$name' lane '$lane' now uses profile '$profile':"
    echo "  $(profile_image "$profile")"
}

set_clojure_mcp() {
    local name="$1"
    local lane="$2"
    local clojure_mcp="$3"
    local file

    validate_project_name "$name"
    validate_lane_name "$lane"
    validate_clojure_mcp_setting "$clojure_mcp"
    file="$(registry_file_for "$name" "$lane")"
    [[ -f "$file" ]] || die "Project '$name' is not registered"

    read_project_config "$file"
    write_project_config "$name" "$lane" "$CONFIG_PATH" "$CONFIG_PROFILE" \
        "$clojure_mcp" "$CONFIG_STATE_MODE" "$CONFIG_AGENT" \
        "$CONFIG_MODEL" "$CONFIG_REASONING"

    echo "Project '$name' lane '$lane' now uses Clojure MCP setting '$clojure_mcp'."
}

set_model() {
    local name="$1"
    local lane="$2"
    local model="$3"
    local file

    validate_project_name "$name"
    validate_lane_name "$lane"
    validate_codex_model "$model"
    file="$(registry_file_for "$name" "$lane")"
    [[ -f "$file" ]] || die "Project '$name' is not registered"

    read_project_config "$file"
    write_project_config "$name" "$lane" "$CONFIG_PATH" "$CONFIG_PROFILE" \
        "$CONFIG_CLOJURE_MCP" "$CONFIG_STATE_MODE" "$CONFIG_AGENT" \
        "$model" "$CONFIG_REASONING"

    echo "Project '$name' lane '$lane' now uses Codex model '$model'."
}

set_reasoning() {
    local name="$1"
    local lane="$2"
    local reasoning="$3"
    local file

    validate_project_name "$name"
    validate_lane_name "$lane"
    validate_codex_reasoning "$reasoning"
    file="$(registry_file_for "$name" "$lane")"
    [[ -f "$file" ]] || die "Project '$name' is not registered"

    read_project_config "$file"
    write_project_config "$name" "$lane" "$CONFIG_PATH" "$CONFIG_PROFILE" \
        "$CONFIG_CLOJURE_MCP" "$CONFIG_STATE_MODE" "$CONFIG_AGENT" \
        "$CONFIG_MODEL" "$reasoning"

    echo "Project '$name' lane '$lane' now uses Codex reasoning effort '$reasoning'."
}

set_project_value() {
    local name="$1"
    local lane="$2"
    local key="$3"
    local value="$4"

    case "$key" in
        profile) set_profile "$name" "$lane" "$value" ;;
        clojure-mcp) set_clojure_mcp "$name" "$lane" "$value" ;;
        model) set_model "$name" "$lane" "$value" ;;
        reasoning) set_reasoning "$name" "$lane" "$value" ;;
        *) die "Unknown project setting '$key'. Supported settings: profile, clojure-mcp, model, reasoning" ;;
    esac
}

list_projects() {
    mkdir -p "$PROJECTS_DIR"

    printf '%-20s %-16s %-10s %-12s %-24s %-10s %-10s %s\n' \
        "PROJECT" "LANE" "PROFILE" "CLOJURE-MCP" "MODEL" "REASONING" "STATUS" "PATH"

    local restore_nullglob=false
    if ! shopt -q nullglob; then
        shopt -s nullglob
        restore_nullglob=true
    fi
    local files=("$PROJECTS_DIR"/* "$LANES_DIR"/*/*)
    if $restore_nullglob; then
        shopt -u nullglob
    fi

    if ((${#files[@]} == 0)); then
        echo "(no projects configured)"
        return 0
    fi

    local file name lane path profile clojure_mcp model reasoning status actual_root

    for file in "${files[@]}"; do
        [[ -f "$file" ]] || continue
        if [[ "$file" == "$PROJECTS_DIR/"* ]]; then
            name="$(basename -- "$file")"
            lane="default"
        else
            name="$(basename -- "$(dirname -- "$file")")"
            lane="$(basename -- "$file")"
        fi
        read_project_config "$file"
        [[ "$CONFIG_LANE" == "$lane" ]] ||
            die "Lane config identity mismatch in $file"
        path="$CONFIG_PATH"
        profile="$CONFIG_PROFILE"
        clojure_mcp="$CONFIG_CLOJURE_MCP"
        model="${CONFIG_MODEL:--}"
        reasoning="${CONFIG_REASONING:--}"

        if [[ ! -d "$path" ]]; then
            status="MISSING"
        elif actual_root="$(git_root_for "$path")" && [[ "$actual_root" == "$path" ]]; then
            status="OK"
        else
            status="NOT-GIT"
        fi

        printf '%-20s %-16s %-10s %-12s %-24s %-10s %-10s %s\n' \
            "$name" "$lane" "$profile" "$clojure_mcp" "$model" \
            "$reasoning" "$status" "$path"
    done
}

print_missing_project_help() {
    local name="$1"
    local cwd_root=""

    echo "ERROR: Project '$name' is not initialized on this machine." >&2
    echo >&2

    if cwd_root="$(git_root_for "$PWD" 2>/dev/null)"; then
        echo "Current directory is inside:" >&2
        echo "  $cwd_root" >&2
        echo >&2
        echo "If this is project '$name', initialize it with:" >&2
        echo "  run-codex --init '$name' '$cwd_root'" >&2
        echo >&2
        echo "If it needs CUDA:" >&2
        echo "  run-codex --init --profile cuda '$name' '$cwd_root'" >&2
    else
        echo "Initialize its local checkout with:" >&2
        echo "  run-codex --init '$name' /path/to/$name" >&2
        echo >&2
        echo "For a CUDA project:" >&2
        echo "  run-codex --init --profile cuda '$name' /path/to/$name" >&2
    fi

    exit 1
}

RESOLVED_NAME=""
RESOLVED_PATH=""
RESOLVED_PROFILE=""
RESOLVED_CLOJURE_MCP=""
RESOLVED_MODEL=""
RESOLVED_REASONING=""
RESOLVED_LANE="default"
RESOLVED_STATE_MODE="legacy-global"
RESOLVED_AGENT="codex"
RESOLVED_GIT_LAYOUT="ordinary"
RESOLVED_GIT_COMMON_DIR=""

resolve_project() {
    local requested_name="${1:-}"
    local requested_lane="${2:-default}"
    local file root current_root name lane
    local lane_profile lane_clojure_mcp lane_model lane_reasoning
    local lane_state_mode lane_agent
    local candidate_git_layout candidate_git_common_dir default_file default_root

    if [[ -n "$requested_name" ]]; then
        validate_project_name "$requested_name"
        validate_lane_name "$requested_lane"
        file="$(registry_file_for "$requested_name" "$requested_lane")"
        [[ -f "$file" ]] || print_missing_project_help "$requested_name"

        read_project_config "$file"
        [[ "$CONFIG_LANE" == "$requested_lane" ]] ||
            die "Lane config identity mismatch in $file"

        if [[ ! -d "$CONFIG_PATH" ]]; then
            echo "ERROR: Project '$requested_name' path does not exist:" >&2
            echo "  $CONFIG_PATH" >&2
            echo >&2
            echo "If the checkout moved, run:" >&2
            echo "  run-codex --rebind '$requested_name' /new/path/to/$requested_name" >&2
            exit 1
        fi

        root="$(git_root_for "$CONFIG_PATH")" ||
            die "Registered path for '$requested_name' is no longer a Git repository: $CONFIG_PATH"

        [[ "$root" == "$CONFIG_PATH" ]] ||
            die "Registered path for '$requested_name' is not its Git repository root: $CONFIG_PATH"

        inspect_git_layout "$root"

        lane_profile="$CONFIG_PROFILE"
        lane_clojure_mcp="$CONFIG_CLOJURE_MCP"
        lane_model="$CONFIG_MODEL"
        lane_reasoning="$CONFIG_REASONING"
        lane_state_mode="$CONFIG_STATE_MODE"
        lane_agent="$CONFIG_AGENT"
        candidate_git_layout="$GIT_LAYOUT"
        candidate_git_common_dir="$GIT_COMMON_DIR"
        if [[ "$requested_lane" != default ]]; then
            default_file="$(registry_file_for "$requested_name" default)"
            [[ -f "$default_file" ]] ||
                die "Project '$requested_name' default lane is not registered"
            read_project_config "$default_file"
            default_root="$(git_root_for "$CONFIG_PATH")" ||
                die "Default lane for project '$requested_name' is no longer a Git repository: $CONFIG_PATH"
            inspect_git_layout "$default_root"
            [[ "$GIT_COMMON_DIR" == "$candidate_git_common_dir" ]] ||
                die "Lane '$requested_lane' no longer belongs to project '$requested_name'"
        fi

        RESOLVED_NAME="$requested_name"
        RESOLVED_PATH="$root"
        RESOLVED_PROFILE="$lane_profile"
        RESOLVED_CLOJURE_MCP="$lane_clojure_mcp"
        RESOLVED_MODEL="$lane_model"
        RESOLVED_REASONING="$lane_reasoning"
        RESOLVED_LANE="$requested_lane"
        RESOLVED_STATE_MODE="$lane_state_mode"
        RESOLVED_AGENT="$lane_agent"
        RESOLVED_GIT_LAYOUT="$candidate_git_layout"
        RESOLVED_GIT_COMMON_DIR="$candidate_git_common_dir"
        return 0
    fi

    current_root="$(git_root_for "$PWD")" || {
        echo "ERROR: Current directory is not inside a Git repository." >&2
        echo >&2
        echo "Run a configured project explicitly:" >&2
        echo "  run-codex PROJECT" >&2
        echo >&2
        echo "or initialize the current Git project:" >&2
        echo "  run-codex --init" >&2
        exit 1
    }

    inspect_git_layout "$current_root"
    find_binding_for_path "$current_root"
    name="$FOUND_PROJECT"
    lane="$FOUND_LANE"

    if [[ -z "$name" ]]; then
        local suggested_name
        suggested_name="$(basename "$current_root")"
        validate_project_name "$suggested_name"

        echo "ERROR: This Git project is not initialized for run-codex:" >&2
        echo "  $current_root" >&2
        echo >&2
        echo "Initialize it (generic image) with:" >&2
        echo "  run-codex --init '$suggested_name' '$current_root'" >&2
        echo >&2
        echo "or, if it needs CUDA:" >&2
        echo "  run-codex --init --profile cuda '$suggested_name' '$current_root'" >&2
        exit 1
    fi

    read_project_config "$(registry_file_for "$name" "$lane")"

    lane_profile="$CONFIG_PROFILE"
    lane_clojure_mcp="$CONFIG_CLOJURE_MCP"
    lane_model="$CONFIG_MODEL"
    lane_reasoning="$CONFIG_REASONING"
    lane_state_mode="$CONFIG_STATE_MODE"
    lane_agent="$CONFIG_AGENT"
    candidate_git_layout="$GIT_LAYOUT"
    candidate_git_common_dir="$GIT_COMMON_DIR"
    if [[ "$lane" != default ]]; then
        default_file="$(registry_file_for "$name" default)"
        [[ -f "$default_file" ]] ||
            die "Project '$name' default lane is not registered"
        read_project_config "$default_file"
        default_root="$(git_root_for "$CONFIG_PATH")" ||
            die "Default lane for project '$name' is no longer a Git repository: $CONFIG_PATH"
        inspect_git_layout "$default_root"
        [[ "$GIT_COMMON_DIR" == "$candidate_git_common_dir" ]] ||
            die "Lane '$lane' no longer belongs to project '$name'"
    fi

    RESOLVED_NAME="$name"
    RESOLVED_PATH="$current_root"
    RESOLVED_PROFILE="$lane_profile"
    RESOLVED_CLOJURE_MCP="$lane_clojure_mcp"
    RESOLVED_MODEL="$lane_model"
    RESOLVED_REASONING="$lane_reasoning"
    RESOLVED_LANE="$lane"
    RESOLVED_STATE_MODE="$lane_state_mode"
    RESOLVED_AGENT="$lane_agent"
    RESOLVED_GIT_LAYOUT="$candidate_git_layout"
    RESOLVED_GIT_COMMON_DIR="$candidate_git_common_dir"
}

CODEX_HOST_HOME=""
CODEX_HOST_M2=""

resolve_lane_codex_home() {
    local project="$1"
    local lane="$2"
    local state_mode="$3"
    local state_root resolved

    case "$state_mode" in
        legacy-global)
            [[ "$lane" == default ]] ||
                die "Only a default lane may use legacy global Codex state"
            mkdir -p -- "$HOME/.codex"
            CODEX_HOST_HOME="$(realpath -e -- "$HOME/.codex")" ||
                die "Cannot resolve legacy Codex state directory"
            mkdir -p -- "$HOME/.m2"
            CODEX_HOST_M2="$(realpath -e -- "$HOME/.m2")" ||
                die "Cannot resolve legacy Maven cache directory"
            ;;
        isolated)
            mkdir -p -- "$LANE_STATE_ROOT"
            state_root="$(realpath -e -- "$LANE_STATE_ROOT")" ||
                die "Cannot resolve lane state root: $LANE_STATE_ROOT"
            mkdir -p -- "$LANE_STATE_ROOT/$project/$lane/codex-home"
            resolved="$(realpath -e -- "$LANE_STATE_ROOT/$project/$lane/codex-home")" ||
                die "Cannot resolve Codex state for project '$project' lane '$lane'"
            [[ "$resolved" == "$state_root/"* ]] ||
                die "Lane Codex state escapes its managed root: $resolved"
            CODEX_HOST_HOME="$resolved"
            mkdir -p -- "$LANE_STATE_ROOT/$project/$lane/m2"
            resolved="$(realpath -e -- "$LANE_STATE_ROOT/$project/$lane/m2")" ||
                die "Cannot resolve Maven cache for project '$project' lane '$lane'"
            [[ "$resolved" == "$state_root/"* ]] ||
                die "Lane Maven cache escapes its managed root: $resolved"
            CODEX_HOST_M2="$resolved"
            ;;
    esac
}

copy_codex_bootstrap_files() {
    local requested_source="$1"
    local destination_root="$2"
    local require_empty="$3"
    local source file destination
    local restore_nullglob=false
    local inputs=()

    need find
    need install

    source="$(canonical_dir "$requested_source")" ||
        die "Codex bootstrap directory does not exist: $requested_source"
    [[ "$source" != "$destination_root" ]] ||
        die "Codex bootstrap source and destination must differ"
    if $require_empty; then
        [[ -z "$(find "$destination_root" -mindepth 1 -maxdepth 1 -print -quit)" ]] ||
            die "Refusing to bootstrap a non-empty lane Codex home: $destination_root"
    fi

    if ! shopt -q nullglob; then
        shopt -s nullglob
        restore_nullglob=true
    fi
    inputs=(
        "$source/auth.json" \
        "$source/config.toml" \
        "$source/requirements.toml" \
        "$source"/*.config.toml
    )
    for file in "${inputs[@]}"; do
        [[ -e "$file" || -L "$file" ]] || continue
        [[ -f "$file" && ! -L "$file" ]] ||
            die "Codex bootstrap input must be a regular file, not a symlink: $file"
    done
    for file in "${inputs[@]}"; do
        [[ -f "$file" ]] || continue
        destination="$destination_root/$(basename -- "$file")"
        if [[ -e "$destination" || -L "$destination" ]]; then
            [[ -f "$destination" && ! -L "$destination" ]] ||
                die "Codex bootstrap destination must be a regular file, not a symlink: $destination"
            $require_empty || continue
        fi
        install -m 0600 -- "$file" "$destination"
    done
    if $restore_nullglob; then
        shopt -u nullglob
    fi
}

bootstrap_lane_codex_home() {
    local project="$1"
    local lane="$2"
    local requested_source="$3"

    resolve_lane_codex_home "$project" "$lane" isolated
    copy_codex_bootstrap_files "$requested_source" "$CODEX_HOST_HOME" true
}

seed_managed_lane_codex_home() {
    local project="$1"
    local lane="$2"
    local default_file lane_file default_state_mode
    local managed_parent managed_path

    default_file="$(registry_file_for "$project" default)"
    lane_file="$(registry_file_for "$project" "$lane")"
    [[ -f "$default_file" && -f "$lane_file" ]] || return 0

    read_project_config "$default_file"
    default_state_mode="$CONFIG_STATE_MODE"
    read_project_config "$lane_file"
    managed_parent="$(realpath -m -- "$CONFIG_ROOT/worktrees/$project")" ||
        die "Cannot resolve managed review worktree directory"
    managed_path="$managed_parent/$lane"
    [[ "$CONFIG_PATH" == "$managed_path" ]] || return 0

    seed_new_managed_lane_codex_home "$project" "$lane" "$default_state_mode"
}

seed_new_managed_lane_codex_home() {
    local project="$1"
    local lane="$2"
    local default_state_mode="${3:-}"
    local default_file default_codex_home

    default_file="$(registry_file_for "$project" default)"
    [[ -f "$default_file" ]] || return 0
    if [[ -z "$default_state_mode" ]]; then
        read_project_config "$default_file"
        default_state_mode="$CONFIG_STATE_MODE"
    fi
    resolve_lane_codex_home "$project" default "$default_state_mode"
    default_codex_home="$CODEX_HOST_HOME"
    resolve_lane_codex_home "$project" "$lane" isolated
    copy_codex_bootstrap_files "$default_codex_home" "$CODEX_HOST_HOME" false
}

run_lane_state_sync() {
    local mode="$1"
    local launcher_source launcher_dir command
    local lane_sync_dir lane_state_dir
    local handoff_commit="" onboarding_hash=""
    local runtime_version="" runtime_revision=""
    local args=()

    launcher_source="$(realpath -e -- "${BASH_SOURCE[0]}")" ||
        die "Cannot resolve run-codex installation path"
    launcher_dir="$(dirname -- "$launcher_source")"
    lane_sync_dir="$SYNC_ROOT/projects/$PROJECT/lanes/$LANE"
    lane_state_dir="$LOCAL_SYNC_STATE_ROOT/projects/$PROJECT/lanes/$LANE"

    case "$mode" in
        push-state)
            command="$launcher_dir/codex-push"
            ;;
        pull-state)
            command="$launcher_dir/codex-pull"
            ;;
        list-state)
            command="$launcher_dir/codex-pull"
            args=(--list)
            ;;
        force-state)
            command="$launcher_dir/codex-pull"
            args=(--force "$STATE_SYNC_GENERATION")
            ;;
        *) die "Unknown lane state synchronization action: $mode" ;;
    esac
    [[ -x "$command" ]] ||
        die "Missing synchronization companion command: $command"

    if [[ "$mode" != list-state ]]; then
        [[ -z "$(git -C "$PROJECT_PATH" status --porcelain=v1 --untracked-files=all)" ]] ||
            die "Preserve or remove checkout changes before handing off lane '$LANE'"
        handoff_commit="$(git -C "$PROJECT_PATH" rev-parse --verify HEAD^{commit})" ||
            die "Cannot resolve the lane's required Git commit"

        need jq
        need sha256sum
        load_onboarding_manifests "$PROJECT" "$LANE"
        if ! check_onboarding true; then
            check_onboarding false || true
            die "Complete destination-ready onboarding before handing off lane '$LANE'"
        fi
        onboarding_hash="$(onboarding_contract_hash)" ||
            die "Cannot calculate the onboarding handoff contract"

        need docker
        docker info >/dev/null 2>&1 || die "Docker daemon is not available"
        runtime_version="$(
            docker image inspect --format \
                '{{ index .Config.Labels "org.opencontainers.image.version" }}' \
                "$IMAGE" 2>/dev/null
        )" || die "Required handoff image is not available locally: $IMAGE"
        runtime_revision="$(
            docker image inspect --format \
                '{{ index .Config.Labels "org.opencontainers.image.revision" }}' \
                "$IMAGE" 2>/dev/null
        )" || die "Cannot inspect handoff image revision: $IMAGE"
    fi

    CODEX_DIR="$CODEX_HOST_HOME" \
    CODEX_SYNC_DIR="$lane_sync_dir" \
    CODEX_LOCK_FILE="$LOCK_FILE" \
    CODEX_CONTAINER_PROJECT="$PROJECT" \
    CODEX_CONTAINER_LANE="$LANE" \
    CODEX_HANDOFF_PROJECT="$PROJECT" \
    CODEX_HANDOFF_LANE="$LANE" \
    CODEX_HANDOFF_COMMIT="$handoff_commit" \
    CODEX_HANDOFF_RUNTIME_PROFILE="$PROFILE" \
    CODEX_HANDOFF_RUNTIME_VERSION="$runtime_version" \
    CODEX_HANDOFF_RUNTIME_REVISION="$runtime_revision" \
    CODEX_HANDOFF_ONBOARDING_SHA256="$onboarding_hash" \
    CODEX_HANDOFF_READY="$([[ "$mode" == list-state ]] || printf 1)" \
    XDG_STATE_HOME="$lane_state_dir" \
        exec "$command" "${args[@]}"
}

ONBOARDING_MANIFESTS=()
ONBOARDING_ISSUES=0

validate_onboarding_relative_path() {
    local path="$1"

    [[ -n "$path" && "$path" != /* && "$path" != */ &&
       "$path" != *$'\n'* && "$path" != *$'\r'* && "$path" != *$'\t'* &&
       "$path" != *//* ]] || return 1
    case "/$path/" in
        */./*|*/../*) return 1 ;;
    esac
    case "$path" in
        .git|.git/*|.codex|.codex/*|.codex-universal|.codex-universal/*)
            return 1
            ;;
    esac
}

load_onboarding_manifests() {
    local project="$1"
    local lane="$2"
    local candidate

    ONBOARDING_MANIFESTS=()
    for candidate in \
        "$PROJECT_PATH/.codex-universal/onboarding.json" \
        "$ONBOARDING_DIR/$project.json" \
        "$ONBOARDING_DIR/$project/$lane.json"; do
        [[ -e "$candidate" || -L "$candidate" ]] || continue
        [[ -f "$candidate" && ! -L "$candidate" && -r "$candidate" ]] ||
            die "Onboarding manifest must be a readable regular file, not a symlink: $candidate"
        jq -e '
            type == "object" and
            .version == 1 and
            (.files | type == "array") and
            all(.files[];
                type == "object" and
                (.path | type == "string") and
                ((.template == null) or (.template | type == "string")) and
                ((.secret == null) or (.secret | type == "boolean")) and
                ((.mode == null) or (.mode == "0600") or
                 (.mode == "0644") or (.mode == "0700") or
                 (.mode == "0755")) and
                ((.placeholders == null) or
                 ((.placeholders | type == "array") and
                  all(.placeholders[]; type == "string" and length > 0))) and
                ((keys - ["mode", "path", "placeholders", "secret", "template"]) | length == 0)
            ) and
            ((keys - ["files", "version"]) | length == 0)
        ' "$candidate" >/dev/null ||
            die "Invalid onboarding manifest schema: $candidate"
        ONBOARDING_MANIFESTS+=("$candidate")
    done
    if ((${#ONBOARDING_MANIFESTS[@]} > 0)); then
        need grep
        need stat
        need install
    fi
}

onboarding_contract_hash() {
    if ((${#ONBOARDING_MANIFESTS[@]} == 0)); then
        printf '' | sha256sum | awk '{print $1}'
        return
    fi

    for manifest in "${ONBOARDING_MANIFESTS[@]}"; do
        jq -cS . "$manifest"
    done | LC_ALL=C sort | sha256sum | awk '{print $1}'
}

safe_onboarding_file() {
    local root="$1"
    local relative="$2"
    local candidate resolved

    validate_onboarding_relative_path "$relative" || return 1
    candidate="$root/$relative"
    [[ -f "$candidate" && ! -L "$candidate" ]] || return 1
    [[ "$(stat -c '%h' -- "$candidate")" == 1 ]] || return 1
    resolved="$(realpath -e -- "$candidate")" || return 1
    [[ "$resolved" == "$root/"* ]] || return 1
    printf '%s\n' "$resolved"
}

prepare_onboarding_parent() {
    local root="$1"
    local relative="$2"
    local parent component current

    validate_onboarding_relative_path "$relative" ||
        die "Unsafe onboarding destination path: $relative"
    parent="${relative%/*}"
    [[ "$parent" != "$relative" ]] || return 0
    current="$root"
    IFS='/' read -r -a parent_parts <<<"$parent"
    for component in "${parent_parts[@]}"; do
        current="$current/$component"
        if [[ -e "$current" || -L "$current" ]]; then
            [[ -d "$current" && ! -L "$current" ]] ||
                die "Unsafe onboarding destination parent: $current"
        else
            mkdir -m 0700 -- "$current"
        fi
    done
}

apply_onboarding() {
    local source_root=""
    local manifest entry path template secret mode source_file destination

    if [[ -n "$ONBOARD_SOURCE" ]]; then
        source_root="$(canonical_dir "$ONBOARD_SOURCE")" ||
            die "Onboarding source checkout does not exist: $ONBOARD_SOURCE"
        [[ "$source_root" != "$PROJECT_PATH" ]] ||
            die "Onboarding source and destination checkouts must differ"
    fi

    for manifest in "${ONBOARDING_MANIFESTS[@]}"; do
        while IFS= read -r entry; do
            path="$(jq -r '.path' <<<"$entry")"
            template="$(jq -r '.template // empty' <<<"$entry")"
            secret="$(jq -r '.secret // false' <<<"$entry")"
            mode="$(jq -r '.mode // empty' <<<"$entry")"
            validate_onboarding_relative_path "$path" ||
                die "Unsafe onboarding path '$path' in $manifest"
            [[ -z "$template" ]] || validate_onboarding_relative_path "$template" ||
                die "Unsafe onboarding template '$template' in $manifest"
            destination="$PROJECT_PATH/$path"

            if [[ -e "$destination" || -L "$destination" ]]; then
                [[ -f "$destination" && ! -L "$destination" ]] ||
                    die "Onboarding destination exists but is not a regular file: $path"
                continue
            fi

            source_file=""
            if [[ -n "$source_root" ]]; then
                source_file="$(safe_onboarding_file "$source_root" "$path" || true)"
            fi
            if [[ -z "$source_file" && -n "$template" ]]; then
                source_file="$(safe_onboarding_file "$PROJECT_PATH" "$template" || true)"
            fi
            [[ -n "$source_file" ]] || continue

            if [[ -z "$mode" ]]; then
                if [[ "$secret" == true ]]; then
                    mode=0600
                else
                    mode=0644
                fi
            fi
            prepare_onboarding_parent "$PROJECT_PATH" "$path"
            install -m "$mode" -- "$source_file" "$destination"
            printf 'Provisioned %s from %s\n' "$path" \
                "$([[ -n "$source_root" && "$source_file" == "$source_root/"* ]] && printf source-checkout || printf template)"
        done < <(jq -c '.files[]' "$manifest")
    done
}

check_onboarding() {
    local quiet="${1:-false}"
    local manifest entry path secret destination placeholder permissions

    ONBOARDING_ISSUES=0
    for manifest in "${ONBOARDING_MANIFESTS[@]}"; do
        while IFS= read -r entry; do
            path="$(jq -r '.path' <<<"$entry")"
            secret="$(jq -r '.secret // false' <<<"$entry")"
            validate_onboarding_relative_path "$path" ||
                die "Unsafe onboarding path '$path' in $manifest"
            destination="$PROJECT_PATH/$path"
            if [[ ! -e "$destination" && ! -L "$destination" ]]; then
                ((ONBOARDING_ISSUES += 1))
                $quiet || printf 'MISSING     %s\n' "$path"
                continue
            fi
            if ! safe_onboarding_file "$PROJECT_PATH" "$path" >/dev/null; then
                ((ONBOARDING_ISSUES += 1))
                $quiet || printf 'UNSAFE      %s (must be a regular file inside the checkout)\n' "$path"
                continue
            fi
            while IFS= read -r placeholder; do
                if grep -Fq -- "$placeholder" "$destination"; then
                    ((ONBOARDING_ISSUES += 1))
                    $quiet || printf 'NEEDS-INPUT %s (contains an unresolved placeholder)\n' "$path"
                    break
                fi
            done < <(jq -r '.placeholders[]?' <<<"$entry")
            if [[ "$secret" == true ]]; then
                permissions="$(stat -c '%a' -- "$destination")" ||
                    die "Cannot inspect onboarding file permissions: $path"
                if (( (8#$permissions & 077) != 0 )); then
                    ((ONBOARDING_ISSUES += 1))
                    $quiet || printf 'PERMISSIONS %s (secret file must not grant group/other access)\n' "$path"
                fi
            fi
        done < <(jq -c '.files[]' "$manifest")
    done

    if ((ONBOARDING_ISSUES == 0)); then
        $quiet || printf "READY       project '%s' lane '%s'\n" "$PROJECT" "$LANE"
        return 0
    fi
    $quiet || printf "NEEDS-SETUP project '%s' lane '%s': %d issue(s)\n" \
        "$PROJECT" "$LANE" "$ONBOARDING_ISSUES"
    return 2
}

run_sandbox_probe() {
    local image="$1"

    # Exercise the actual host kernel, Docker seccomp policy, AppArmor
    # transition, image Bubblewrap binary, and non-root identity together. The
    # probe has no network, host mounts, or writable image root; only disposable
    # tmpfs runtime storage is writable.
    docker run --rm --pull=never \
        --network none \
        --read-only \
        --tmpfs "$TMP_TMPFS_SPEC" \
        --cap-drop=ALL \
        --security-opt=no-new-privileges \
        --security-opt "apparmor=$APPARMOR_PROFILE" \
        --security-opt "seccomp=$SECCOMP_PROFILE" \
        --user "$HOST_UID:$HOST_GID" \
        --entrypoint /bin/sh \
        "$image" \
        -c 'exec /usr/bin/bwrap "$@"' \
        codex-sandbox-probe \
        --unshare-user \
        --unshare-ipc \
        --unshare-pid \
        --unshare-net \
        --unshare-uts \
        --unshare-cgroup-try \
        --die-with-parent \
        --new-session \
        --ro-bind / / \
        --dev /dev \
        --tmpfs /proc \
        --tmpfs /tmp \
        /bin/true
}

load_doctor_module() {
    local launcher_source="${BASH_SOURCE[0]}"
    local launcher_dir doctor_module

    if command -v realpath >/dev/null 2>&1; then
        launcher_source="$(realpath -e -- "$launcher_source")" ||
            die "Cannot resolve run-codex installation path"
    fi
    launcher_dir="$(cd -P -- "$(dirname -- "$launcher_source")" && pwd)" ||
        die "Cannot resolve run-codex installation directory"
    doctor_module="$launcher_dir/run-codex-doctor.bash"

    [[ -f "$doctor_module" && -r "$doctor_module" ]] ||
        die "Missing doctor module: $doctor_module (reinstall run-codex and its companion module)"

    # shellcheck source=run-codex-doctor.bash
    source "$doctor_module"
    declare -F run_doctor >/dev/null ||
        die "Invalid doctor module: $doctor_module"
}

NEW_SESSION=false
SESSION_LIST_MODE=false
RESUME_QUERY_SET=false
RESUME_QUERY=""
IDEA_MODE=false
DOCTOR_MODE=false
PROJECT=""

case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
    --list)
        (($# == 1)) || die "--list takes no arguments"
        need git
        need realpath
        list_projects
        exit 0
        ;;
    --init)
        shift
        init_project "$@"
        exit 0
        ;;
    --rebind)
        shift
        rebind_args=()
        rebind_lane="default"
        while (($#)); do
            case "$1" in
                --lane)
                    (($# >= 2)) || die "--lane requires a lane name"
                    rebind_lane="$2"
                    shift 2
                    ;;
                --lane=*)
                    rebind_lane="${1#--lane=}"
                    shift
                    ;;
                --)
                    shift
                    rebind_args+=("$@")
                    break
                    ;;
                -*) die "Unknown --rebind option: $1" ;;
                *) rebind_args+=("$1"); shift ;;
            esac
        done
        ((${#rebind_args[@]} >= 1 && ${#rebind_args[@]} <= 2)) ||
            die "Usage: run-codex --rebind PROJECT [PATH] [--lane LANE]"
        validate_lane_name "$rebind_lane"
        rebind_project "${rebind_args[0]}" "${rebind_args[1]:-$PWD}" "$rebind_lane"
        exit 0
        ;;
    --doctor)
        DOCTOR_MODE=true
        shift
        (($# <= 1)) || die "Usage: run-codex --doctor [PROJECT]"
        PROJECT="${1:-}"
        ;;
    --idea)
        IDEA_MODE=true
        shift
        if (($# == 0)); then
            run_idea_dispatcher
            exit $?
        fi
        (($# == 1)) || die "Usage: run-codex --idea [PROJECT]"
        PROJECT="$1"
        ;;
    --internal-idea-backend)
        IDEA_MODE=true
        shift
        (($# == 1)) || die "Invalid IntelliJ backend invocation"
        [[ "$1" == /* ]] || die "IntelliJ project cwd must be absolute"
        cd -P -- "$1" || die "IntelliJ project cwd is unavailable: $1"
        PROJECT=""
        ;;
    *)
        if (($# >= 2)) && [[ "$2" == --set ]]; then
            (($# == 4)) ||
                die "Usage: run-codex PROJECT --set profile|clojure-mcp|model|reasoning VALUE"
            set_project_value "$1" default "$3" "$4"
            exit 0
        fi
        if (($# >= 4)) && [[ "$2" == --lane && "$4" == --set ]]; then
            (($# == 6)) ||
                die "Usage: run-codex PROJECT --lane LANE --set profile|clojure-mcp|model|reasoning VALUE"
            set_project_value "$1" "$3" "$5" "$6"
            exit 0
        fi
        parse_launch_args "$@"
        ;;
esac

if [[ -n "$LANE_MANAGEMENT_MODE" ]]; then
    [[ -n "$PROJECT" && "$LANE_SET" == true ]] ||
        die "Lane management requires PROJECT and an explicit --lane LANE"
    [[ -z "$ONBOARD_SOURCE" ]] || die "--from is valid only with --onboard"
    if $NEW_SESSION || $SESSION_LIST_MODE || $RESUME_QUERY_SET ||
       $REVIEW_REVISION_SET || $ONBOARD_CHECK_MODE || $ONBOARD_APPLY_MODE ||
       $SETUP_SESSION || [[ -n "$STATE_SYNC_MODE" ]] || $CODEX_PROMPT_SET ||
       ((${#CODEX_FORWARD_ARGS[@]} > 0)) ||
       ((${#CODEX_IMAGE_REQUESTS[@]} > 0)) || $IMAGE_TAG_OPTION_SET; then
        die "Lane management actions cannot be combined with launch, onboarding, or state options"
    fi
    need git
    need realpath
    need flock
    case "$LANE_MANAGEMENT_MODE" in
        create)
            create_managed_lane "$PROJECT" "$LANE" "$LANE_MANAGEMENT_REVISION"
            ;;
        import)
            import_lane_result "$PROJECT" "$LANE" "$LANE_MANAGEMENT_REVISION"
            ;;
        remove)
            remove_managed_lane "$PROJECT" "$LANE"
            ;;
        *) die "Unknown lane management action: $LANE_MANAGEMENT_MODE" ;;
    esac
    exit 0
fi

$NEW_SESSION && $RESUME_QUERY_SET &&
    die "--new and --resume are mutually exclusive"
$REVIEW_REVISION_SET && $RESUME_QUERY_SET &&
    die "--review and --resume are mutually exclusive"
$REVIEW_REVISION_SET && $SESSION_LIST_MODE &&
    die "--review and --sessions are mutually exclusive"
$REVIEW_REVISION_SET && $SETUP_SESSION &&
    die "--review and --setup are mutually exclusive"
$ONBOARD_CHECK_MODE && $ONBOARD_APPLY_MODE &&
    die "--check and --onboard are mutually exclusive"
if { $ONBOARD_CHECK_MODE || $ONBOARD_APPLY_MODE; } &&
   { $NEW_SESSION || $SESSION_LIST_MODE || $RESUME_QUERY_SET ||
     $REVIEW_REVISION_SET || $CODEX_PROMPT_SET ||
     ((${#CODEX_FORWARD_ARGS[@]} > 0)) ||
     ((${#CODEX_IMAGE_REQUESTS[@]} > 0)) || $IMAGE_TAG_OPTION_SET; }; then
    die "--check and --onboard cannot be combined with launch options"
fi
[[ -z "$ONBOARD_SOURCE" || "$ONBOARD_APPLY_MODE" == true ]] ||
    die "--from is valid only with --onboard"
if [[ -n "$STATE_SYNC_MODE" ]] &&
   { $NEW_SESSION || $SESSION_LIST_MODE || $RESUME_QUERY_SET ||
     $REVIEW_REVISION_SET || $ONBOARD_CHECK_MODE || $ONBOARD_APPLY_MODE ||
     $SETUP_SESSION || $CODEX_PROMPT_SET ||
     ((${#CODEX_FORWARD_ARGS[@]} > 0)) ||
     ((${#CODEX_IMAGE_REQUESTS[@]} > 0)) || $IMAGE_TAG_OPTION_SET; }; then
    die "State synchronization actions cannot be combined with launch or onboarding options"
fi
$SESSION_LIST_MODE && $RESUME_QUERY_SET &&
    die "--sessions and --resume are mutually exclusive"
if $SESSION_LIST_MODE &&
   { $NEW_SESSION || ((${#CODEX_FORWARD_ARGS[@]} > 0)) ||
     ((${#CODEX_IMAGE_REQUESTS[@]} > 0)) || $CODEX_PROMPT_SET ||
     $IMAGE_TAG_OPTION_SET || $REVIEW_REVISION_SET; }; then
    die "--sessions cannot be combined with launch options"
fi

if $DOCTOR_MODE; then
    load_doctor_module
    run_doctor "$PROJECT"
    exit $?
fi

((HOST_UID > 0 && HOST_GID > 0)) ||
    die "Run this command as a non-root user with a non-root primary group"

if $IDEA_MODE; then
    need jq
    if [[ "$IDEA_MCP" == 1 ]]; then
        need socat
        need setpriv
        [[ "$IDEA_MCP_PORT" =~ ^[0-9]{1,5}$ ]] &&
            ((10#$IDEA_MCP_PORT >= 1024 && 10#$IDEA_MCP_PORT <= 65535)) ||
            die "CODEX_IDEA_MCP_PORT must be an unprivileged TCP port (1024-65535)"
        IDEA_MCP_PORT="$((10#$IDEA_MCP_PORT))"
        [[ "$IDEA_MCP_PATH" =~ ^/[A-Za-z0-9._~/-]+$ ]] ||
            die "CODEX_IDEA_MCP_PATH must be an absolute URL path"
    fi
fi

# Resolve first so an unconfigured project gets useful setup instructions even
# on a new machine whose Docker setup is not complete yet.
need git
need realpath
if $REVIEW_REVISION_SET && $LANE_SET && [[ "$LANE" != default ]] &&
   [[ -n "$PROJECT" ]]; then
    need flock
    provision_missing_review_lane "$PROJECT" "$LANE" "$REVIEW_REVISION"
    seed_managed_lane_codex_home "$PROJECT" "$LANE"
fi
resolve_project "$PROJECT" "$LANE"

PROJECT="$RESOLVED_NAME"
PROJECT_PATH="$RESOLVED_PATH"
LANE="$RESOLVED_LANE"
PROFILE="$RESOLVED_PROFILE"
IMAGE="$(profile_image "$PROFILE")"
if [[ -z "${CODEX_LOCK_FILE:-}" && "$RESOLVED_STATE_MODE" == isolated ]]; then
    LOCK_FILE="$CONFIG_ROOT/locks/$PROJECT/$LANE.handoff.lock"
fi
if [[ -n "$STATE_SYNC_MODE" ]]; then
    [[ "$RESOLVED_STATE_MODE" == isolated ]] ||
        die "Lane-aware state synchronization requires isolated state; use standalone codex-push/codex-pull for this legacy global registration"
    resolve_lane_codex_home "$PROJECT" "$LANE" "$RESOLVED_STATE_MODE"
    run_lane_state_sync "$STATE_SYNC_MODE"
fi
need jq
load_onboarding_manifests "$PROJECT" "$LANE"
if $ONBOARD_APPLY_MODE; then
    apply_onboarding
    check_onboarding false
    exit $?
fi
if $ONBOARD_CHECK_MODE; then
    check_onboarding false
    exit $?
fi
if ! $SETUP_SESSION && ! check_onboarding true; then
    check_onboarding false || true
    echo "Run 'run-codex $PROJECT --lane $LANE --onboard [--from CHECKOUT]' to provision declared files," >&2
    echo "or use --setup for an isolated setup session." >&2
    exit 2
fi
resolve_lane_codex_home "$PROJECT" "$LANE" "$RESOLVED_STATE_MODE"
resolve_clojure_mcp "$PROJECT_PATH" "$RESOLVED_CLOJURE_MCP"
if [[ "$RESOLVED_GIT_LAYOUT" == linked-worktree ]]; then
    CONTAINER_PROJECT_DEFAULT="$PROJECT_PATH"
elif [[ "$LANE" == default ]]; then
    CONTAINER_PROJECT_DEFAULT="$WORKSPACE_ROOT/$PROJECT"
else
    CONTAINER_PROJECT_DEFAULT="$WORKSPACE_ROOT/$PROJECT--$LANE"
fi
resolve_codex_image_options "$CONTAINER_PROJECT_DEFAULT"

if $REVIEW_REVISION_SET; then
    [[ "$LANE" != default ]] ||
        die "--review requires a non-default isolated lane selected with --lane"
    [[ -n "$REVIEW_REVISION" && "$REVIEW_REVISION" != -* &&
       "$REVIEW_REVISION" != *$'\n'* && "$REVIEW_REVISION" != *$'\r'* ]] ||
        die "--review requires a valid Git revision"
    REVIEW_COMMIT="$(
        git -C "$PROJECT_PATH" rev-parse --verify "${REVIEW_REVISION}^{commit}" 2>/dev/null
    )" || die "Review revision is not a commit in lane '$LANE': $REVIEW_REVISION"
    [[ -z "$(git -C "$PROJECT_PATH" status --porcelain=v1 --untracked-files=no)" ]] ||
        die "Reviewer lane '$LANE' has tracked changes; preserve or discard them before reviewing an immutable revision"
    ! $CODEX_PROMPT_SET ||
        die "--review cannot be combined with --codex-option prompt=TEXT"
    CODEX_PROMPT_SET=true
    NEW_SESSION=true
    CODEX_INITIAL_PROMPT="Review immutable Git commit $REVIEW_COMMIT in this checkout. Inspect that commit and its parent diff, do not modify files or Git metadata, and report concrete findings ordered by severity with file and line references. If there are no findings, say so and state remaining test or coverage risks."
fi

# Shared lock: multiple Codex projects may run simultaneously, while
# codex-push/codex-pull take this same lock exclusively. Acquire it before any
# session-state read so a pull cannot replace the database during resolution.
need flock
mkdir -p -- "$(dirname "$LOCK_FILE")"
exec 9>"$LOCK_FILE"
if ! flock -sn 9; then
    echo "Waiting for Codex state handoff lock: $LOCK_FILE" >&2
    flock -s 9
fi

if $SESSION_LIST_MODE || $RESUME_QUERY_SET; then
    load_project_sessions "$CONTAINER_PROJECT_DEFAULT" "$CODEX_HOST_HOME"
    if $SESSION_LIST_MODE; then
        echo "Active Codex sessions for '$PROJECT':"
        print_session_rows "$SESSION_ROWS"
        exit 0
    fi
    resolve_session_query "$RESUME_QUERY"
fi

# Git identity is resolved on the host and exposed as container-local Git
# configuration. This preserves normal per-repository/global Git identity
# selection without mounting the host ~/.gitconfig, which may contain
# host-specific includes, credential helpers, signing configuration, or paths
# that do not exist inside the container. CODEX_GIT_USER_NAME and
# CODEX_GIT_USER_EMAIL can override it.
GIT_USER_NAME="${CODEX_GIT_USER_NAME:-$(git -C "$PROJECT_PATH" config --get user.name 2>/dev/null || true)}"
GIT_USER_EMAIL="${CODEX_GIT_USER_EMAIL:-$(git -C "$PROJECT_PATH" config --get user.email 2>/dev/null || true)}"

if [[ -z "$GIT_USER_NAME" || -z "$GIT_USER_EMAIL" ]]; then
    echo "WARNING: Git commit identity is not fully configured." >&2
    echo "  Set user.name and user.email in Git on the host, or export:" >&2
    echo "    CODEX_GIT_USER_NAME='Your Name'" >&2
    echo "    CODEX_GIT_USER_EMAIL='you@example.com'" >&2
    echo >&2
fi

need docker

docker info >/dev/null 2>&1 || die "Docker daemon is not available"

[[ "$APPARMOR_PROFILE" == codex-universal ]] ||
    die "Unsupported CODEX_APPARMOR_PROFILE: $APPARMOR_PROFILE (expected codex-universal)"
[[ -f "$SECCOMP_PROFILE" && -r "$SECCOMP_PROFILE" ]] || {
    echo "ERROR: Codex host sandbox policy is not installed:" >&2
    echo "  $SECCOMP_PROFILE" >&2
    echo >&2
    echo "From the codex-universal checkout, run:" >&2
    echo "  bin/setup-codex-host-security" >&2
    exit 1
}
SECCOMP_PROFILE="$(realpath -e -- "$SECCOMP_PROFILE")"

docker image inspect "$IMAGE" >/dev/null 2>&1 || {
    echo "ERROR: Required image is not available locally:" >&2
    echo "  $IMAGE" >&2
    echo >&2
    echo "Build it from the codex-universal Docker source directory with:" >&2
    echo "  ./docker-build.sh '$PROFILE'" >&2
    exit 1
}

if ! sandbox_probe_output="$(run_sandbox_probe "$IMAGE" 2>&1)"; then
    [[ -z "$sandbox_probe_output" ]] || printf '%s\n' "$sandbox_probe_output" >&2
    echo "ERROR: Bubblewrap cannot start with the installed host sandbox policy." >&2
    echo "Re-run bin/setup-codex-host-security from the codex-universal checkout." >&2
    exit 1
fi

mkdir -p "$CODEX_HOST_HOME" "$CODEX_HOST_M2" "$CONFIG_ROOT/runtime"

if [[ "$LANE" == default ]]; then
    CONTAINER_IDENTITY="$PROJECT"
else
    CONTAINER_IDENTITY="$PROJECT--$LANE"
fi
CONTAINER_BASE_NAME="codex-$CONTAINER_IDENTITY"
CONTAINER_NAME="$CONTAINER_BASE_NAME"
CONTAINER_PROJECT="$CONTAINER_PROJECT_DEFAULT"

if $IDEA_MODE || [[ "$RESOLVED_GIT_LAYOUT" == linked-worktree ]]; then
    # IDEA sends the host project path in ACP session requests. Mounting the
    # checkout at that same absolute path lets Codex and IDEA agree on file
    # references without granting access to the host path's parent directory.
    # Do not allow a registered checkout to mask container runtime paths.
    case "$PROJECT_PATH" in
        /|/bin|/bin/*|/dev|/dev/*|/etc|/etc/*|/lib|/lib/*|/lib64|/lib64/*|\
        /opt|/opt/*|/proc|/proc/*|/run|/run/*|/sbin|/sbin/*|/sys|/sys/*|\
        /usr|/usr/*|/var|/var/*)
            die "Exact-path mode cannot mount a project over a container system path: $PROJECT_PATH"
            ;;
    esac
    if [[ "$CONTAINER_HOME" == "$PROJECT_PATH" ||
          "$CONTAINER_HOME" == "$PROJECT_PATH/"* ]]; then
        die "Exact-path mode cannot mount a project over the container home: $PROJECT_PATH"
    fi
    for state_path in "$CONTAINER_HOME/.codex" "$CONTAINER_HOME/.m2"; do
        if [[ "$state_path" == "$PROJECT_PATH" ||
              "$state_path" == "$PROJECT_PATH/"* ||
              "$PROJECT_PATH" == "$state_path/"* ]]; then
            die "Exact-path project overlaps container state '$state_path': $PROJECT_PATH"
        fi
    done
    CONTAINER_PROJECT="$PROJECT_PATH"
fi

running_project_containers="$(
    docker ps \
        --filter "label=codex-universal.project=$PROJECT" \
        --filter "label=codex-universal.lane=$LANE" \
        --format '{{.Names}}'
)"

if $IDEA_MODE; then
    running_terminal="$(
        docker ps \
            --filter "label=codex-universal.project=$PROJECT" \
            --filter "label=codex-universal.lane=$LANE" \
            --filter 'label=codex-universal.mode=terminal' \
            --format '{{.Names}}'
    )"
    [[ -z "$running_terminal" ]] ||
        die "Terminal container '$running_terminal' is already using project '$PROJECT' lane '$LANE'"

    # A container with the old deterministic name may be an IDEA session from
    # the immediately preceding launcher version. Allow it only when its label
    # proves that it is an IDEA-owned instance; an unlabeled container may be
    # a terminal session and must not be interrupted.
    if docker ps --format '{{.Names}}' | grep -Fxq "$CONTAINER_BASE_NAME"; then
        existing_mode="$(
            docker inspect \
                --format '{{index .Config.Labels "codex-universal.mode"}}' \
                "$CONTAINER_BASE_NAME" 2>/dev/null || true
        )"
        [[ "$existing_mode" == idea ]] ||
            die "Container '$CONTAINER_BASE_NAME' is already running"
    fi
else
    if [[ -n "$running_project_containers" ]] ||
       docker ps --format '{{.Names}}' | grep -Fxq "$CONTAINER_BASE_NAME"; then
        die "Project '$PROJECT' lane '$LANE' already has a running agent container"
    fi
fi

# Multiple IDEA chats for one project may run concurrently. A terminal session
# remains mutually exclusive with all IDEA chats for that project.
exec 8>"$CONFIG_ROOT/runtime/$CONTAINER_IDENTITY.lock"
if $IDEA_MODE; then
    flock -sn 8 || die "A terminal agent session is already using project '$PROJECT' lane '$LANE'"
else
    flock -xn 8 || die "An IDEA agent session is already using project '$PROJECT' lane '$LANE'"
fi

docker_args=(
    run
    --rm
    --init
    --pull=never
    --read-only
    --tmpfs "$HOME_TMPFS_SPEC"
    --tmpfs "$TMP_TMPFS_SPEC"
    --cap-drop=ALL
    --security-opt=no-new-privileges
    --security-opt "apparmor=$APPARMOR_PROFILE"
    --security-opt "seccomp=$SECCOMP_PROFILE"
    --entrypoint /usr/local/bin/codex-entrypoint
)

if $IDEA_MODE; then
    # IDEA may terminate its ACP subprocess without giving the attached Docker
    # client enough time to stop the container. Keep this launcher process
    # around, record the exact container ID created by this invocation, and
    # remove only that container when the ACP process exits or is signaled.
    # Keep the path short enough for the platform Unix-socket length limit.
    # mktemp creates this directory mode 0700, so no other host user can
    # connect to the unauthenticated loopback MCP service through the relay.
    IDEA_RUNTIME_DIR="$(mktemp -d -- /tmp/codex-idea-mcp.XXXXXX)"
    IDEA_CID_FILE="$IDEA_RUNTIME_DIR/container.cid"
    IDEA_MCP_RELAY_SOCKET="$IDEA_RUNTIME_DIR/idea-mcp.sock"
    IDEA_MCP_RELAY_LOG="$IDEA_RUNTIME_DIR/idea-mcp-relay.log"
    IDEA_MCP_RELAY_PID=""
    IDEA_INSTANCE="${IDEA_RUNTIME_DIR##*.}"
    CONTAINER_NAME="$CONTAINER_BASE_NAME-idea-$IDEA_INSTANCE"

    cleanup_idea_container() {
        local status=$?
        local container_id=""
        local job_pid=""
        local relay_is_our_job=false

        trap - EXIT HUP INT TERM
        if [[ "$IDEA_MCP_RELAY_PID" =~ ^[0-9]+$ ]]; then
            # Only signal a process Bash still tracks as our background job;
            # never risk acting on a PID that exited and was later reused.
            for job_pid in $(jobs -pr); do
                if [[ "$job_pid" == "$IDEA_MCP_RELAY_PID" ]]; then
                    relay_is_our_job=true
                    break
                fi
            done
            if $relay_is_our_job; then
                kill "$IDEA_MCP_RELAY_PID" >/dev/null 2>&1 || true
            fi
            wait "$IDEA_MCP_RELAY_PID" 2>/dev/null || true
        fi
        if [[ -s "$IDEA_CID_FILE" && ! -L "$IDEA_CID_FILE" ]]; then
            container_id="$(<"$IDEA_CID_FILE")"
            if [[ "$container_id" =~ ^[0-9a-f]{64}$ ]]; then
                docker rm -f -- "$container_id" >/dev/null 2>&1 || true
            fi
        fi
        rm -f -- \
            "$IDEA_CID_FILE" \
            "$IDEA_MCP_RELAY_SOCKET" \
            "$IDEA_MCP_RELAY_LOG"
        rmdir -- "$IDEA_RUNTIME_DIR" 2>/dev/null || true
        return "$status"
    }

    trap cleanup_idea_container EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    if [[ "$IDEA_MCP" == 1 &&
          "${CODEX_TEST_SKIP_IDEA_MCP_RELAY:-0}" != 1 ]]; then
        # IDEA deliberately listens on host loopback. Bridge only that one TCP
        # port into a private per-chat Unix socket; do not publish a host port
        # or give the Codex container the host network namespace.
        RUN_CODEX_SELF="$(realpath -e -- "${BASH_SOURCE[0]}")"
        # The guard gets a parent-death signal even if IDEA kills this launcher
        # with SIGKILL. Closing the lock descriptors here prevents the relay or
        # guard from making a finished chat look permanently active.
        IDEA_LAUNCHER_PID="$BASHPID"
        setpriv --pdeathsig TERM -- \
            "$RUN_CODEX_SELF" --internal-idea-relay-guard \
            "$IDEA_LAUNCHER_PID" \
            "$IDEA_RUNTIME_DIR" \
            "$IDEA_MCP_RELAY_SOCKET" \
            "$IDEA_MCP_RELAY_LOG" \
            "$IDEA_MCP_PORT" \
            "$IDEA_CID_FILE" \
            8>&- 9>&- &
        IDEA_MCP_RELAY_PID=$!

        relay_ready=false
        for _ in {1..100}; do
            if [[ -S "$IDEA_MCP_RELAY_SOCKET" ]]; then
                relay_ready=true
                break
            fi
            kill -0 "$IDEA_MCP_RELAY_PID" 2>/dev/null || break
            sleep 0.05
        done
        if ! $relay_ready; then
            [[ ! -s "$IDEA_MCP_RELAY_LOG" ]] || cat -- "$IDEA_MCP_RELAY_LOG" >&2
            die "Failed to start the host-side IntelliJ MCP relay"
        fi
    fi

    # ACP is a line-oriented stdio protocol. Allocating a TTY or printing
    # launcher diagnostics to stdout would corrupt the protocol stream.
    docker_args+=(
        -i
        --cidfile "$IDEA_CID_FILE"
        --label codex-universal.mode=idea
        --label "codex-universal.project=$PROJECT"
        --label "codex-universal.lane=$LANE"
        --label "codex-universal.agent=$RESOLVED_AGENT"
    )
    if [[ "$IDEA_MCP" == 1 ]]; then
        docker_args+=(
            -v "$IDEA_RUNTIME_DIR:/run/codex-idea-mcp:ro"
            -e "CODEX_IDEA_MCP_RELAY_SOCKET=/run/codex-idea-mcp/idea-mcp.sock"
            -e "CODEX_IDEA_MCP_RELAY_PORT=$IDEA_MCP_PORT"
        )
    fi
else
    docker_args+=(
        -it
        --label codex-universal.mode=terminal
        --label "codex-universal.project=$PROJECT"
        --label "codex-universal.lane=$LANE"
        --label "codex-universal.agent=$RESOLVED_AGENT"
    )
fi

if [[ "$PROFILE" == cuda ]]; then
    docker_args+=(--gpus all)
fi

docker_args+=(
    --user "$HOST_UID:$HOST_GID"
    -e "HOME=$CONTAINER_HOME"
    -e "CODEX_HOME=$CONTAINER_HOME/.codex"
    -e "CODEX_UNIVERSAL_WORKFLOW=$WORKFLOW_ENABLED"
)

if $IDEA_MODE; then
    if [[ "$IDEA_MCP" == 1 ]]; then
        IDEA_MCP_URL="http://127.0.0.1:${IDEA_MCP_PORT}${IDEA_MCP_PATH}"
        IDEA_CODEX_CONFIG="$(
            jq -cn \
                --arg url "$IDEA_MCP_URL" \
                --arg home "$CONTAINER_HOME" \
                --argjson enabled_tools "$IDEA_MCP_ALLOWED_TOOLS" \
                '{
                    sandbox_mode: "workspace-write",
                    approval_policy: "on-request",
                    approvals_reviewer: "user",
                    sandbox_workspace_write: {
                        network_access: false,
                        writable_roots: [$home]
                    },
                    network: {allow_local_binding: true},
                    mcp_optional_startup_grace_ms: 5000,
                    mcp_servers: {
                        idea: {
                            url: $url,
                            enabled: true,
                            required: false,
                            enabled_tools: $enabled_tools,
                            default_tools_approval_mode: "writes",
                            startup_timeout_sec: 30,
                            tool_timeout_sec: 120
                        }
                    }
                }'
        )"
    else
        IDEA_CODEX_CONFIG="$(
            jq -cn \
                --arg home "$CONTAINER_HOME" \
                '{
                    sandbox_mode: "workspace-write",
                    approval_policy: "on-request",
                    approvals_reviewer: "user",
                    sandbox_workspace_write: {
                        network_access: false,
                        writable_roots: [$home]
                    },
                    network: {allow_local_binding: true}
                }'
        )"
    fi

    if [[ "$EFFECTIVE_CLOJURE_LSP_MCP" == 1 ]]; then
        IDEA_CODEX_CONFIG="$(
            jq -c \
                --argjson enabled_tools "$CLOJURE_LSP_MCP_ALLOWED_TOOLS" \
                '.mcp_optional_startup_grace_ms = 5000 |
                 .mcp_servers.clojure_lsp = {
                    command: "/usr/local/bin/codex-clojure-lsp-mcp",
                    args: ["clojure:clojure-lsp"],
                    enabled: true,
                    required: false,
                    enabled_tools: $enabled_tools,
                    default_tools_approval_mode: "writes",
                    startup_timeout_sec: 30,
                    tool_timeout_sec: 120
                 }' <<<"$IDEA_CODEX_CONFIG"
        )"
    fi

    docker_args+=(
        -e "CODEX_PATH=/usr/local/share/npm-global/bin/codex"
        # codex-acp calls this mode "read-only" internally but presents it as
        # "Ask for approval" and maps it to workspace-write/on-request with
        # approvals routed to the user. Its "agent" mode enables auto-review,
        # which is intentionally forbidden by the managed image policy.
        -e "INITIAL_AGENT_MODE=read-only"
        -e "NO_BROWSER=1"
        -e "CODEX_CONFIG=$IDEA_CODEX_CONFIG"
    )
fi

if [[ -n "$GIT_USER_NAME" && -n "$GIT_USER_EMAIL" ]]; then
    docker_args+=(
        -e "GIT_CONFIG_COUNT=2"
        -e "GIT_CONFIG_KEY_0=user.name"
        -e "GIT_CONFIG_VALUE_0=$GIT_USER_NAME"
        -e "GIT_CONFIG_KEY_1=user.email"
        -e "GIT_CONFIG_VALUE_1=$GIT_USER_EMAIL"
    )
fi

if [[ "$RESOLVED_GIT_LAYOUT" == linked-worktree ]]; then
    [[ "$RESOLVED_GIT_COMMON_DIR" == /* &&
       "$RESOLVED_GIT_COMMON_DIR" != / &&
       "$RESOLVED_GIT_COMMON_DIR" != *:* &&
       "$RESOLVED_GIT_COMMON_DIR" != *$'\n'* ]] ||
        die "Unsafe linked-worktree common Git path: $RESOLVED_GIT_COMMON_DIR"
    [[ "$RESOLVED_GIT_COMMON_DIR" != "$PROJECT_PATH" &&
       "$RESOLVED_GIT_COMMON_DIR" != "$PROJECT_PATH/"* &&
       "$PROJECT_PATH" != "$RESOLVED_GIT_COMMON_DIR/"* ]] ||
        die "Linked-worktree common Git metadata overlaps its checkout"
    case "$RESOLVED_GIT_COMMON_DIR" in
        /bin|/bin/*|/dev|/dev/*|/etc|/etc/*|/lib|/lib/*|/lib64|/lib64/*|\
        /opt|/opt/*|/proc|/proc/*|/run|/run/*|/sbin|/sbin/*|/sys|/sys/*|\
        /usr|/usr/*|/var|/var/*)
            die "Linked-worktree Git metadata would mask a container system path: $RESOLVED_GIT_COMMON_DIR"
            ;;
    esac
    if [[ "$RESOLVED_GIT_COMMON_DIR" == "$CONTAINER_HOME" ||
          "$RESOLVED_GIT_COMMON_DIR" == "$CONTAINER_HOME/"* ||
          "$CONTAINER_HOME" == "$RESOLVED_GIT_COMMON_DIR/"* ]]; then
        die "Linked-worktree Git metadata overlaps the container home: $RESOLVED_GIT_COMMON_DIR"
    fi
    # Linked-worktree pointer files contain absolute host paths. The checkout
    # therefore stays at its exact path and receives only its common Git
    # metadata as one additional mount. Other worktree contents are not
    # exposed. Git metadata writes remain behind the human approval boundary.
    docker_args+=(
        -v "$RESOLVED_GIT_COMMON_DIR:$RESOLVED_GIT_COMMON_DIR"
    )
fi

docker_args+=(
    -v "$CODEX_HOST_HOME:$CONTAINER_HOME/.codex"
    -v "$CODEX_HOST_M2:$CONTAINER_HOME/.m2"
    -v "$PROJECT_PATH:$CONTAINER_PROJECT"
    -w "$CONTAINER_PROJECT"
    --name "$CONTAINER_NAME"
    "$IMAGE"
)

# Routine commands and working-tree edits run without prompts inside the
# project and container home. Codex protects .git and .codex recursively within
# writable roots, so any repository-metadata write must be elevated. Keep those
# approval requests routed to the human user, regardless of user-level config.
codex_args=(
    --sandbox workspace-write
    --ask-for-approval on-request
    -c 'approvals_reviewer="user"'
    -c "sandbox_workspace_write.network_access=false"
    -c "sandbox_workspace_write.writable_roots=[\"$CONTAINER_HOME\"]"
    # This permits only container-local listeners such as the nREPL helper;
    # external network access remains disabled above.
    -c 'network.allow_local_binding=true'
)

if ! $IDEA_MODE && [[ "$EFFECTIVE_CLOJURE_LSP_MCP" == 1 ]]; then
    codex_args+=(
        -c 'mcp_servers.clojure_lsp.command="/usr/local/bin/codex-clojure-lsp-mcp"'
        -c 'mcp_servers.clojure_lsp.args=["clojure:clojure-lsp"]'
        -c 'mcp_servers.clojure_lsp.enabled=true'
        -c 'mcp_servers.clojure_lsp.required=false'
        -c "mcp_servers.clojure_lsp.enabled_tools=$CLOJURE_LSP_MCP_ALLOWED_TOOLS"
        -c 'mcp_servers.clojure_lsp.default_tools_approval_mode="writes"'
        -c 'mcp_servers.clojure_lsp.startup_timeout_sec=30'
        -c 'mcp_servers.clojure_lsp.tool_timeout_sec=120'
    )
fi

if $IDEA_MODE; then
    echo "Starting IntelliJ ACP agent for '$PROJECT'" >&2
elif $REVIEW_REVISION_SET; then
    echo "Starting $RESOLVED_AGENT reviewer for '$PROJECT' lane '$LANE' at '$REVIEW_COMMIT'"
elif $NEW_SESSION; then
    echo "Starting new $RESOLVED_AGENT session for '$PROJECT' lane '$LANE'"
elif $RESUME_QUERY_SET; then
    echo "Resuming $RESOLVED_AGENT session '$RESOLVED_SESSION_NAME' for '$PROJECT' lane '$LANE'"
else
    echo "Resuming last $RESOLVED_AGENT session for '$PROJECT' lane '$LANE'"
fi

if $IDEA_MODE; then
    echo "  profile: $PROFILE" >&2
    echo "  image:   $IMAGE" >&2
    echo "  lane:    $LANE ($RESOLVED_AGENT; $RESOLVED_STATE_MODE state)" >&2
    echo "  project: $PROJECT_PATH -> $CONTAINER_PROJECT" >&2
    if [[ "$EFFECTIVE_CLOJURE_LSP_MCP" == 1 ]]; then
        echo "  Clojure MCP: enabled ($EFFECTIVE_CLOJURE_LSP_MCP_REASON)" >&2
    else
        echo "  Clojure MCP: disabled ($EFFECTIVE_CLOJURE_LSP_MCP_REASON)" >&2
    fi
    echo "  policy:  workspace-write; human approval; no full-access mode" >&2
else
    echo "  profile: $PROFILE"
    echo "  image:   $IMAGE"
    echo "  lane:    $LANE ($RESOLVED_AGENT; $RESOLVED_STATE_MODE state)"
    echo "  project: $PROJECT_PATH -> $CONTAINER_PROJECT"
    if [[ "$EFFECTIVE_CLOJURE_LSP_MCP" == 1 ]]; then
        echo "  Clojure MCP: enabled ($EFFECTIVE_CLOJURE_LSP_MCP_REASON)"
    else
        echo "  Clojure MCP: disabled ($EFFECTIVE_CLOJURE_LSP_MCP_REASON)"
    fi
    echo "  policy:  workspace-write; Git metadata and network writes need your approval"
fi

# The launcher selects the portable-user entrypoint explicitly. Terminal mode
# then supplies "codex" plus its arguments; IDEA mode supplies the ACP adapter.
# The CUDA wrapper runs NVIDIA initialization before either command.
if $IDEA_MODE; then
    docker "${docker_args[@]}" /usr/local/bin/codex-acp-entrypoint
else
    case "$RESOLVED_AGENT" in
        codex)
            session_args=(codex "${codex_args[@]}")
            ;;
        *)
            die "No container adapter is installed for agent '$RESOLVED_AGENT'"
            ;;
    esac
    if $RESUME_QUERY_SET; then
        session_args+=(resume "$RESOLVED_SESSION_ID")
    elif ! $NEW_SESSION; then
        session_args+=(resume --last)
    fi
    if ! $CODEX_MODEL_SET && [[ -n "$RESOLVED_MODEL" ]]; then
        session_args+=(--model "$RESOLVED_MODEL")
    fi
    if ! $CODEX_REASONING_SET && [[ -n "$RESOLVED_REASONING" ]]; then
        session_args+=(-c "model_reasoning_effort=\"$RESOLVED_REASONING\"")
    fi
    session_args+=("${CODEX_FORWARD_ARGS[@]}")
    if $CODEX_PROMPT_SET; then
        session_args+=(-- "$CODEX_INITIAL_PROMPT")
    fi
    exec docker "${docker_args[@]}" "${session_args[@]}"
fi
