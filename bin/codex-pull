#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

CODEX_DIR="${CODEX_DIR:-$HOME/.codex}"
SYNC_DIR="${CODEX_SYNC_DIR:-$HOME/Seafile/CodexSync}"
LOCK_FILE="${CODEX_LOCK_FILE:-$HOME/.cache/codex-handoff.lock}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/codex-handoff"
BASE_FILE="$STATE_DIR/base.state"
CONTAINER_PROJECT="${CODEX_CONTAINER_PROJECT:-}"
CONTAINER_LANE="${CODEX_CONTAINER_LANE:-}"
HANDOFF_PROJECT="${CODEX_HANDOFF_PROJECT:-}"
HANDOFF_LANE="${CODEX_HANDOFF_LANE:-}"
HANDOFF_COMMIT="${CODEX_HANDOFF_COMMIT:-}"
HANDOFF_RUNTIME_PROFILE="${CODEX_HANDOFF_RUNTIME_PROFILE:-}"
HANDOFF_RUNTIME_VERSION="${CODEX_HANDOFF_RUNTIME_VERSION:-}"
HANDOFF_RUNTIME_REVISION="${CODEX_HANDOFF_RUNTIME_REVISION:-}"
HANDOFF_ONBOARDING_SHA256="${CODEX_HANDOFF_ONBOARDING_SHA256:-}"
HANDOFF_READY="${CODEX_HANDOFF_READY:-}"

usage() {
    cat <<'USAGE'
Usage:
  codex-pull
  codex-pull --list
  codex-pull --force GENERATION

Commands:
  (no arguments)       Restore the newest generation when local state has not
                       diverged from the local baseline
  --list               List available recovery generations
  --force GENERATION   Preserve the current Codex directory and restore the
                       selected generation even if local state has changed
USAGE
}

die() {
    echo "ERROR: $*" >&2
    exit 1
}

need() {
    command -v "$1" >/dev/null 2>&1 || die "Missing command: $1"
}

MODE=pull
WANTED_GEN=""

case "${1:-}" in
    '')
        (($# == 0)) || die "Unexpected arguments"
        ;;
    -h|--help)
        (($# == 1)) || die "--help takes no arguments"
        usage
        exit 0
        ;;
    --list)
        (($# == 1)) || die "--list takes no arguments"
        MODE=list
        ;;
    --force)
        (($# == 2)) || die "Usage: codex-pull --force GENERATION"
        [[ "$2" =~ ^[0-9]+$ ]] || die "Generation must be a positive integer"
        WANTED_GEN=$((10#$2))
        ((WANTED_GEN > 0)) || die "Generation must be a positive integer"
        MODE=force
        ;;
    *)
        usage >&2
        die "Unknown option: $1"
        ;;
esac

for cmd in sha256sum awk sort tr basename realpath dirname; do
    need "$cmd"
done

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=bin/codex-sync-lib
source "$SCRIPT_DIR/codex-sync-lib"

HANDOFF_ENABLED=false
validate_handoff_context() {
    local values=(
        "$HANDOFF_PROJECT"
        "$HANDOFF_LANE"
        "$HANDOFF_COMMIT"
        "$HANDOFF_RUNTIME_PROFILE"
        "$HANDOFF_RUNTIME_VERSION"
        "$HANDOFF_RUNTIME_REVISION"
        "$HANDOFF_ONBOARDING_SHA256"
        "$HANDOFF_READY"
    )
    local value present=0

    for value in "${values[@]}"; do
        [[ -z "$value" ]] || ((present += 1))
    done
    ((present > 0)) || return 0
    ((present == ${#values[@]})) ||
        die "Incomplete lane handoff context"

    valid_handoff_id "$HANDOFF_PROJECT" || die "Invalid handoff project"
    valid_handoff_id "$HANDOFF_LANE" || die "Invalid handoff lane"
    valid_required_commit "$HANDOFF_COMMIT" ||
        die "Invalid handoff required commit"
    valid_handoff_id "$HANDOFF_RUNTIME_PROFILE" ||
        die "Invalid handoff runtime profile"
    valid_runtime_value "$HANDOFF_RUNTIME_VERSION" ||
        die "Invalid handoff runtime version"
    [[ "$HANDOFF_RUNTIME_REVISION" =~ ^[0-9a-f]{7,64}$ ]] ||
        die "Invalid handoff runtime revision"
    valid_hash "$HANDOFF_ONBOARDING_SHA256" ||
        die "Invalid handoff onboarding contract hash"
    [[ "$HANDOFF_READY" == 1 ]] ||
        die "Destination lane onboarding is not ready for handoff"
    HANDOFF_ENABLED=true
}

if [[ "$MODE" != list ]]; then
    validate_handoff_context
fi

normalize_path() {
    local variable="$1"
    local value="${!variable}"
    local normalized

    [[ "$value" == /* ]] || die "$variable must be an absolute path: $value"
    normalized="$(realpath -m -- "$value")" || die "Cannot resolve $variable: $value"
    [[ "$normalized" != / ]] || die "$variable must not be the filesystem root"
    printf -v "$variable" '%s' "$normalized"
}

paths_overlap() {
    [[ "$1" == "$2" || "$1" == "$2/"* || "$2" == "$1/"* ]]
}

validate_paths() {
    normalize_path CODEX_DIR
    normalize_path SYNC_DIR
    normalize_path STATE_DIR
    normalize_path LOCK_FILE

    paths_overlap "$CODEX_DIR" "$SYNC_DIR" &&
        die "CODEX_DIR and CODEX_SYNC_DIR must not overlap"
    paths_overlap "$CODEX_DIR" "$STATE_DIR" &&
        die "CODEX_DIR and XDG_STATE_HOME/codex-handoff must not overlap"
    paths_overlap "$SYNC_DIR" "$STATE_DIR" &&
        die "CODEX_SYNC_DIR and XDG_STATE_HOME/codex-handoff must not overlap"

    for directory in "$CODEX_DIR" "$SYNC_DIR" "$STATE_DIR"; do
        paths_overlap "$LOCK_FILE" "$directory" &&
            die "CODEX_LOCK_FILE must be separate from Codex data directories"
    done

    BASE_FILE="$STATE_DIR/base.state"
}

validate_paths
mkdir -p "$SYNC_DIR" "$STATE_DIR" "$(dirname "$LOCK_FILE")"

state_hash_dir() {
    local dir="$1"

    LC_ALL=C tar \
        --sort=name \
        --format=gnu \
        --mtime='@0' \
        --owner=0 \
        --group=0 \
        --numeric-owner \
        -C "$dir" \
        -cf - . |
        sha256sum |
        awk '{print $1}'
}

check_sqlite() {
    local dir="$1"
    local db check_dir db_copy result sidecar

    while IFS= read -r -d '' db; do
        [[ -r "$db" ]] || die "Could not inspect file for SQLite data: $db"
        if [[ "$db" != *.sqlite ]] &&
           ! LC_ALL=C head -c 15 -- "$db" | grep -Fqx 'SQLite format 3'; then
            continue
        fi

        echo "  checking $(basename "$db")"

        check_dir="$(mktemp -d "$STATE_DIR/.sqlite-check.XXXXXX")" ||
            die "Could not create SQLite validation directory"
        db_copy="$check_dir/$(basename "$db")"
        if ! cp -- "$db" "$db_copy"; then
            rm -rf -- "$check_dir"
            die "Could not copy SQLite database for validation: $db"
        fi

        for sidecar in "$db-journal" "$db-wal" "$db-shm"; do
            [[ -e "$sidecar" || -L "$sidecar" ]] || continue
            if [[ ! -f "$sidecar" || -L "$sidecar" ]] ||
               ! cp -- "$sidecar" "$check_dir/$(basename "$sidecar")"; then
                rm -rf -- "$check_dir"
                die "Could not safely copy SQLite sidecar for validation: $sidecar"
            fi
        done

        if ! result="$(sqlite3 "$db_copy" 'PRAGMA integrity_check;')"; then
            rm -rf -- "$check_dir"
            die "SQLite check failed: $db"
        fi

        rm -rf -- "$check_dir" ||
            die "Could not remove SQLite validation directory: $check_dir"

        [[ "$result" == "ok" ]] ||
            die "SQLite corruption detected in $db: $result"
    done < <(find "$dir" -type f -print0)
}

BASE_GEN=""
BASE_HASH=""

read_base() {
    [[ -f "$BASE_FILE" ]] || return 1

    local generation hash
    generation="$(state_value "$BASE_FILE" generation)"
    hash="$(state_value "$BASE_FILE" sha256)"

    [[ "$generation" =~ ^[0-9]+$ ]] ||
        die "Invalid generation in $BASE_FILE"
    valid_hash "$hash" || die "Invalid hash in $BASE_FILE"

    BASE_GEN=$((10#$generation))
    BASE_HASH="$hash"
}

write_base() {
    local generation="$1"
    local hash="$2"
    local tmp="$BASE_FILE.tmp.$$"

    {
        echo "generation=$generation"
        echo "sha256=$hash"
    } > "$tmp"

    mv -- "$tmp" "$BASE_FILE"
}

REMOTE_GEN=""
REMOTE_HASH=""

load_latest_metadata() {
    local max_gen=-1
    local max_hash=""
    local found=false
    local state_file generation hash
    local restore_nullglob=false

    if ! shopt -q nullglob; then
        shopt -s nullglob
        restore_nullglob=true
    fi
    local files=("$SYNC_DIR"/codex-g*.tar.zst.state)
    if $restore_nullglob; then
        shopt -u nullglob
    fi

    ((${#files[@]})) || return 1

    for state_file in "${files[@]}"; do
        generation="$(state_value "$state_file" generation)"
        hash="$(state_value "$state_file" sha256)"

        [[ "$generation" =~ ^[0-9]+$ ]] || continue
        valid_hash "$hash" || continue

        generation=$((10#$generation))

        if ((generation > max_gen)); then
            max_gen="$generation"
            max_hash="$hash"
            found=true
        elif ((generation == max_gen)); then
            [[ "$hash" == "$max_hash" ]] ||
                die "DIVERGENCE: generation $generation has multiple different states"
        fi
    done

    $found || return 1

    REMOTE_GEN="$max_gen"
    REMOTE_HASH="$max_hash"
}

SELECTED_ARCHIVE=""
SELECTED_HASH=""
SELECTED_STATE_FILE=""

archive_is_valid() {
    local state_file="$1"

    snapshot_archive_is_valid "$state_file" "$SYNC_DIR" || return 1
    SELECTED_ARCHIVE="$SNAPSHOT_ARCHIVE_PATH"
    SELECTED_STATE_FILE="$state_file"
}

select_snapshot() {
    local wanted="$1"
    local expected_hash=""
    local matched=false
    local valid=false
    local state_file generation hash
    local restore_nullglob=false

    SELECTED_ARCHIVE=""
    SELECTED_HASH=""
    SELECTED_STATE_FILE=""

    if ! shopt -q nullglob; then
        shopt -s nullglob
        restore_nullglob=true
    fi
    local files=("$SYNC_DIR"/codex-g*.tar.zst.state)
    if $restore_nullglob; then
        shopt -u nullglob
    fi

    for state_file in "${files[@]}"; do
        generation="$(state_value "$state_file" generation)"
        hash="$(state_value "$state_file" sha256)"

        [[ "$generation" =~ ^[0-9]+$ ]] || continue
        valid_hash "$hash" || continue

        generation=$((10#$generation))
        ((generation == wanted)) || continue
        matched=true

        if [[ -z "$expected_hash" ]]; then
            expected_hash="$hash"
        elif [[ "$hash" != "$expected_hash" ]]; then
            die "DIVERGENCE: generation $wanted has multiple different states"
        fi

        if archive_is_valid "$state_file"; then
            valid=true
        fi
    done

    $matched || return 1
    $valid || return 2

    SELECTED_HASH="$expected_hash"
}

validate_selected_handoff() {
    snapshot_metadata_is_valid "$SELECTED_STATE_FILE" ||
        die "Selected snapshot metadata is invalid: $SELECTED_STATE_FILE"

    if [[ -z "$SNAPSHOT_HANDOFF_FORMAT" ]]; then
        if $HANDOFF_ENABLED; then
            echo "WARNING: selected legacy snapshot has no lane handoff requirements." >&2
        fi
        return 0
    fi

    $HANDOFF_ENABLED ||
        die "Snapshot contains lane handoff metadata; use the lane-aware run-codex command"
    [[ "$SNAPSHOT_PROJECT" == "$HANDOFF_PROJECT" &&
       "$SNAPSHOT_LANE" == "$HANDOFF_LANE" ]] ||
        die "Snapshot belongs to project '$SNAPSHOT_PROJECT' lane '$SNAPSHOT_LANE'"
    [[ "$SNAPSHOT_REQUIRED_COMMIT" == "$HANDOFF_COMMIT" ]] ||
        die "Destination checkout must be at required commit $SNAPSHOT_REQUIRED_COMMIT (currently $HANDOFF_COMMIT)"
    [[ "$SNAPSHOT_RUNTIME_PROFILE" == "$HANDOFF_RUNTIME_PROFILE" ]] ||
        die "Destination runtime profile must be '$SNAPSHOT_RUNTIME_PROFILE'"
    [[ "$SNAPSHOT_RUNTIME_VERSION" == "$HANDOFF_RUNTIME_VERSION" &&
       "$SNAPSHOT_RUNTIME_REVISION" == "$HANDOFF_RUNTIME_REVISION" ]] ||
        die "Destination runtime must match version $SNAPSHOT_RUNTIME_VERSION revision $SNAPSHOT_RUNTIME_REVISION"
    [[ "$SNAPSHOT_ONBOARDING_SHA256" == "$HANDOFF_ONBOARDING_SHA256" ]] ||
        die "Destination onboarding declarations do not match the snapshot handoff contract"
}

select_or_die() {
    local generation="$1"
    local result

    if select_snapshot "$generation"; then
        return 0
    else
        result=$?
    fi

    if ((result == 1)); then
        die "Generation $generation does not exist"
    fi

    die "Generation $generation is incomplete or has a failed archive checksum; synchronization may still be in progress"
}

list_snapshots() {
    local state_file generation hash created host archive status requirements
    local restore_nullglob=false

    if ! shopt -q nullglob; then
        shopt -s nullglob
        restore_nullglob=true
    fi
    local files=("$SYNC_DIR"/codex-g*.tar.zst.state)
    if $restore_nullglob; then
        shopt -u nullglob
    fi

    if ((${#files[@]} == 0)); then
        echo "No Codex snapshots found in $SYNC_DIR"
        return 0
    fi

    printf '%-12s %-17s %-20s %-10s %-42s %s\n' \
        "GENERATION" "CREATED" "HOST" "STATUS" "REQUIREMENTS" "ARCHIVE"

    while IFS= read -r state_file; do
        generation="$(state_value "$state_file" generation)"
        hash="$(state_value "$state_file" sha256)"
        created="$(state_value "$state_file" created)"
        host="$(state_value "$state_file" host)"
        archive="$(state_value "$state_file" archive)"
        status="INVALID"
        requirements="-"

        if [[ "$generation" =~ ^[0-9]+$ ]] && valid_hash "$hash" &&
           archive_is_valid "$state_file"; then
            status="OK"
            if [[ -n "$SNAPSHOT_HANDOFF_FORMAT" ]]; then
                requirements="${SNAPSHOT_PROJECT}/${SNAPSHOT_LANE} ${SNAPSHOT_REQUIRED_COMMIT:0:12} ${SNAPSHOT_RUNTIME_PROFILE}:${SNAPSHOT_RUNTIME_VERSION}@${SNAPSHOT_RUNTIME_REVISION:0:12}"
            fi
        fi

        printf '%-12s %-17s %-20s %-10s %-42s %s\n' \
            "${generation:--}" "${created:--}" "${host:--}" "$status" \
            "$requirements" "${archive:--}"
    done < <(printf '%s\n' "${files[@]}" | LC_ALL=C sort)
}

if [[ "$MODE" == list ]]; then
    list_snapshots
    exit 0
fi

running_codex_containers() {
    command -v docker >/dev/null 2>&1 || return 0
    if [[ -n "$CONTAINER_PROJECT" || -n "$CONTAINER_LANE" ]]; then
        [[ "$CONTAINER_PROJECT" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ &&
           "$CONTAINER_LANE" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] ||
            die "CODEX_CONTAINER_PROJECT and CODEX_CONTAINER_LANE must both be safe non-empty identifiers"
        docker ps \
            --filter "label=codex-universal.project=$CONTAINER_PROJECT" \
            --filter "label=codex-universal.lane=$CONTAINER_LANE" \
            --format '{{.Names}}' 2>/dev/null || true
    else
        docker ps --format '{{.Names}}' 2>/dev/null |
            grep '^codex-' || true
    fi
}

report_running_codex_containers() {
    local running

    running="$(running_codex_containers)"
    [[ -n "$running" ]] || return 1

    echo "Running Codex Docker containers:" >&2
    while IFS= read -r container; do
        printf '  %s\n' "$container" >&2
    done <<< "$running"
    return 0
}

for cmd in tar zstd find grep head cp sqlite3 lsof flock hostname; do
    need "$cmd"
done

[[ -d "$CODEX_DIR" ]] || die "$CODEX_DIR does not exist"

# Exclusive against codex-push and shared locks held by run-codex.
if report_running_codex_containers; then
    die "Stop the listed Codex session(s) before pulling"
fi

exec 9>"$LOCK_FILE"
if ! flock -n -x 9; then
    report_running_codex_containers || true
    die "Codex is running, starting, or another push/pull is active"
fi

if lsof +D "$CODEX_DIR" >/dev/null 2>&1; then
    echo "Open files under $CODEX_DIR:" >&2
    lsof +D "$CODEX_DIR" >&2 || true
    die "Stop Codex first"
fi

if report_running_codex_containers; then
    die "Stop the listed Codex session(s) before pulling"
fi

HAVE_BASE=false
if [[ "$MODE" == force ]]; then
    echo "Forced recovery: skipping validation of the local Codex state."
else
    echo "Checking local SQLite databases..."
    check_sqlite "$CODEX_DIR"

    echo "Calculating local state..."
    LOCAL_HASH="$(state_hash_dir "$CODEX_DIR")"

    if read_base; then
        HAVE_BASE=true
    fi
fi

load_latest_metadata || die "No remote Codex snapshots found in $SYNC_DIR"

if [[ "$MODE" == force ]]; then
    # Forced recovery depends only on the requested generation. The remote
    # head may still be arriving through the synchronization provider.
    select_or_die "$WANTED_GEN"
    validate_selected_handoff
else
    # The normal forward path must restore a complete, checksum-valid head.
    select_or_die "$REMOTE_GEN"
    validate_selected_handoff
    LATEST_ARCHIVE="$SELECTED_ARCHIVE"

    if $HAVE_BASE; then
        ((REMOTE_GEN >= BASE_GEN)) ||
            die "Remote generation $REMOTE_GEN is older than local baseline $BASE_GEN. Refusing."

        if ((REMOTE_GEN == BASE_GEN)); then
            [[ "$REMOTE_HASH" == "$BASE_HASH" ]] ||
                die "DIVERGENCE: remote generation $REMOTE_GEN differs from local baseline"

            if [[ "$LOCAL_HASH" == "$BASE_HASH" ]]; then
                echo "No changes. Codex state already matches generation $REMOTE_GEN."
                exit 0
            fi

            die "Local Codex state changed since generation $BASE_GEN. Run codex-push, or use --force only if remote state should replace it."
        fi

        [[ "$LOCAL_HASH" == "$BASE_HASH" ]] ||
            die "DIVERGENCE: remote advanced to generation $REMOTE_GEN and local Codex also changed"
    else
        if [[ "$LOCAL_HASH" == "$REMOTE_HASH" ]]; then
            write_base "$REMOTE_GEN" "$REMOTE_HASH"
            echo "No changes. Adopted generation $REMOTE_GEN as local baseline."
            exit 0
        fi

        die "Remote generation $REMOTE_GEN exists but this machine has no baseline. Use 'codex-pull --force $REMOTE_GEN' if remote state should replace the local directory."
    fi

    # The normal forward path always restores the newest valid snapshot.
    SELECTED_ARCHIVE="$LATEST_ARCHIVE"
    SELECTED_HASH="$REMOTE_HASH"
    WANTED_GEN="$REMOTE_GEN"
fi

CODEX_PARENT="$(dirname "$CODEX_DIR")"
CODEX_NAME="$(basename "$CODEX_DIR")"
RESTORE_TMP="$(mktemp -d "$CODEX_PARENT/.${CODEX_NAME}.restore.XXXXXX")"

cleanup() {
    if [[ -n "${RESTORE_TMP:-}" && -d "$RESTORE_TMP" ]]; then
        rm -rf -- "$RESTORE_TMP"
    fi
}
trap cleanup EXIT

echo "Extracting generation $WANTED_GEN..."
zstd -q -d -c "$SELECTED_ARCHIVE" |
    tar -xf - \
        --no-same-owner \
        --same-permissions \
        --transform='s,^\.$,content,rSH' \
        --transform='s,^\./,content/,rSH' \
        -C "$RESTORE_TMP"

[[ -d "$RESTORE_TMP/content" ]] ||
    die "Generation $WANTED_GEN archive has no Codex directory"

RESTORED_HASH="$(state_hash_dir "$RESTORE_TMP/content")"
[[ "$RESTORED_HASH" == "$SELECTED_HASH" ]] ||
    die "Restored state hash does not match generation $WANTED_GEN"

echo "Checking restored SQLite databases..."
check_sqlite "$RESTORE_TMP/content"

timestamp="$(date -u '+%Y%m%dT%H%M%SZ')"
nonce="$(printf '%04x%04x' "$RANDOM" "$RANDOM")"
BACKUP_DIR="$CODEX_PARENT/${CODEX_NAME}.backup-${timestamp}-${nonce}"

mv -- "$CODEX_DIR" "$BACKUP_DIR"
if ! mv -- "$RESTORE_TMP/content" "$CODEX_DIR"; then
    if mv -- "$BACKUP_DIR" "$CODEX_DIR"; then
        die "Could not install restored state; original directory restored from $BACKUP_DIR"
    fi

    die "Could not install restored state and rollback failed; original directory remains at $BACKUP_DIR and $CODEX_DIR is unavailable"
fi

RESTORE_TMP=""

# Baseline the newest remote generation, not necessarily the selected one.
# After forcing an older generation this makes the next push publish the
# recovered contents as REMOTE_GEN + 1 without moving history backwards.
write_base "$REMOTE_GEN" "$REMOTE_HASH"

echo
echo "Restored Codex generation $WANTED_GEN."
echo "  backup: $BACKUP_DIR"

if ((WANTED_GEN < REMOTE_GEN)); then
    echo
    echo "The remote head remains generation $REMOTE_GEN."
    echo "Run codex-push to publish the recovered contents as a new generation."
fi
