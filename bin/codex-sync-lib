#!/usr/bin/env bash

# Shared snapshot metadata validation for codex-push and codex-pull.
# Callers provide the required awk, basename, tr, and sha256sum commands.

state_value() {
    local file="$1"
    local key="$2"

    awk -F= -v key="$key" '
        $1 == key {
            sub(/^[^=]*=/, "")
            print
            exit
        }
    ' "$file"
}

valid_hash() {
    [[ "$1" =~ ^[0-9a-f]{64}$ ]]
}

SNAPSHOT_GENERATION=""
SNAPSHOT_HASH=""
SNAPSHOT_ARCHIVE=""
SNAPSHOT_ARCHIVE_PATH=""
SNAPSHOT_STATE_FILE=""
SNAPSHOT_HANDOFF_FORMAT=""
SNAPSHOT_PROJECT=""
SNAPSHOT_LANE=""
SNAPSHOT_REQUIRED_COMMIT=""
SNAPSHOT_RUNTIME_PROFILE=""
SNAPSHOT_RUNTIME_VERSION=""
SNAPSHOT_RUNTIME_REVISION=""
SNAPSHOT_ONBOARDING_SHA256=""
SNAPSHOT_HANDOFF_IDENTITY=""

valid_handoff_id() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]
}

valid_required_commit() {
    [[ "$1" =~ ^[0-9a-f]{40}$ || "$1" =~ ^[0-9a-f]{64}$ ]]
}

valid_runtime_value() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]
}

snapshot_handoff_metadata_is_valid() {
    local state_file="$1"
    local handoff_format

    handoff_format="$(state_value "$state_file" handoff_format)"
    SNAPSHOT_HANDOFF_FORMAT="$handoff_format"
    SNAPSHOT_PROJECT=""
    SNAPSHOT_LANE=""
    SNAPSHOT_REQUIRED_COMMIT=""
    SNAPSHOT_RUNTIME_PROFILE=""
    SNAPSHOT_RUNTIME_VERSION=""
    SNAPSHOT_RUNTIME_REVISION=""
    SNAPSHOT_ONBOARDING_SHA256=""

    # Format-1 snapshots created before lane handoff metadata remain readable.
    [[ -n "$handoff_format" ]] || return 0
    [[ "$handoff_format" == 1 ]] || return 1

    SNAPSHOT_PROJECT="$(state_value "$state_file" project)"
    SNAPSHOT_LANE="$(state_value "$state_file" lane)"
    SNAPSHOT_REQUIRED_COMMIT="$(state_value "$state_file" required_commit)"
    SNAPSHOT_RUNTIME_PROFILE="$(state_value "$state_file" runtime_profile)"
    SNAPSHOT_RUNTIME_VERSION="$(state_value "$state_file" runtime_version)"
    SNAPSHOT_RUNTIME_REVISION="$(state_value "$state_file" runtime_revision)"
    SNAPSHOT_ONBOARDING_SHA256="$(state_value "$state_file" onboarding_sha256)"

    valid_handoff_id "$SNAPSHOT_PROJECT" || return 1
    valid_handoff_id "$SNAPSHOT_LANE" || return 1
    valid_required_commit "$SNAPSHOT_REQUIRED_COMMIT" || return 1
    valid_handoff_id "$SNAPSHOT_RUNTIME_PROFILE" || return 1
    valid_runtime_value "$SNAPSHOT_RUNTIME_VERSION" || return 1
    [[ "$SNAPSHOT_RUNTIME_REVISION" =~ ^[0-9a-f]{7,64}$ ]] || return 1
    valid_hash "$SNAPSHOT_ONBOARDING_SHA256" || return 1
}

snapshot_handoff_identity() {
    local state_file="$1"

    SNAPSHOT_HANDOFF_IDENTITY=""
    snapshot_handoff_metadata_is_valid "$state_file" || return 1
    if [[ -z "$SNAPSHOT_HANDOFF_FORMAT" ]]; then
        SNAPSHOT_HANDOFF_IDENTITY="legacy"
        return 0
    fi

    SNAPSHOT_HANDOFF_IDENTITY="handoff:1|project=$SNAPSHOT_PROJECT|lane=$SNAPSHOT_LANE|required_commit=$SNAPSHOT_REQUIRED_COMMIT|runtime_profile=$SNAPSHOT_RUNTIME_PROFILE|runtime_version=$SNAPSHOT_RUNTIME_VERSION|runtime_revision=$SNAPSHOT_RUNTIME_REVISION|onboarding_sha256=$SNAPSHOT_ONBOARDING_SHA256"
}

snapshot_metadata_is_valid() {
    local state_file="$1"
    local format generation hash archive

    format="$(state_value "$state_file" format)"
    generation="$(state_value "$state_file" generation)"
    hash="$(state_value "$state_file" sha256)"
    archive="$(state_value "$state_file" archive)"

    [[ "$format" == 1 ]] || return 1
    [[ "$generation" =~ ^[0-9]+$ ]] || return 1
    ((10#$generation > 0)) || return 1
    valid_hash "$hash" || return 1
    [[ -n "$archive" && "$archive" != */* ]] || return 1
    [[ "$(basename "$state_file")" == "$archive.state" ]] || return 1
    snapshot_handoff_metadata_is_valid "$state_file" || return 1

    SNAPSHOT_GENERATION=$((10#$generation))
    SNAPSHOT_HASH="$hash"
    SNAPSHOT_ARCHIVE="$archive"
    SNAPSHOT_STATE_FILE="$state_file"
    return 0
}

snapshot_archive_is_valid() {
    local state_file="$1"
    local sync_dir="$2"
    local archive_path checksum_path expected actual

    snapshot_metadata_is_valid "$state_file" || return 1

    archive_path="$sync_dir/$SNAPSHOT_ARCHIVE"
    checksum_path="$archive_path.sha256"
    [[ -f "$archive_path" && -f "$checksum_path" ]] || return 1

    expected="$(tr -d '[:space:]' < "$checksum_path")"
    valid_hash "$expected" || return 1

    actual="$(sha256sum "$archive_path" | awk '{print $1}')"
    [[ "$actual" == "$expected" ]] || return 1

    SNAPSHOT_ARCHIVE_PATH="$archive_path"
    return 0
}
