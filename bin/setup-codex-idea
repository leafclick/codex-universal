#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
ACP_FILE="${CODEX_IDEA_ACP_FILE:-$HOME/.jetbrains/acp.json}"

usage() {
    cat <<'USAGE'
Usage: setup-codex-idea

Adds one Dockerized Codex agent to the global JetBrains ACP configuration.
Each IDEA chat is routed from its requested working directory to the matching
run-codex project registration and therefore uses that project's image profile.

Environment:
  CODEX_IDEA_ACP_FILE  Override ~/.jetbrains/acp.json
  CODEX_RUN_CODEX      Override the run-codex executable recorded in ACP
USAGE
}

die() {
    echo "ERROR: $*" >&2
    exit 1
}

need() {
    command -v "$1" >/dev/null 2>&1 || die "Missing command: $1"
}

case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
esac

(($# == 0)) || {
    usage >&2
    exit 2
}

need jq
need realpath

RUN_CODEX="${CODEX_RUN_CODEX:-}"
if [[ -z "$RUN_CODEX" ]]; then
    RUN_CODEX="$(command -v run-codex 2>/dev/null || true)"
fi
if [[ -z "$RUN_CODEX" && -x "$SCRIPT_DIR/run-codex" ]]; then
    RUN_CODEX="$SCRIPT_DIR/run-codex"
fi
[[ -n "$RUN_CODEX" ]] || die "run-codex is not installed or beside this script"

RUN_CODEX="$(realpath -e -- "$RUN_CODEX")" ||
    die "Cannot resolve run-codex executable: $RUN_CODEX"
[[ -x "$RUN_CODEX" ]] || die "run-codex is not executable: $RUN_CODEX"
[[ "$ACP_FILE" == /* ]] || die "CODEX_IDEA_ACP_FILE must be an absolute path"
[[ ! -L "$ACP_FILE" ]] || die "Refusing to replace symlink: $ACP_FILE"

ACP_DIR="$(dirname -- "$ACP_FILE")"
mkdir -p -- "$ACP_DIR"

if [[ -e "$ACP_FILE" ]]; then
    [[ -f "$ACP_FILE" ]] || die "ACP configuration is not a regular file: $ACP_FILE"
    jq -e '
        type == "object" and
        ((.agent_servers == null) or (.agent_servers | type == "object"))
    ' "$ACP_FILE" >/dev/null ||
        die "ACP configuration must be a JSON object with an optional agent_servers object: $ACP_FILE"
fi

AGENT_NAME="Dockerized Codex (codex-universal)"
TMP_FILE="$(mktemp -- "$ACP_DIR/.acp.json.tmp.XXXXXX")"
cleanup() {
    rm -f -- "$TMP_FILE"
}
trap cleanup EXIT

if [[ -f "$ACP_FILE" ]]; then
    jq \
        --arg name "$AGENT_NAME" \
        --arg command "$RUN_CODEX" \
        'def managed_dockerized_codex:
            if (.value | type) != "object" then false
            else
                ((.key == "Dockerized Codex (codex-universal)") or
                 (.key | test("^Dockerized Codex \\([A-Za-z0-9][A-Za-z0-9_.-]*\\)$"))) and
                (.value.command |
                    if type == "string" then test("(^|/)run-codex$") else false end) and
                (.value.args |
                    if type == "array" then
                        ((length == 1 or length == 2) and .[0] == "--idea")
                    else false
                    end) and
                (.value.use_idea_mcp == false) and
                (.value.use_custom_mcp == false)
            end;
         .agent_servers = (
            ((.agent_servers // {}) |
                with_entries(select(managed_dockerized_codex | not))) + {
            ($name): {
                "command": $command,
                "args": ["--idea"],
                "use_idea_mcp": false,
                "use_custom_mcp": false
            }
        })' \
        "$ACP_FILE" > "$TMP_FILE"
else
    jq -n \
        --arg name "$AGENT_NAME" \
        --arg command "$RUN_CODEX" \
        '{
            "agent_servers": {
                ($name): {
                    "command": $command,
                    "args": ["--idea"],
                    "use_idea_mcp": false,
                    "use_custom_mcp": false
                }
            }
        }' > "$TMP_FILE"
fi

chmod 600 "$TMP_FILE"
mv -- "$TMP_FILE" "$ACP_FILE"
trap - EXIT

echo "Configured JetBrains ACP agent '$AGENT_NAME':"
echo "  file:    $ACP_FILE"
echo "  command: $RUN_CODEX --idea"
echo "  MCP:     private IntelliJ HTTP relay enabled; ACP host forwarding disabled"
echo "  routing: ACP session cwd -> registered run-codex project"
echo "Select '$AGENT_NAME' (not the registry-managed 'Codex') in AI Chat."
echo "Restart the IDE only if the new custom entry does not appear."
