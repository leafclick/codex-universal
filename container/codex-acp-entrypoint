#!/usr/bin/env bash
set -Eeuo pipefail

if [[ -n "${CODEX_IDEA_MCP_RELAY_SOCKET:-}" ]]; then
    relay_socket="$CODEX_IDEA_MCP_RELAY_SOCKET"
    relay_port="${CODEX_IDEA_MCP_RELAY_PORT:-64342}"

    [[ "$relay_socket" == /run/codex-idea-mcp/*.sock ]] || {
        echo "Invalid IntelliJ MCP relay socket: $relay_socket" >&2
        exit 1
    }
    [[ -S "$relay_socket" ]] || {
        echo "IntelliJ MCP relay socket is unavailable: $relay_socket" >&2
        exit 1
    }
    [[ "$relay_port" =~ ^[0-9]+$ ]] &&
        ((10#$relay_port >= 1024 && 10#$relay_port <= 65535)) || {
        echo "Invalid IntelliJ MCP relay port: $relay_port" >&2
        exit 1
    }
    command -v socat >/dev/null 2>&1 || {
        echo "Missing container command: socat" >&2
        exit 1
    }
    command -v lsof >/dev/null 2>&1 || {
        echo "Missing container command: lsof" >&2
        exit 1
    }
    command -v setpriv >/dev/null 2>&1 || {
        echo "Missing container command: setpriv" >&2
        exit 1
    }

    # Codex supports an HTTP MCP URL but not a Unix-socket URL. Expose the
    # per-chat, read-only-mounted host relay only on this container's loopback.
    setpriv --pdeathsig TERM -- socat \
        "TCP4-LISTEN:${relay_port},bind=127.0.0.1,reuseaddr,fork" \
        "UNIX-CONNECT:${relay_socket}" \
        1>&2 &
    relay_pid=$!

    relay_ready=false
    for _ in {1..100}; do
        if ! kill -0 "$relay_pid" 2>/dev/null; then
            break
        fi
        if lsof -nP -a -p "$relay_pid" \
            -iTCP:"$relay_port" -sTCP:LISTEN >/dev/null 2>&1; then
            relay_ready=true
            break
        fi
        sleep 0.02
    done
    if ! $relay_ready; then
        kill -TERM "$relay_pid" 2>/dev/null || true
        wait "$relay_pid" || true
        echo "Failed to start the container-side IntelliJ MCP relay" >&2
        exit 1
    fi
fi

exec codex-acp "$@"
