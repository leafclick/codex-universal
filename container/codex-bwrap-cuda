#!/usr/bin/env bash
set -Eeuo pipefail

real_bwrap="${CODEX_BWRAP_REAL:-/usr/bin/bwrap.real}"
[[ -x "$real_bwrap" ]] || {
    echo "Missing system Bubblewrap: $real_bwrap" >&2
    exit 127
}
test_no_devices="${CODEX_TEST_CUDA_NO_DEVICES:-0}"
case "$test_no_devices" in
    0|'') ;;
    1)
        [[ "$real_bwrap" != /usr/bin/bwrap.real ]] || {
            echo "CODEX_TEST_CUDA_NO_DEVICES requires a test Bubblewrap override" >&2
            exit 2
        }
        ;;
    *)
        echo "Invalid CODEX_TEST_CUDA_NO_DEVICES=$test_no_devices" >&2
        exit 2
        ;;
esac

rewrite_tokens() {
    local -n in_tokens="$1"
    local -n out_tokens="$2"
    local index=0
    local count="${#in_tokens[@]}"
    local current=""
    local dest=""

    while ((index < count)); do
        current="${in_tokens[index]}"

        # Keep Bubblewrap's minimal device filesystem. When the destination is
        # /dev, add back only the NVIDIA character devices and capability
        # directories that Docker exposed to this container.
        if [[ "$current" == "--dev" && $((index + 1)) -lt "$count" ]]; then
            dest="${in_tokens[index + 1]}"
            out_tokens+=(--dev "$dest")
            if [[ "$dest" == /dev && "$test_no_devices" != 1 ]]; then
                local nvidia_device=""
                for nvidia_device in /dev/nvidia*; do
                    if [[ -c "$nvidia_device" || -d "$nvidia_device" ]]; then
                        out_tokens+=(--dev-bind "$nvidia_device" "$nvidia_device")
                    fi
                done
            fi
            index=$((index + 2))
            continue
        fi

        out_tokens+=("$current")
        index=$((index + 1))
    done
}

argv=("$@")
rewritten=()
index=0
count="${#argv[@]}"

while ((index < count)); do
    current="${argv[index]}"

    if [[ "$current" == "--args" && $((index + 1)) -lt "$count" ]]; then
        fd="${argv[index + 1]}"

        fd_tokens=()
        while IFS= read -r -d '' token <&"$fd"; do
            fd_tokens+=("$token")
        done

        rewritten_fd_tokens=()
        rewrite_tokens fd_tokens rewritten_fd_tokens

        exec {new_fd}< <(
            for token in "${rewritten_fd_tokens[@]}"; do
                printf '%s\0' "$token"
            done
        )

        rewritten+=(--args "$new_fd")
        index=$((index + 2))
        continue
    fi

    rewritten+=("$current")
    index=$((index + 1))
done

final=()
rewrite_tokens rewritten final

cuda_failure_hint_enabled() {
    case "${CODEX_CUDA_FAILURE_HINT:-auto}" in
        auto|'')
            [[ ! -t 1 && ! -t 2 ]] || return 1
            [[ "$test_no_devices" != 1 ]] || return 1
            local nvidia_device=""
            for nvidia_device in /dev/nvidia*; do
                [[ -c "$nvidia_device" || -d "$nvidia_device" ]] && return 0
            done
            return 1
            ;;
        on|1|true|yes) return 0 ;;
        off|0|false|no) return 1 ;;
        *)
            echo "Invalid CODEX_CUDA_FAILURE_HINT=${CODEX_CUDA_FAILURE_HINT}" >&2
            exit 2
            ;;
    esac
}

cuda_failure_signature_present() {
    local text="$1"
    local signature_file="${CODEX_CUDA_FAILURE_SIGNATURES:-/usr/local/share/codex/cuda-failure-signatures}"
    local pattern=""

    [[ -r "$signature_file" ]] || return 1
    while IFS= read -r pattern || [[ -n "$pattern" ]]; do
        [[ -z "$pattern" || "${pattern:0:1}" == "#" ]] && continue
        if grep -Eiq -- "$pattern" <<<"$text"; then
            return 0
        fi
    done < "$signature_file"

    return 1
}

print_cuda_failure_hint() {
    cat >&2 <<'EOF'

Codex CUDA note: this command failed with output that looks like CUDA
driver/runtime initialization failure inside the Codex sandbox.

NVIDIA device nodes may be visible, but CUDA driver/runtime initialization can
fail in the inner Bubblewrap sandbox, commonly as CUDA error 304
(CUDA_ERROR_OPERATING_SYSTEM), because of PID/procfs isolation.

Retry the same GPU workload with explicit user-approved elevation.
EOF
}

run_bwrap_with_cuda_failure_hint() {
    local capture_dir=""
    local stdout_fifo=""
    local stderr_fifo=""
    local stdout_log=""
    local stderr_log=""
    local stdout_reader_pid=""
    local stderr_reader_pid=""
    local status=0
    local combined=""

    if ! capture_dir="$(mktemp -d -t codex-bwrap-capture.XXXXXX 2>/dev/null)"; then
        exec "$real_bwrap" "${final[@]}"
    fi
    stdout_fifo="$capture_dir/stdout.fifo"
    stderr_fifo="$capture_dir/stderr.fifo"
    stdout_log="$capture_dir/stdout.tail"
    stderr_log="$capture_dir/stderr.tail"
    if ! mkfifo -m 0600 -- "$stdout_fifo" "$stderr_fifo"; then
        rm -rf -- "$capture_dir" || true
        exec "$real_bwrap" "${final[@]}"
    fi

    (tee /dev/fd/3 < "$stdout_fifo" | tail -c 65536 > "$stdout_log") 3>&1 &
    stdout_reader_pid=$!
    (tee /dev/fd/3 < "$stderr_fifo" | tail -c 65536 > "$stderr_log") 3>&2 &
    stderr_reader_pid=$!

    set +e
    "$real_bwrap" "${final[@]}" > "$stdout_fifo" 2> "$stderr_fifo"
    status=$?
    wait "$stdout_reader_pid"
    wait "$stderr_reader_pid"
    set -e

    if ((status != 0)) && cuda_failure_hint_enabled; then
        combined="$(
            {
                cat "$stdout_log" 2>/dev/null
                printf '\n'
                cat "$stderr_log" 2>/dev/null
            } || true
        )"

        if cuda_failure_signature_present "$combined"; then
            print_cuda_failure_hint
        fi
    fi

    rm -rf -- "$capture_dir" || true
    return "$status"
}

if ! cuda_failure_hint_enabled; then
    exec "$real_bwrap" "${final[@]}"
fi

run_bwrap_with_cuda_failure_hint
exit $?
