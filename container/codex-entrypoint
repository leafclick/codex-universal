#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

runtime_uid="$(id -u)"
runtime_gid="$(id -g)"
readonly runtime_uid runtime_gid

if ((runtime_uid == 0 || runtime_gid == 0)); then
    echo "Refusing to run Codex with UID/GID 0" >&2
    exit 1
fi

(($# > 0)) || {
    echo "No container command was provided" >&2
    exit 1
}
[[ "${HOME:-}" == /* && "$HOME" != / &&
   "$HOME" != *:* && "$HOME" != *$'\n'* ]] || {
    echo "HOME must be an absolute path without passwd delimiters" >&2
    exit 1
}

# Preserve NVIDIA's upstream initialization as the outer wrapper around the
# requested CUDA command. It ultimately executes this script again with the
# original arguments. Generic images do not contain the NVIDIA entrypoint.
if [[ -x /opt/nvidia/nvidia_entrypoint.sh &&
      "${CODEX_NVIDIA_ENTRYPOINT_DONE:-0}" != 1 ]]; then
    export CODEX_NVIDIA_ENTRYPOINT_DONE=1
    if [[ "${1##*/}" == codex-acp-entrypoint ]]; then
        # NVIDIA's hooks print banners and driver warnings to stdout. Preserve
        # ACP's protocol-only stdout by saving it across NVIDIA's exec chain
        # and sending only the initialization prelude to stderr.
        exec 3>&1
        exec 1>&2
        export CODEX_NVIDIA_RESTORE_STDOUT=1
    fi
    exec /opt/nvidia/nvidia_entrypoint.sh "$0" "$@"
fi
if [[ -x /opt/nvidia/nvidia_entrypoint.sh ]]; then
    export CODEX_NVIDIA_ENTRYPOINT_RAN=1
fi
unset CODEX_NVIDIA_ENTRYPOINT_DONE
if [[ "${CODEX_NVIDIA_RESTORE_STDOUT:-0}" == 1 ]]; then
    exec 1>&3 3>&-
    unset CODEX_NVIDIA_RESTORE_STDOUT
fi

# Docker can run a pre-built image with any host UID/GID, but that numeric
# identity may not exist in the image's passwd database. Supply a private NSS
# view so tools that resolve the current user still see the stable "codex"
# account. The launcher provides /run/codex-runtime as a private tmpfs which
# remains visible when an inner sandbox replaces /tmp. The fallback supports
# direct image commands that do not use run-codex.
nss_parent=/run/codex-runtime
[[ -d "$nss_parent" && -w "$nss_parent" ]] || nss_parent=/tmp
readonly nss_parent
nss_dir="$(mktemp -d "$nss_parent/nss.XXXXXX")"
readonly nss_dir
readonly passwd_file="$nss_dir/passwd"
readonly group_file="$nss_dir/group"

awk -F: -v uid="$runtime_uid" '
    $1 != "codex" && $3 != uid { print }
' /etc/passwd > "$passwd_file"
printf 'codex:x:%s:%s:Codex runtime user:%s:/bin/bash\n' \
    "$runtime_uid" "$runtime_gid" "$HOME" \
    >> "$passwd_file"

awk -F: -v gid="$runtime_gid" '
    $1 != "codex" && $3 != gid { print }
' /etc/group > "$group_file"
printf 'codex:x:%s:\n' "$runtime_gid" >> "$group_file"

nss_wrapper="$({
    find /usr/lib \( -type f -o -type l \) \
        -name libnss_wrapper.so -print -quit
} 2>/dev/null)"
readonly nss_wrapper
[[ -n "$nss_wrapper" ]] || {
    echo "libnss_wrapper.so is missing from the image" >&2
    exit 1
}

export NSS_WRAPPER_PASSWD="$passwd_file"
export NSS_WRAPPER_GROUP="$group_file"
export LD_PRELOAD="$nss_wrapper${LD_PRELOAD:+:$LD_PRELOAD}"
export USER=codex
export LOGNAME=codex

exec "$@"
