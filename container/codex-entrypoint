#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

runtime_uid="$(id -u)"
runtime_gid="$(id -g)"
readonly runtime_uid runtime_gid

if ((runtime_uid == 0 || runtime_gid == 0)); then
    echo "Refusing to run Codex with UID/GID 0" >&2
    exit 1
fi

(($# > 0)) || {
    echo "No container command was provided" >&2
    exit 1
}
[[ "${HOME:-}" == /* && "$HOME" != / &&
   "$HOME" != *:* && "$HOME" != *$'\n'* ]] || {
    echo "HOME must be an absolute path without passwd delimiters" >&2
    exit 1
}
export USER=codex
export LOGNAME=codex

# Assets are canonical in the image and copied into the persistent Codex home
# only when absent or still equal to the prior managed version. This keeps
# custom agents and skills available in new sessions without replacing user
# configuration. The per-container REPL state deliberately remains in /tmp.
/usr/local/bin/codex-universal-workflow-install

# Preserve NVIDIA's upstream initialization as the outer wrapper around the
# requested CUDA command. It ultimately executes this script again with the
# original arguments. Generic images do not contain the NVIDIA entrypoint.
if [[ -x /opt/nvidia/nvidia_entrypoint.sh &&
      "${CODEX_NVIDIA_ENTRYPOINT_DONE:-0}" != 1 ]]; then
    export CODEX_NVIDIA_ENTRYPOINT_DONE=1
    if [[ "${1##*/}" == codex-acp-entrypoint ]]; then
        # NVIDIA's hooks print banners and driver warnings to stdout. Preserve
        # ACP's protocol-only stdout by saving it across NVIDIA's exec chain
        # and sending only the initialization prelude to stderr.
        exec 3>&1
        exec 1>&2
        export CODEX_NVIDIA_RESTORE_STDOUT=1
    fi
    exec /opt/nvidia/nvidia_entrypoint.sh "$0" "$@"
fi
if [[ -x /opt/nvidia/nvidia_entrypoint.sh ]]; then
    export CODEX_NVIDIA_ENTRYPOINT_RAN=1
fi
unset CODEX_NVIDIA_ENTRYPOINT_DONE
if [[ "${CODEX_NVIDIA_RESTORE_STDOUT:-0}" == 1 ]]; then
    exec 1>&3 3>&-
    unset CODEX_NVIDIA_RESTORE_STDOUT
fi

if [[ -z "${CODEX_CLOJURE_STATE_DIR:-}" ]]; then
    CODEX_CLOJURE_STATE_DIR="$(mktemp -d -- /tmp/codex-clojure.XXXXXX)"
    export CODEX_CLOJURE_STATE_DIR
else
    [[ "$CODEX_CLOJURE_STATE_DIR" == /tmp/?* &&
       "$CODEX_CLOJURE_STATE_DIR" != *$'\n'* ]] || {
        echo "CODEX_CLOJURE_STATE_DIR must be a private path below /tmp" >&2
        exit 1
    }
    canonical_state="$(realpath -m -- "$CODEX_CLOJURE_STATE_DIR")"
    [[ "$canonical_state" == /tmp/?* ]] || {
        echo "CODEX_CLOJURE_STATE_DIR must resolve below /tmp" >&2
        exit 1
    }
    mkdir -p -- "$canonical_state"
    CODEX_CLOJURE_STATE_DIR="$(realpath -e -- "$canonical_state")"
    export CODEX_CLOJURE_STATE_DIR
fi
chmod 0700 -- "$CODEX_CLOJURE_STATE_DIR"

start_clojure_repl_service() {
    local project_root state_root home_root control_path service_log supervisor
    local java_command java_binary java_home java_lib java_server_lib jvm_library_path
    local protected_root protected_path
    local -a bwrap_args

    project_root="$(pwd -P)"
    state_root="$(realpath -e -- "$CODEX_CLOJURE_STATE_DIR")"
    home_root="$(realpath -e -- "$HOME")"
    # Image/doctor probes intentionally start at /. There is no project or
    # persistent REPL to own in those diagnostic containers.
    [[ "$project_root" != / ]] || return 0
    [[ "$state_root" != / ]] || {
        echo "Unsafe Clojure state root" >&2
        exit 1
    }
    case "$state_root/" in
        "$project_root/"*|/) echo "Clojure state must not be inside the project" >&2; exit 1 ;;
    esac
    case "$project_root/" in
        "$state_root/"*) echo "Project must not be inside the Clojure state directory" >&2; exit 1 ;;
    esac

    control_path="$state_root/service-control.fifo"
    service_log="$state_root/service.log"
    supervisor="/usr/local/share/codex-universal/workflow/skills/clojure-development/scripts/clojure-process-supervisor"
    [[ -x "$supervisor" ]] || {
        echo "Clojure REPL service executable is unavailable: $supervisor" >&2
        exit 1
    }
    java_command="$(command -v java)"
    java_binary="$(readlink -f -- "$java_command")"
    java_home="$(dirname -- "$(dirname -- "$java_binary")")"
    java_lib="$java_home/lib"
    java_server_lib="$java_lib/server"
    [[ -x "$java_binary" && -d "$java_server_lib" ]] || {
        echo "Selected Java installation is incomplete: $java_binary" >&2
        exit 1
    }
    jvm_library_path="$java_lib:$java_server_lib"
    if [[ -n "${LD_LIBRARY_PATH:-}" ]]; then
        jvm_library_path+=":$LD_LIBRARY_PATH"
    fi
    bwrap_args=(
        --unshare-user
        --unshare-ipc
        --unshare-pid
        --unshare-net
        --unshare-uts
        --unshare-cgroup-try
        --die-with-parent
        --new-session
        --setenv LD_LIBRARY_PATH "$jvm_library_path"
        --ro-bind / /
        --dev /dev
        # Do not expose /proc/<pid>/root from the outer container: that path
        # could otherwise bypass this service's read-only metadata mounts.
        --tmpfs /proc
        # oneMKL resolves its internal loader relative to /proc/self/exe. Keep
        # procfs otherwise empty, but identify the JVM selected above so native
        # Clojure backends work without exposing any outer process metadata.
        --dir /proc/self
        --symlink "$java_binary" /proc/self/exe
        # The configured nREPL remains on private loopback. The supervisor
        # exposes it only through a mode-0600 pathname socket in state_root.
        --bind /tmp /tmp
        --bind "$home_root" "$home_root"
        --bind "$project_root" "$project_root"
        --bind "$state_root" "$state_root"
    )

    # Match Codex's recursive protection within every writable root. The
    # service can persist past an individual tool call, but it cannot use that
    # lifetime to write Git metadata or Codex configuration.
    for protected_root in "$home_root" "$project_root"; do
        while IFS= read -r -d '' protected_path; do
            bwrap_args+=(--ro-bind "$protected_path" "$protected_path")
        done < <(
            find "$protected_root" -xdev \
                \( -name .git -o -name .codex \) -prune -print0
        )
    done
    bwrap_args+=(--chdir "$project_root")

    bwrap "${bwrap_args[@]}" -- \
        /usr/local/bin/codex-no-nested-userns \
        "$supervisor" \
        service \
        --control "$control_path" \
        --project-root "$project_root" \
        --state-root "$state_root" \
        --namespace-scoped \
        >>"$service_log" 2>&1 &
    local service_pid=$!
    for _ in {1..250}; do
        if [[ -p "$control_path" ]]; then
            return 0
        fi
        kill -0 "$service_pid" 2>/dev/null || break
        sleep 0.02
    done
    echo "Clojure REPL service failed to start; recent log output:" >&2
    tail -c 65536 -- "$service_log" >&2 || true
    exit 1
}

if [[ "${CODEX_UNIVERSAL_WORKFLOW:-1}" == 1 ]]; then
    start_clojure_repl_service
fi

exec "$@"
