#!/usr/bin/env bash
set -Eeuo pipefail

# Local MCP servers do not inherit Codex's shell sandbox. Put the LSP bridge in
# an equivalent networkless filesystem boundary: the project and container
# home are writable, while Codex state and Git metadata stay read-only.
project_root="$(pwd -P)"
container_home="${HOME:?HOME must be set}"
java_command="$(command -v java)"
[[ "$java_command" == /* ]] || {
    echo "Refusing non-absolute Java command: $java_command" >&2
    exit 1
}
java_binary="$(readlink -f -- "$java_command")"
java_home="$(dirname -- "$(dirname -- "$java_binary")")"
java_lib="$java_home/lib"
java_server_lib="$java_lib/server"

[[ -x "$java_binary" && -d "$java_lib" && -d "$java_server_lib" ]] || {
    echo "Selected Java installation is incomplete: $java_binary" >&2
    exit 1
}

# An empty /proc prevents this Temurin launcher from discovering its own
# libjli.so path. Keep the image-selected JDK's directories first, but retain
# any image-provided library paths needed by other native tools.
jvm_library_path="$java_lib:$java_server_lib"
if [[ -n "${LD_LIBRARY_PATH:-}" ]]; then
    jvm_library_path+=":$LD_LIBRARY_PATH"
fi

[[ "$project_root" != / ]] || {
    echo "Refusing to expose the filesystem root to agent-lsp" >&2
    exit 1
}
[[ "$container_home" != / ]] || {
    echo "Refusing to expose the filesystem root as HOME to agent-lsp" >&2
    exit 1
}

bwrap_args=(
    --unshare-user
    --unshare-ipc
    --unshare-pid
    --unshare-net
    --unshare-uts
    --unshare-cgroup-try
    --die-with-parent
    --new-session
    --setenv LD_LIBRARY_PATH "$jvm_library_path"
    # JSON preserves native Location URI/range data that agent-lsp's GCF graph
    # conversion currently discards for several navigation tools.
    --setenv AGENT_LSP_OUTPUT_FORMAT json
    --ro-bind / /
    --dev /dev
    # Mounting a fresh procfs after unsharing both user and PID namespaces is
    # rejected by some hardened Docker hosts. An empty overlay keeps the
    # private PID namespace from exposing the container's outer /proc while
    # avoiding that host-dependent mount operation.
    --tmpfs /proc
    --tmpfs /tmp
    --bind "$container_home" "$container_home"
    --bind "$project_root" "$project_root"
    --ro-bind-try "$container_home/.codex" "$container_home/.codex"
)

# Match Codex's recursive protection instead of guarding only the repository
# root. This also covers nested repositories and checked-out submodules.
while IFS= read -r -d '' protected_path; do
    bwrap_args+=(--ro-bind "$protected_path" "$protected_path")
done < <(
    find "$project_root" -xdev \
        \( -name .git -o -name .codex \) -prune -print0
)

bwrap_args+=(--chdir "$project_root")

agent_args=("$@")
for index in "${!agent_args[@]}"; do
    if [[ "${agent_args[index]}" == clojure:clojure-lsp ]]; then
        agent_args[index]=clojure:/usr/local/bin/codex-lsp-message-proxy
    fi
done

if [[ "${1:-}" == --check-java ]]; then
    (($# == 1)) || {
        echo "--check-java does not accept arguments" >&2
        exit 2
    }
    exec bwrap "${bwrap_args[@]}" -- \
        /usr/local/bin/codex-no-nested-userns "$java_binary" -version
fi

exec bwrap "${bwrap_args[@]}" -- \
    /usr/local/bin/codex-no-nested-userns \
    /usr/local/share/npm-global/bin/agent-lsp "${agent_args[@]}"
