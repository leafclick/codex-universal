FROM nvidia/cuda:13.1.2-devel-ubuntu24.04

ARG DEBIAN_FRONTEND=noninteractive

ENV LANG=C.UTF-8
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=/usr/local/cuda/bin:${PATH}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Build-time CUDA sanity check. GPU access is intentionally not required at
# image-build time; this verifies the devel image contains the toolkit.
RUN nvcc --version \
    && test -f /usr/local/cuda/include/cuda.h \
    && test -f /usr/local/cuda/include/cuda_runtime.h

# Development/runtime prerequisites. Avoid exact Ubuntu package-version pins so
# security updates to Ubuntu 24.04 do not make otherwise identical builds fail.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        aggregate \
        binutils \
        bubblewrap \
        build-essential \
        bzr \
        ca-certificates \
        curl \
        default-libmysqlclient-dev \
        dnsutils \
        fd-find \
        fish \
        fzf \
        gettext \
        gh \
        git \
        git-lfs \
        gnupg \
        inotify-tools \
        iputils-ping \
        jq \
        less \
        lsof \
        libbz2-dev \
        libc6-dev \
        libcurl4-openssl-dev \
        libdb-dev \
        libedit2 \
        libffi-dev \
        libgcc-13-dev \
        libgdbm-compat-dev \
        libgdbm-dev \
        libgdiplus \
        libgssapi-krb5-2 \
        liblzma-dev \
        libncurses-dev \
        libnss3-dev \
        libpq-dev \
        libpsl-dev \
        libpython3-dev \
        libreadline-dev \
        libsqlite3-dev \
        libssl-dev \
        libstdc++-13-dev \
        libunwind8 \
        libuuid1 \
        libxml2-dev \
        libz3-dev \
        make \
        man-db \
        moreutils \
        netcat-openbsd \
        openssh-client \
        pkg-config \
        procps \
        protobuf-compiler \
        python3-minimal \
        ripgrep \
        rlwrap \
        rsync \
        software-properties-common \
        socat \
        sqlite3 \
        sudo \
        swig \
        tk-dev \
        tzdata \
        universal-ctags \
        unixodbc-dev \
        unzip \
        uuid-dev \
        wget \
        xz-utils \
        zip \
        zlib1g \
        zlib1g-dev \
        zstd \
    && rm -rf /var/lib/apt/lists/*

# Resolve any non-root runtime UID/GID as the stable codex identity through
# glibc NSS. Unlike an LD_PRELOAD shim, this does not alter native-library
# loading in JVM, CUDA, or other child processes.
COPY --chmod=0644 container/libnss_codex.c /usr/local/src/libnss_codex.c
RUN multiarch="$(gcc -print-multiarch)" \
    && gcc -std=c11 -O2 -fPIC -fstack-protector-strong \
        -D_FORTIFY_SOURCE=3 -Wall -Wextra -Werror \
        -shared -Wl,-soname,libnss_codex.so.2,-z,relro,-z,now \
        -o /tmp/libnss_codex.so.2 /usr/local/src/libnss_codex.c \
    && install -o root -g root -m 0644 /tmp/libnss_codex.so.2 \
        "/usr/lib/${multiarch}/libnss_codex.so.2" \
    && sed -ri \
        -e 's/^passwd:[[:space:]]*/passwd: codex /' \
        -e 's/^group:[[:space:]]*/group: codex /' \
        /etc/nsswitch.conf \
    && rm -f /tmp/libnss_codex.so.2 /usr/local/src/libnss_codex.c \
    && ldconfig

COPY --chmod=0644 container/codex-no-nested-userns.c /usr/local/src/codex-no-nested-userns.c
RUN gcc -std=c11 -O2 -fstack-protector-strong \
        -D_FORTIFY_SOURCE=3 -Wall -Wextra -Werror \
        -Wl,-z,relro,-z,now \
        -o /tmp/codex-no-nested-userns /usr/local/src/codex-no-nested-userns.c \
    && install -o root -g root -m 0755 /tmp/codex-no-nested-userns \
        /usr/local/bin/codex-no-nested-userns \
    && rm -f /tmp/codex-no-nested-userns /usr/local/src/codex-no-nested-userns.c

# Give the image a fixed non-root default identity. run-codex replaces this
# with the invoking host user's numeric identity and supplies a writable tmpfs
# home, so one immutable image can run on hosts with different UID/GID values.
RUN groupadd --gid 65532 codex \
    && useradd \
        --uid 65532 \
        --gid 65532 \
        --home-dir /home/codex \
        --shell /bin/bash \
        --no-create-home \
        codex

# Node.js 24.
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Installed tools are root-owned and immutable at runtime.
RUN install -d -o root -g root -m 0755 /usr/local/share/npm-global

ENV NPM_CONFIG_PREFIX=/usr/local/share/npm-global
ENV PATH=${PATH}:/usr/local/share/npm-global/bin

# Eclipse Temurin 25 JDK.
RUN install -d -m 0755 /etc/apt/keyrings \
    && wget -qO- https://packages.adoptium.net/artifactory/api/gpg/key/public \
       | gpg --dearmor -o /etc/apt/keyrings/adoptium.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb $(. /etc/os-release && echo "${VERSION_CODENAME}") main" \
       > /etc/apt/sources.list.d/adoptium.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends temurin-25-jdk \
    && rm -rf /var/lib/apt/lists/*

# Clojure CLI. Force IPv4 for the installer because some Docker/DNS setups
# have unreliable IPv6 connectivity.
RUN cd /tmp \
    && curl -4 -fsSL -o linux-install.sh \
       https://github.com/clojure/brew-install/releases/latest/download/linux-install.sh \
    && sed -i 's/curl /curl -4 /g' linux-install.sh \
    && chmod +x linux-install.sh \
    && ./linux-install.sh \
    && rm -f linux-install.sh

# Leiningen.
ENV LEIN_JAR=/opt/clojure/leiningen-standalone.jar
RUN cd /tmp \
    && wget -q https://raw.githubusercontent.com/technomancy/leiningen/stable/bin/lein \
    && chmod +x lein \
    && mv lein /usr/local/bin/lein \
    && mkdir -p /opt/clojure \
    && ln -s /usr/local/bin/lein /opt/clojure/lein \
    && lein self-install \
    && chmod 0644 "$LEIN_JAR" \
    && lein version

# deps.clj.
RUN cd /tmp \
    && wget -q https://raw.githubusercontent.com/borkdude/deps.clj/master/install \
    && bash ./install \
    && rm -f install

# Native Clojure developer tools. Keep this shared installer identical in the
# generic and CUDA images.
COPY --chmod=0755 container/install-clojure-tools /usr/local/src/install-clojure-tools
RUN /usr/local/src/install-clojure-tools \
    && rm -f /usr/local/src/install-clojure-tools

# Keep frequently changing agent packages and integration files after the
# stable Java and Clojure runtime layers so their updates preserve that cache.
ARG CODEX_VERSION=latest
ARG CODEX_ACP_VERSION=latest
ARG AGENT_LSP_VERSION=latest
RUN npm install -g \
        "@openai/codex@${CODEX_VERSION}" \
        "@agentclientprotocol/codex-acp@${CODEX_ACP_VERSION}" \
        "@blackwell-systems/agent-lsp@${AGENT_LSP_VERSION}" \
    && npm cache clean --force

# requirements.toml is an enforced Codex policy layer. In particular, an IDE
# cannot switch the ACP session to automatic review or full access. The
# directory must be world-traversable (0755) so the arbitrary non-root runtime
# UID can reach the file; the file itself is world-readable (0644).
RUN install -d -o root -g root -m 0755 /etc/codex
COPY --chmod=0644 container/requirements.toml /etc/codex/requirements.toml
RUN install -d -o root -g root -m 0755 /usr/local/share/codex
COPY --chmod=0644 container/codex-cuda-failure-signatures /usr/local/share/codex/cuda-failure-signatures
RUN install -d -o root -g root -m 0755 /usr/local/share/codex-universal
COPY --chmod=0644 container/codex-workflow/ /usr/local/share/codex-universal/workflow/
RUN find /usr/local/share/codex-universal/workflow -type d -exec chmod 0755 {} + \
    && chmod 0755 /usr/local/share/codex-universal/workflow/skills/clojure-development/scripts/*
COPY --chmod=0755 container/codex-universal-workflow-install /usr/local/bin/codex-universal-workflow-install
COPY --chmod=0755 container/codex-entrypoint /usr/local/bin/codex-entrypoint
COPY --chmod=0755 container/codex-acp-entrypoint /usr/local/bin/codex-acp-entrypoint
COPY --chmod=0755 container/codex-clojure-lsp-mcp /usr/local/bin/codex-clojure-lsp-mcp
COPY --chmod=0755 container/codex-lsp-message-proxy /usr/local/bin/codex-lsp-message-proxy
RUN mv /usr/bin/bwrap /usr/bin/bwrap.real
COPY --chmod=0755 container/codex-bwrap-cuda /usr/bin/bwrap

ENV HOME=/home/codex

RUN install -d -o root -g root -m 0555 \
        /workspace \
        /home/codex \
        /home/codex/.codex \
        /home/codex/.m2 \
        /run/codex-idea-mcp

WORKDIR /workspace
USER 65532:65532

# codex-entrypoint runs NVIDIA's entrypoint first, then establishes the
# arbitrary non-root runtime identity and starts Codex. Arguments passed after
# the image name remain Codex arguments: `IMAGE resume --last`.
ENTRYPOINT ["/usr/local/bin/codex-entrypoint", "codex"]

# Keep Git-derived metadata after every expensive filesystem layer. A new
# source revision should update the image identity without invalidating the
# cached toolchain installed above.
ARG IMAGE_VERSION=dev
ARG VCS_REF=unknown
ARG IMAGE_SOURCE=https://github.com/leafclick/codex-universal
LABEL org.opencontainers.image.title="codex-universal-cuda" \
      org.opencontainers.image.description="Non-root NVIDIA CUDA development environment for OpenAI Codex" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.source="${IMAGE_SOURCE}"
